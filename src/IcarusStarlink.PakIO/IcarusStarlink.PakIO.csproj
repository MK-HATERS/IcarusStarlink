<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IcarusStarlink.Core\IcarusStarlink.Core.csproj" />
    <ProjectReference Include="..\IcarusStarlink.Diffing\IcarusStarlink.Diffing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- Real UE4.27 asset parsing for CueUassetTextureDecoder — confirmed via a real prototype
         against the user's own mod files that a mod's loose bundled .uasset/.uexp/.ubulk textures
         decode correctly with no mappings (.usmap) file and no Oodle native DLL needed. -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202608" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202608" />
    <!-- CUE4Parse-Conversion transitively pulls Microsoft.Bcl.Memory 9.0.0, which NuGet flags
         with a known high-severity advisory (GHSA-73j8-2gch-69rq) — pinned up to a patched
         version directly rather than accepting the transitive one. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <!-- Writes a mod's cooked file after pointing a reference elsewhere (AssetReferenceRewriter):
         it moves every header offset when the name map changes length. Checked to write all 326
         cooked files of a real Library back byte for byte before anything changes. -->
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every row name the game has ever had (tools/GameRowHistory builds it); see GameRowHistory. -->
    <EmbeddedResource Include="Resources\game_row_history.json.gz" LogicalName="game_row_history.json.gz" />
    <!-- New-mod templates (ModTemplateContent.TemplateText), read as Templates.<name>.json. -->
    <EmbeddedResource Include="Exmod\Templates\*.json" LogicalName="Templates.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
