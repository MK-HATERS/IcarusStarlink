<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- See app.manifest's own comment — asInvoker (unchanged) plus longPathAware, for a real
         access-denied self-update failure found live against a "\\?\..." extended-length path;
         this is the process that actually does the file copying during a self-update. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The updater ships as a Native AOT program (App.csproj publishes it that way): show AOT,
         trim and single-file problems on every build instead of only at publish. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>
