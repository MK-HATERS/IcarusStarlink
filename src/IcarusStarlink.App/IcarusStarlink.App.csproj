<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IcarusStarlink.Core\IcarusStarlink.Core.csproj" />
    <ProjectReference Include="..\IcarusStarlink.Diffing\IcarusStarlink.Diffing.csproj" />
    <ProjectReference Include="..\IcarusStarlink.PakIO\IcarusStarlink.PakIO.csproj" />
    <ProjectReference Include="..\IcarusStarlink.Catalog\IcarusStarlink.Catalog.csproj" />
    <ProjectReference Include="..\IcarusStarlink.Storage\IcarusStarlink.Storage.csproj" />
    <!-- Build-order only (no assembly reference) — the target below copies the built updater exe
         into this app's own output so it ships alongside, ready for "Update now" to stage a temp
         copy of it and hand off. -->
    <ProjectReference Include="..\IcarusStarlink.Updater\IcarusStarlink.Updater.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ThirdParty\UeSaveGame\UeSaveGame.csproj" />
  </ItemGroup>

  <!-- The update-outcome note's names, compiled into both exes so the updater that writes the
       note and the app that reads it can't drift apart (the Updater isn't referenced as an assembly). -->
  <ItemGroup>
    <Compile Include="..\IcarusStarlink.Updater\UpdateOutcomeNote.cs" Link="Services\Shell\UpdateOutcomeNote.cs" />
  </ItemGroup>

  <!-- The Updater ProjectReference inherits this project's own RuntimeIdentifier when one is set
       (e.g. `dotnet publish -r win-x64`), which moves ITS OWN build output from
       bin\$(Configuration)\net10.0\ to bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\. Sourcing
       from the non-RID path during a RID-specific build either finds nothing there yet, or (observed
       shipping the real v1.4.0 release) silently picks up stale files an earlier non-RID
       `dotnet build` happened to leave behind — three of the four files below were stale-but-present
       that way, the fourth (the managed .dll itself) wasn't, so the shipped updater couldn't
       actually run despite its own apphost .exe copying over fine. -->
  <PropertyGroup>
    <_UpdaterOutputDir>..\IcarusStarlink.Updater\bin\$(Configuration)\net10.0\</_UpdaterOutputDir>
    <_UpdaterOutputDir Condition="'$(RuntimeIdentifier)' != ''">..\IcarusStarlink.Updater\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\</_UpdaterOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <_UpdaterFiles Include="$(_UpdaterOutputDir)IcarusStarlink.Updater.exe;
                           $(_UpdaterOutputDir)IcarusStarlink.Updater.dll;
                           $(_UpdaterOutputDir)IcarusStarlink.Updater.runtimeconfig.json;
                           $(_UpdaterOutputDir)IcarusStarlink.Updater.deps.json" />
  </ItemGroup>

  <!-- Plain `dotnet build` (the normal F5/dev inner loop) — copies straight into $(OutDir). -->
  <Target Name="CopyUpdaterToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(_UpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- `dotnet publish` — the Updater ships as its OWN standalone exe: "Update now" stages just that
       one file into TEMP, so it must run with nothing beside it (a self-contained apphost there
       dies with "hostpolicy.dll ... not found" before any of its code runs).

       It is compiled with Native AOT: a plain 2 MB native Windows program, no bundled runtime.
       A self-contained single-file .NET bundle (trimmed or not) of this small file-copying,
       process-waiting program matches generic antivirus signatures (BitDefender's
       Gen:Variant.Yogi and the engines that license it); the AOT build scans clean. AOT needs the
       Visual Studio C++ build tools (MSVC linker) on the publishing machine.

       Hooked AfterTargets on the publish pipeline's own list-building target (publish-only; never
       runs on a plain build) — AFTER, not before, because that target is what adds the
       ProjectReference's own outputs, so a hook running before it has nothing to remove yet
       (confirmed live: a BeforeTargets version failed with NETSDK1152, the SDK's apphost copy and
       this one colliding on the same relative path). Publishes the Updater project into this
       project's own obj\ via the MSBuild task, drops whatever Updater files the SDK auto-included
       (matched on RelativePath — the publish destination — not Filename: the SDK's apphost item is
       literally named apphost.exe on disk and only becomes IcarusStarlink.Updater.exe on output;
       and with PublishSingleFile on below, its .dll would otherwise be swallowed into THIS app's
       bundle, also confirmed in a trial publish), then adds the native exe with
       ExcludeFromSingleFile so it stays a separate, runnable file beside the app. -->
  <PropertyGroup>
    <_UpdaterPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\updater-publish\</_UpdaterPublishDir>
  </PropertyGroup>
  <PropertyGroup>
    <!-- AOT has to be known at RESTORE time (the ILCompiler pack is a restore-time dependency,
         like the ILLink pack: a Publish against the Updater's ordinary restore silently skips it).
         So: a dedicated Restore with the exact same property set first, under a fresh restore
         session id so MSBuild doesn't hand back the cached plain evaluation, then the Publish. -->
    <_UpdaterPublishProperties>Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishAot=true;PublishDir=$(_UpdaterPublishDir);_IsPublishing=true</_UpdaterPublishProperties>
  </PropertyGroup>
  <Target Name="PublishNativeUpdater" AfterTargets="ComputeResolvedFilesToPublishList">
    <MSBuild Projects="..\IcarusStarlink.Updater\IcarusStarlink.Updater.csproj" Targets="Restore"
             Properties="$(_UpdaterPublishProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\IcarusStarlink.Updater\IcarusStarlink.Updater.csproj" Targets="Publish"
             Properties="$(_UpdaterPublishProperties)" />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(RelativePath)').StartsWith('IcarusStarlink.Updater'))" />
      <ResolvedFileToPublish Include="$(_UpdaterPublishDir)IcarusStarlink.Updater.exe">
        <RelativePath>IcarusStarlink.Updater.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Ships next to the exe in every build and publish output: the release zip carries it, and
         players run it from the IcarusStarlink folder. -->
    <None Include="Uninstall.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The exe is IcarusStarlink.exe since 3.0 (it was IcarusStarlink.App.exe); namespaces
         and the project name stay. The old-name launcher shipped from 3.0 to 4.1; installs that
         still have one get their shortcuts and nxm:// links moved over (ExeRenameMigration). -->
    <AssemblyName>IcarusStarlink</AssemblyName>
    <RootNamespace>IcarusStarlink.App</RootNamespace>
    <!-- Compared against the latest GitHub release tag by the App Updates check — bump this
         alongside tagging a real GitHub release, they're meant to stay in lockstep. -->
    <Version>4.4.2</Version>
    <!-- Without this, the SDK appends "+<git-commit-sha>" to InformationalVersion (SourceLink's
         deterministic-build behavior) — breaks both the displayed version and Version.TryParse in
         SettingsViewModel's own update-comparison logic, which doesn't understand a "+sha" suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- See app.manifest's own comment — asInvoker (unchanged) plus longPathAware, for a real
         access-denied self-update failure found live against a "\\?\..." extended-length path. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The app's own UI is English-only (no localization/language switcher) — without this the SDK
         ships all 13 of its default satellite-resource cultures anyway, each just a *.resources.dll
         of localized *framework* exception/diagnostic message text for WPF/.NET itself, never seen
         by a user of an English-only app. Confirmed via a real publish: this alone cuts the
         self-contained win-x64 release from 492 files down to 336 with zero functional loss. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Publish-only (a plain `dotnet build` is unaffected): bundles every managed assembly and the
         self-contained runtime into IcarusStarlink.exe: from 336 loose files at the release
         zip's root down to the handful of native libraries WPF,
         SkiaSharp and SQLite genuinely need beside the exe (deliberately NOT
         IncludeNativeLibrariesForSelfExtract: that extracts them to a temp folder on first run, a
         known antivirus false-positive trigger on top of what a single-file bundle already is).
         Trimming is NOT enabled here — WPF doesn't support it. (The Updater is a separate
         Native AOT exe: see PublishNativeUpdater above.) -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- UE4SS ships inside the exe: a dev build zip from GitHub's experimental-latest release,
       unchanged, plus its MIT licence (added if the zip has none). See Services/BundledUe4ss.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\UE4SS\UE4SS_v3.0.1-1181-g83330635.zip" LogicalName="UE4SS.zip" />
    <EmbeddedResource Include="Assets\UE4SS\LICENSE.txt" LogicalName="UE4SS-LICENSE.txt" />
  </ItemGroup>

</Project>
