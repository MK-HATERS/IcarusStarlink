<Window x:Class="IcarusStarlink.App.Views.ModVersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding Title, FallbackValue='Versions'}" Height="460" Width="720" MinHeight="320" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ModName}" Style="{StaticResource PageHeaderStyle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Every copy of this mod Starlink kept, newest first. Starlink keeps one before each update, fix or reinstall, and when you pick Create mod backup. It keeps the newest 5."/>

        <Grid Grid.Row="2">
            <!-- IsReadOnly: the columns are get-only, and a double-click would otherwise try to edit them. -->
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" IsReadOnly="True"
                      SelectionMode="Single" AutomationProperties.Name="Kept versions"
                      Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding WhenText}" Width="150"/>
                    <DataGridTextColumn Header="Why" Binding="{Binding ReasonText}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="90"/>
                    <DataGridTextColumn Header="Nexus file" Binding="{Binding FileText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="No copies kept yet. Right-click the mod and pick Create mod backup to keep one now; updates, fixes and reinstalls keep one too."/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Compare with now" Command="{Binding CompareCommand}" Margin="0,0,8,0" Padding="12,4"
                    ToolTip="Shows which values and files differ between the picked copy and the one in your Library now. Changes nothing."/>
            <Button Content="Put this version back" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4"
                    ToolTip="Replaces the mod in your Library with the picked copy. Asks first, and backs up the copy you have now, so you can switch back from this list."/>
        </StackPanel>
    </Grid>
</Window>
