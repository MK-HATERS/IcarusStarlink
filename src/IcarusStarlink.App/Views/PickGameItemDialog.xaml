<Window x:Class="IcarusStarlink.App.Views.PickGameItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Copy a game row into this mod" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pick any row of the game's data: all its current values are copied into this mod, ready to edit. Nothing changes in game until you change a value (an unchanged copy does nothing in game)."
                   Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged"/>
                <TextBlock x:Name="FilterPlaceholder" Text="e.g. Stone_Pickaxe, or a file like D_ProcessorRecipes…"
                           Style="{StaticResource PlaceholderTextStyle}"/>
            </Grid>
            <!-- Classic IMM's "View Originals with modded items hidden" workflow — after a game
                 patch, what's LEFT visible with this checked is exactly what the mod hasn't
                 accounted for yet. -->
            <CheckBox x:Name="HideCoveredBox" Grid.Column="1" Content="Hide items already in this mod"
                      Margin="10,0,0,0" VerticalAlignment="Center" Checked="HideCoveredBox_Changed" Unchecked="HideCoveredBox_Changed"
                      ToolTip="Shows only items this mod doesn't change yet: the quickest way to spot what's new in a file after a game update"/>
        </Grid>

        <!-- ListBox virtualizes by default — the real game data is ~10k+ rows across ~300 files,
             which renders fine virtualized but would hang the dialog if realized eagerly. -->
        <ListBox x:Name="ItemsListBox" Grid.Row="2" DisplayMemberPath="Display" MouseDoubleClick="ItemsListBox_MouseDoubleClick"/>

        <TextBlock x:Name="CountText" Grid.Row="3" Margin="0,6,0,0" FontSize="12"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Copy row" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                    ToolTip="Copies the selected row into this mod (double-click a row does the same)"/>
        </StackPanel>
    </Grid>
</Window>
