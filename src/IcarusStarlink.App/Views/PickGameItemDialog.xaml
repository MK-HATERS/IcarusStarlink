<Window x:Class="IcarusStarlink.App.Views.PickGameItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Add item from game data" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pick any real in-game item — its complete current values are copied into this mod as a starting point, ready to edit. Nothing changes in-game until you actually edit a field (a copy identical to the game's own data merges as a no-op)."
                   Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged"/>
            <TextBlock x:Name="FilterPlaceholder" Text="e.g. Stone_Pickaxe, or a file like D_ProcessorRecipes…"
                       Style="{StaticResource PlaceholderTextStyle}"/>
        </Grid>

        <!-- ListBox virtualizes by default — the real game data is ~10k+ rows across ~300 files,
             which renders fine virtualized but would hang the dialog if realized eagerly. -->
        <ListBox x:Name="ItemsListBox" Grid.Row="2" DisplayMemberPath="Display" MouseDoubleClick="ItemsListBox_MouseDoubleClick"/>

        <TextBlock x:Name="CountText" Grid.Row="3" Margin="0,6,0,0" FontSize="12"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Add item" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
