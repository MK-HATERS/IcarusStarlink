<UserControl x:Class="IcarusStarlink.App.Views.ImmDatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
             xmlns:utilities="clr-namespace:IcarusStarlink.App.Utilities"
             mc:Ignorable="d">
    <!-- The IMM Database browser (moved from Library to the Database page). DataContext is
         LibraryViewModel: every binding here targets its Downloads (DownloadsViewModel). -->
    <UserControl.Resources>
        <!-- DataGridColumn.Visibility can't reach a nested VM via ElementName (see BindingProxy). -->
        <utilities:BindingProxy x:Key="ViewModelProxy" Data="{Binding Downloads}"/>
    </UserControl.Resources>

                <!-- Same title and edges as the Nexus tab beside it (that view sits at -12 inside the tab). -->
                <Grid Margin="8,32,8,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="IMM Database" Style="{StaticResource PageHeaderStyle}"/>

                    <DockPanel Grid.Row="1" Margin="0,12,0,10" LastChildFill="True">
                        <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button x:Name="ColumnsButton" Command="{Binding Downloads.ToggleColumnsMenuCommand}" AutomationProperties.Name="Columns"
                                    ToolTip="Choose which columns the list shows">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGearTeeth}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Columns" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding Downloads.IsColumnsMenuOpen, Mode=TwoWay}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="170">
                                    <StackPanel>
                                        <TextBlock Text="Columns" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Author" IsChecked="{Binding Downloads.ShowAuthorColumn}" Margin="0,3"/>
                                        <CheckBox Content="Version" IsChecked="{Binding Downloads.ShowVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Installed" IsChecked="{Binding Downloads.ShowInstalledVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Works with" IsChecked="{Binding Downloads.ShowCompatibilityColumn}" Margin="0,3"/>
                                        <CheckBox Content="Category" IsChecked="{Binding Downloads.ShowCategoryColumn}" Margin="0,3"/>
                                        <CheckBox Content="Status" IsChecked="{Binding Downloads.ShowStatusColumn}" Margin="0,3"/>
                                        <CheckBox Content="Last Updated" IsChecked="{Binding Downloads.ShowLastUpdatedColumn}" Margin="0,3"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding Downloads.ClearCatalogFiltersCommand}" Margin="8,0,0,0"
                                ToolTip="Empties the search box and turns every filter off"/>
                        <Button DockPanel.Dock="Right" Command="{Binding Downloads.DownloadAndExtractSelectedCommand}" Margin="8,0,0,0"
                                ToolTip="Downloads every selected mod into your Library, one after another. Ctrl- or Shift-click rows to select more than one."
                                Visibility="{Binding Downloads.HasCatalogSelectionForBatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="Download and extract selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Downloads.SelectedCatalogEntryCount, StringFormat='Download selected ({0})'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding Downloads.RefreshCatalogCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Refresh"
                                ToolTip="Fetch the latest mod list from the IMM Database">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource AccentForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,0,8,0">
                            <TextBox Text="{Binding Downloads.CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by name, author, or description"/>
                            <TextBlock Text="Search mods by name, author, or description…" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding Downloads.CatalogSearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </DockPanel>

                    <!-- Author/category/status/week filters, folded into one section (collapsed by
                         default) whose header names whatever filters are on, so a narrowed list never
                         looks like a missing mod. WrapPanel inside: at a narrow width the controls
                         drop onto a second line instead of clipping off the right edge. -->
                    <Expander Grid.Row="2" Margin="0,0,0,8" IsExpanded="False" AutomationProperties.Name="Filters">
                        <Expander.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Filters" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Downloads.CatalogFilterSummary}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                            </DockPanel>
                        </Expander.Header>
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="Author:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <ComboBox ItemsSource="{Binding Downloads.AvailableAuthors}" SelectedItem="{Binding Downloads.SelectedAuthor}" Width="160"
                                              AutomationProperties.Name="Author filter"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <ComboBox ItemsSource="{Binding Downloads.AvailableCategories}" SelectedItem="{Binding Downloads.SelectedCategory}" Width="160"
                                              AutomationProperties.Name="Category filter"/>
                                </StackPanel>
                                <CheckBox Content="Updates only" IsChecked="{Binding Downloads.ShowUpdatesOnly}" VerticalAlignment="Center" Margin="0,0,12,4"
                                          ToolTip="Only mods where the database has a newer version than your Library copy"/>
                                <CheckBox Content="Downloaded only" IsChecked="{Binding Downloads.ExtractedOnly}" VerticalAlignment="Center" Margin="0,0,12,4"
                                          ToolTip="Only mods already in your Library"/>
                                <CheckBox Content="Not downloaded only" IsChecked="{Binding Downloads.NotDownloadedOnly}" VerticalAlignment="Center" Margin="0,0,0,4"
                                          ToolTip="Only mods not in your Library yet"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Game week:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBox Text="{Binding Downloads.GameWeek, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0"
                                         AutomationProperties.Name="Game week"
                                         ToolTip="The Icarus game week to compare mods against. Higher = only mods made for newer weeks count as current; lower = older mods count too. 0 = not set."/>
                                <CheckBox Content="Hide older weeks" IsChecked="{Binding Downloads.HideOlderWeeks}" VerticalAlignment="Center"
                                          ToolTip="Hides mods made for a week before the game week on the left (mods with no week stay). Does nothing until a game week is set."/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12">
                            <Run Text="{Binding Downloads.CatalogShownCount, Mode=OneWay}"/><Run Text=" shown of "/><Run Text="{Binding Downloads.CatalogTotalCount, Mode=OneWay}"/><Run Text=" in the database"/>
                        </TextBlock>
                        <TextBlock Text=" — loading…" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                   Visibility="{Binding Downloads.IsLoadingCatalog, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <!-- Classic IMM's Show New: mods added or updated since your last visit. -->
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                    Visibility="{Binding Downloads.HasCatalogNew, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,10,0"
                                       Text="{Binding Downloads.CatalogNewCount, StringFormat='{}{0} new since your last visit'}"/>
                            <CheckBox Content="New only" IsChecked="{Binding Downloads.ShowNewOnly}" VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="Only mods added or updated since your last visit"/>
                            <Button Content="Mark all seen" Command="{Binding Downloads.MarkCatalogSeenCommand}" Padding="8,2"
                                    ToolTip="Clears the New tags now. They also clear by themselves when you close Starlink after looking here."/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <!-- Drag the bar between the list and the details to give either more room. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="600"/>
                        </Grid.ColumnDefinitions>

                        <!-- IsReadOnly is load-bearing, not cosmetic: without it, double-clicking any
                             cell makes WPF's DataGrid try to enter edit mode on a TwoWay binding to a
                             get-only CatalogEntryViewModel property, which throws an unhandled
                             InvalidOperationException and crashes the whole app — confirmed live. -->
                        <DataGrid Grid.Column="0" x:Name="CatalogGrid" ItemsSource="{Binding Downloads.CatalogEntries}" SelectedItem="{Binding Downloads.SelectedCatalogEntry}"
                                  IsReadOnly="True" SelectionChanged="CatalogGrid_SelectionChanged" MouseDoubleClick="CatalogGrid_MouseDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Fixed pixel widths on every column, not Star ("*"): a Star column
                                     always redistributes space among its sibling Star columns on any
                                     resize, so dragging one wider steals width from the others instead
                                     of growing the grid's total content width — which is also why no
                                     horizontal scrollbar could ever appear. Fixed widths let content
                                     genuinely overflow the viewport, so resizing one column no longer
                                     crunches the rest; the DataGrid's default ControlTemplate already
                                     shows a horizontal scrollbar (HorizontalScrollBarVisibility="Auto"
                                     is its own built-in default) once that happens. -->
                                <!-- New / Updated since your last visit (sorts with the tagged ones together). -->
                                <DataGridTemplateColumn Header="New" Width="64" SortMemberPath="NewTag"
                                                         Visibility="{Binding Data.HasCatalogNew, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    Visibility="{Binding HasNewTag, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding NewTag}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mod Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"
                                                     Visibility="{Binding Data.ShowAuthorColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"
                                                     Visibility="{Binding Data.ShowVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="70"
                                                     Visibility="{Binding Data.ShowInstalledVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Works with" Binding="{Binding CompatibilityDisplay}" Width="70"
                                                     Visibility="{Binding Data.ShowCompatibilityColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="150"
                                                     Visibility="{Binding Data.ShowCategoryColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTemplateColumn Header="Status" Width="90"
                                                         Visibility="{Binding Data.ShowStatusColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Phase 10: a small semantic badge instead of plain text — same
                                                 pill treatment Merge & Install's conflict badge uses. -->
                                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdatedDisplay}" Width="90"
                                                     Visibility="{Binding Data.ShowLastUpdatedColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Says why the list is empty (loading, nothing loaded, nothing matching) where the rows would be. -->
                        <TextBlock Grid.Column="0" Text="{Binding Downloads.CatalogEmptyStateText}" Style="{StaticResource EmptyStateTextStyle}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Downloads.CatalogEmptyStateText, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Drag to resize the details" AutomationProperties.Name="Resize details"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Select a mod to see its details and download it."
                                       Style="{StaticResource PageBodyTextStyle}" Margin="0,8,0,0"
                                       Visibility="{Binding Downloads.SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <StackPanel Grid.Row="0" Visibility="{Binding Downloads.SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid Height="120" Margin="0,0,0,8">
                                    <Border Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform"/>
                                    </Border>
                                    <!-- Sits on top of the placeholder above and only becomes visible
                                         once a real ImageUrl exists — this panel never actually had a
                                         real Image element before, just the placeholder unconditionally,
                                         even though the same real per-mod image already renders
                                         correctly in the "More details…" pop-out below. -->
                                    <Image Source="{Binding Downloads.SelectedCatalogEntry.Entry.ImageUrl}" Stretch="UniformToFill"
                                           Visibility="{Binding Downloads.SelectedCatalogEntry.Entry.ImageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Downloads.SelectedCatalogEntry.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding Downloads.SelectedCatalogEntry.Author, Mode=OneWay}"/>
                                    <Run Text=" · v"/>
                                    <Run Text="{Binding Downloads.SelectedCatalogEntry.Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Downloads.SelectedCatalogEntry.Entry.Description}" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Command="{Binding Downloads.DownloadAndExtractCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                                        IsEnabled="{Binding Downloads.SelectedCatalogEntry.HasDownloadableFile}"
                                        ToolTip="Downloads this mod and adds it to your Library. Greyed out: the database has no download link for it — use its page instead." ToolTipService.ShowOnDisabled="True"
                                        AutomationProperties.Name="Download and extract">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Download &amp; extract" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding Downloads.OpenCatalogReadmeCommand}" AutomationProperties.Name="Open readme" Margin="0,0,0,8"
                                        IsEnabled="{Binding Downloads.SelectedCatalogEntry.HasReadme}" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Opens the mod's readme in your browser. Greyed out: the database has no readme link for it.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Open readme" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ShowCatalogEntryDetails_Click" AutomationProperties.Name="More details"
                                        ToolTip="Opens a bigger window with the selected mod's full description, picture and details">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="More details…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{Binding Downloads.CatalogStatusMessage}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                </Grid>
</UserControl>
