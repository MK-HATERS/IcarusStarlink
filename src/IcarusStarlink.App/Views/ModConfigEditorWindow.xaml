<Window x:Class="IcarusStarlink.App.Views.ModConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IcarusStarlink.App.Views"
        Title="{Binding Title}" Height="760" Width="900" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <!-- A UE4SS mod's own config file as fields (with the author's comments), or as text.
         Same field layout as Settings > UE4SS config. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Change this mod's settings. Saving only changes what you edit (every comment stays) and backs the old file up first. The mod reads its config when the game or server starts, unless it has its own reload key."
                       Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <!-- After an update: the settings it added (marked "new in this version" below) and the ones the mod no longer has. -->
            <Border Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,10" Padding="10,8" CornerRadius="4"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Background="{DynamicResource CardBackgroundBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Done reviewing" Command="{Binding DoneReviewingCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                            ToolTip="Takes the marks off, here and in the Library"/>
                    <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"/>
                </DockPanel>
            </Border>
            <WrapPanel Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6" Visibility="{Binding HasSeveralFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="File" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="RelativePath" MinWidth="200"
                              AutomationProperties.Name="Which config file"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6" Visibility="{Binding HasSeveralLocations, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Edit the copy in" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" DisplayMemberPath="Name" MinWidth="180"
                              AutomationProperties.Name="Which copy of the mod"/>
                </StackPanel>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,16,6"
                         Style="{StaticResource SearchBoxStyle}" Tag="Find a setting…"
                         Visibility="{Binding ShowFields, Converter={StaticResource BoolToVisibilityConverter}}"
                         ToolTip="Show only settings whose name, heading or description contains this" AutomationProperties.Name="Filter settings"/>
                <CheckBox Content="Edit as text" IsChecked="{Binding IsTextMode}" VerticalAlignment="Center" Margin="0,0,0,6"
                          IsEnabled="{Binding CanUseFields}"
                          ToolTip="The whole file, for lists and anything the fields don't show. Switching back reads the fields from your text."/>
            </WrapPanel>
            <TextBlock Text="{Binding CurrentPath}" FontSize="11" Foreground="{DynamicResource FaintForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                       ToolTip="{Binding CurrentPath}"/>
            <!-- The mod ships its defaults in config.default.lua: not offered as a file, read for "Default:" and Reset to default. -->
            <TextBlock Text="{Binding DefaultsNote}" FontSize="11" Foreground="{DynamicResource FaintForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding DefaultsNote, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasOtherLocations, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,8">
                    <TextBlock Text="Also save these changes to" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ItemsControl ItemsSource="{Binding AlsoSaveTo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Location.Name}" IsChecked="{Binding IsChecked}" Margin="0,0,14,0" VerticalAlignment="Center"
                                          ToolTip="Only the settings you changed are written there; its other settings stay as they are"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Writes your changes to this file (backs the old file up to Backups\UE4SS-Mod-Configs first)"/>
                        <Button Content="Discard changes" Command="{Binding DiscardChangesCommand}" Margin="8,0,0,0"
                                ToolTip="Puts this file back the way it is on disk"/>
                        <Button Content="Reset all to default" Command="{Binding ResetAllToDefaultCommand}" Margin="8,0,0,0"
                                Visibility="{Binding CanResetAllToDefault, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Puts every setting shown back to the mod's default. Nothing is written until you Save."/>
                        <Button Content="Close" Click="Close_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- Unsaved edits, here and in files picked before (they're kept until saved or discarded). -->
                    <TextBlock Text="{Binding UnsavedText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding UnsavedText, Converter={StaticResource NullToVisibilityConverter}}"/>
                </DockPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <Grid>
            <TextBox Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibilityConverter}}"
                     AutomationProperties.Name="Config file text"/>

            <TextBlock Text="This file has no settings Starlink can show as fields. Tick Edit as text to change it."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Visibility="{Binding ShowNoFieldsNote, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowFields, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                <TextBlock Text="No setting matches the search." Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"
                           Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Sections}" AlternationCount="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- One folding group per ini [Section] or Lua comment heading ("==== GUESTS ===="), open by default. -->
                            <Expander IsExpanded="True" Margin="0,0,8,10" AutomationProperties.Name="{Binding Name}"
                                      views:GroupColor.Index="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource GroupStripeStyle}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource GroupTitleStyle}"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="14"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <WrapPanel>
                                                            <!-- The key in plain words, the real key small beside it (it's what the file and the mod's page call it). -->
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" ToolTip="{Binding Key}"/>
                                                            <TextBlock Text="{Binding Key}" FontSize="11" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FaintForegroundBrush}" ToolTip="The setting's name in the file"
                                                                       Visibility="{Binding ShowKeyName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="  changed" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"
                                                                       ToolTip="Edited here and not saved yet"
                                                                       Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="  not the default" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" VerticalAlignment="Center"
                                                                       ToolTip="Differs from the value the mod ships with"
                                                                       Visibility="{Binding CanResetToDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="  server decides" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource FaintForegroundBrush}"
                                                                       ToolTip="In multiplayer the host's or the server's copy of this setting is the one used"
                                                                       Visibility="{Binding ServerDecides, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                                                                    ToolTip="Added by the mod's last update, at its default"
                                                                    Visibility="{Binding IsNewInVersion, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="new in this version" FontSize="10.5" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="  needs a restart" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource FaintForegroundBrush}"
                                                                       ToolTip="The mod reads this once, when the game or server starts"
                                                                       Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DefaultText}" FontSize="11" Foreground="{DynamicResource FaintForegroundBrush}"/>
                                                            <Button Content="Reset to default" Command="{Binding ResetToDefaultCommand}" Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" FontSize="11"
                                                                    Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                                                    Visibility="{Binding CanResetToDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Grid Grid.Column="1" VerticalAlignment="Top">
                                                        <CheckBox IsChecked="{Binding IsOn}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Left"
                                                                  AutomationProperties.Name="{Binding Key}"
                                                                  Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}"
                                                                  AutomationProperties.Name="{Binding Key}"
                                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="{Binding Key}"/>
                                                            <TextBlock Text="{Binding Hint}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}"
                                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <!-- A key: its name, and Ctrl / Shift / Alt when the mod writes it as { key = "F4", ctrl = true }. -->
                                                        <StackPanel Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                                         AutomationProperties.Name="{Binding Key}"
                                                                         ToolTip="The key's Unreal name: F1-F12, A-Z, One, NumPadOne, Equals, Hyphen…"/>
                                                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                            Visibility="{Binding KeyAllowsModifiers, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <CheckBox Content="Ctrl" IsChecked="{Binding KeyCtrl}" Margin="0,0,8,0" ToolTip="Ctrl must be held with the key"/>
                                                                    <CheckBox Content="Shift" IsChecked="{Binding KeyShift}" Margin="0,0,8,0" ToolTip="Shift must be held with the key"/>
                                                                    <CheckBox Content="Alt" IsChecked="{Binding KeyAlt}" ToolTip="Alt must be held with the key"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ValueProblem}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                                                       Visibility="{Binding HasValueProblem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <!-- A number: a slider when the mod gives one, otherwise a box; the range and any problem under it. -->
                                                        <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" SmallChange="{Binding SliderStep}" LargeChange="{Binding SliderStep}"
                                                                        TickFrequency="{Binding SliderStep}" IsSnapToTickEnabled="True" Value="{Binding NumberValue}"
                                                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                                                        AutomationProperties.Name="{Binding Key}"
                                                                        Visibility="{Binding HasSlider, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBox Grid.Column="1" Width="80" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                         AutomationProperties.Name="{Binding Key}"
                                                                         Visibility="{Binding HasSlider, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBox Grid.ColumnSpan="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                         AutomationProperties.Name="{Binding Key}"
                                                                         Visibility="{Binding IsPlainNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding RangeText}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                                                                       Visibility="{Binding HasRangeText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding ValueProblem}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource DangerBrush}"
                                                                       Visibility="{Binding HasValueProblem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
