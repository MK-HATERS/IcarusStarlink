<Window x:Class="IcarusStarlink.App.Views.ExmodPaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding PaneTitle, RelativeSource={RelativeSource Self}}" Height="600" Width="640" MinHeight="300" MinWidth="420"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!--
    A popped-out editor pane — the Fields view,
    detached into its own window so it can sit alongside the main editor window (or another popped-
    out pane) instead of only ever showing one view at a time. DataContext is the SAME
    ExmodEditorViewModel the main editor window uses (set by ExmodEditorViewModel.PopOutCurrentView),
    not a copy — every view already edits the same live in-memory package, so a field changed here
    shows up immediately if the main window's own Item fields pane is reselected, and Save from
    either window writes everything. FixedViewMode never changes after construction (this window
    always shows the one pane it was opened for), so unlike the main window's own view-mode buttons,
    there's no switcher here — just that one pane's content plus its own Save button.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ExmodEditorResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SelectedItem.Display}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding FixedViewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ItemFields}">
            <ScrollViewer x:Name="ItemFieldsScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExmodFieldsBarTemplate}"
                                    Visibility="{Binding FieldsSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource EditorFieldTemplate}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource ExmodFieldGroupItemStyle}"/>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                    <TextBlock Text="{Binding FieldsEmptyText}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Visibility="{Binding FieldsEmptyText, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExmodAddFieldTemplate}"
                                    Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
            <Button Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="Writes every change so far to this mod's .EXMOD file — from any view or window, they all edit the same mod"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>
    </Grid>
</Window>
