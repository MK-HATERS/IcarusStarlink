<Window x:Class="IcarusStarlink.App.Views.ExmodEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="680" Width="1040" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateItemCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="F3" Command="{Binding SelectNextItemCommand}"/>
        <!-- Ctrl+F is handled in code-behind (focuses the filter box) — a pure-UI focus concern the ViewModel can't reach directly. -->
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: items, grouped implicitly by file via sort order + the "File — Item" display text.
             Extended selection mode + the code-behind SelectionChanged handler feed multi-select
             into the ViewModel for mass edit (ListBox.SelectedItems isn't natively bindable). -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Items" Style="{StaticResource FieldLabelStyle}"/>

            <TextBox x:Name="FilterBox" Grid.Row="1" Margin="0,4,0,0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by file or item name (Ctrl+F)"/>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                <ListBox x:Name="ItemsListBox" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Extended" SelectionChanged="ItemsListBox_SelectionChanged"
                         DisplayMemberPath="Display" Background="Transparent" BorderThickness="0"
                         ToolTip="Ctrl/Shift-click to select several items for mass edit"/>
            </Border>

            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                <Button Content="Duplicate (Ctrl+D)" Command="{Binding DuplicateItemCommand}" Margin="0,0,8,4"
                        ToolTip="Clone the selected item's fields under a new name"/>
                <Button Content="Open original file" Command="{Binding OpenOriginalFileCommand}" Margin="0,0,8,4"
                        ToolTip="Open the real, unmodified base game data file for the selected item"/>
                <Button Content="Open mods folder" Command="{Binding OpenModsFolderCommand}" Margin="0,0,8,4"
                        ToolTip="Reveal this mod's own folder in Explorer"/>
                <Button Content="Insert file at location…" Command="{Binding InsertFileAtLocationCommand}" Margin="0,0,8,4"
                        ToolTip="Add one of the game's own real data files to this mod, with no items yet"/>
                <Button Content="Merge existing mod into this one…" Command="{Binding MergeExistingModCommand}" Margin="0,0,8,4"
                        ToolTip="Copy another Library mod's own items into this one — an item already here is left alone"/>
                <Button Content="Search game data…" Command="{Binding SearchGameDataCommand}" Margin="0,0,8,4"
                        ToolTip="Find any item by name, and everywhere its name is referenced inside other items' JSON — e.g. every recipe that consumes it"/>
            </WrapPanel>

            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock Text="Add item" Style="{StaticResource FieldLabelStyle}"/>
                <Button Content="Add item from game data…" Command="{Binding AddItemFromGameCommand}" Margin="0,4,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Pick any real in-game item and copy its complete current values into this mod as a starting point — then edit just the fields you want changed"/>
                <Grid Margin="0,4,0,0">
                    <TextBox Text="{Binding NewItemCurrentFile, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Real game data file path, e.g. Traits/D_Fuel.json"/>
                    <TextBlock Text="e.g. Traits/D_Fuel.json" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding NewItemCurrentFile, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Item/row name in that file, e.g. Item_Wood"/>
                    <TextBlock Text="e.g. Item_Wood" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding NewItemName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Button Content="Add item" Command="{Binding AddItemCommand}" Margin="0,4,0,0" HorizontalAlignment="Left"
                        ToolTip="Adds a new, empty item to this file (or creates the file if it's not already part of this mod)"/>
            </StackPanel>
        </Grid>

        <!-- Right: three views over the same selected item/package — Item fields (structured,
             amber-highlighted), File JSON (one file's raw JSON), Full EXMOD JSON (the whole
             package's raw JSON) — sharing the left-hand selection per the spec's "Item fields,
             File JSON, or Full EXMOD JSON views" + "sync scroll" bullets. -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="Item fields" Style="{StaticResource ThemeButtonStyle}" Margin="0"
                        Command="{Binding SetViewModeCommand}" CommandParameter="ItemFields"
                        ToolTip="Structured, one row per field — the amber-highlighted view">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.ItemFields}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="File JSON" Style="{StaticResource ThemeButtonStyle}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="FileJson"
                        ToolTip="The selected item's own file, as raw JSON you can edit directly">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.FileJson}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="Full EXMOD JSON" Style="{StaticResource ThemeButtonStyle}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="FullExmodJson"
                        ToolTip="The whole mod's .EXMOD, as raw JSON you can edit directly">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.FullExmodJson}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="0,8,0,0" Padding="8"
                    Visibility="{Binding IsMassEditActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource AccentForegroundBrush}" VerticalAlignment="Center" FontWeight="SemiBold">
                        <Run Text="{Binding SelectedItemCount, Mode=OneWay}"/><Run Text=" items selected — mass edit:"/>
                    </TextBlock>
                    <TextBox Text="{Binding MassEditFieldName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,0,0" ToolTip="Field name"/>
                    <TextBox Text="{Binding MassEditFieldValue, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="8,0,0,0"
                             ToolTip="JSON value, e.g. 1313 or &quot;text&quot; — set (added if missing) on every selected item"/>
                    <Button Content="Apply to selection" Command="{Binding ApplyMassEditCommand}" Margin="8,0,0,0"
                            ToolTip="Sets this field on every selected item (added if an item doesn't already have it)"/>
                    <TextBlock Text="{Binding MassEditStatusMessage}" Foreground="{DynamicResource AccentForegroundBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ItemFields}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Fields}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FieldName}" VerticalAlignment="Top" Margin="0,4,8,0" TextWrapping="Wrap"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                                     ToolTip="This mod's current value for this field, as JSON. An orange border means it differs from the real game's own default (see 'base' below).">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FFB84D"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="{Binding BaseValueText, StringFormat='base (vanilla game): {0}'}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding OriginalValueText, StringFormat='was (before this edit): {0}'}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsChangedFromOriginal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding ParseError}" FontSize="11" Foreground="#E05555" Margin="0,2,0,0"
                                                       Visibility="{Binding ParseError, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="✕" Padding="6,2" VerticalAlignment="Top" Margin="8,0,0,0"
                                                ToolTip="Remove this field"
                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FileJson}">
                <TextBox Text="{Binding FileJsonText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Padding="8"
                         BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="This file's items and fields as raw JSON. Edit freely, then click Apply file JSON below to update the mod — nothing here is saved until you do."/>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FullExmodJson}">
                <TextBox Text="{Binding FullExmodJsonText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Padding="8"
                         BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="The whole mod's .EXMOD as raw JSON. Edit freely, then click Apply full EXMOD JSON below to update the mod — nothing here is saved until you do."/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ItemFields}">
                <Grid Width="160">
                    <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Field name"/>
                    <TextBlock Text="e.g. MaxStack" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding NewFieldName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Grid Width="200" Margin="8,0,0,0">
                    <TextBox Text="{Binding NewFieldValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="JSON value, e.g. 1313 or &quot;text&quot;"/>
                    <TextBlock Text="e.g. 1313 or &quot;text&quot;" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding NewFieldValue, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Button Content="Add field" Command="{Binding AddFieldCommand}" Margin="8,0,0,0"
                        ToolTip="Adds this field to the selected item"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FileJson}">
                <Button Content="Apply file JSON" Command="{Binding ApplyFileJsonCommand}"
                        ToolTip="Re-parse this box and replace the selected item's file in the mod"/>
                <TextBlock Text="{Binding RawJsonStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FullExmodJson}">
                <Button Content="Apply full EXMOD JSON" Command="{Binding ApplyFullExmodJsonCommand}"
                        ToolTip="Re-parse this box and replace the whole mod's contents"/>
                <TextBlock Text="{Binding RawJsonStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <Button Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Writes every change so far to this mod's .EXMOD file — from any of the three views above, they all edit the same mod"/>
                <Button Content="Undo (Ctrl+Z)" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="8,0,0,0"
                        ToolTip="Reverts the last Add/Remove field, Add item, Duplicate, mass edit, or raw-JSON Apply — not per-keystroke typing"
                        ToolTipService.ShowOnDisabled="True"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
