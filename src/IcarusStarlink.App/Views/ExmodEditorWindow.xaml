<Window x:Class="IcarusStarlink.App.Views.ExmodEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
        xmlns:views="clr-namespace:IcarusStarlink.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="760" Width="1200" MinHeight="460" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ExmodEditorResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateItemCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="F3" Command="{Binding SelectNextItemCommand}"/>
        <!-- Ctrl+F is handled in code-behind (focuses the filter box) — a pure-UI focus concern the ViewModel can't reach directly. -->
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- Drag to give the item list or the views more room. -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize"
                      AutomationProperties.Name="Resize the item list"/>

        <!-- Left: items, grouped implicitly by file via sort order + the "File — Item" display text.
             Extended selection mode + the code-behind SelectionChanged handler feed multi-select
             into the ViewModel for mass edit (ListBox.SelectedItems isn't natively bindable). -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}">
                <Run Text="THIS MOD'S ITEMS ("/><Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=")"/>
            </TextBlock>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by in-game name, row or file (Ctrl+F)"/>
                <TextBlock Text="Search this mod's items (Ctrl+F)" Style="{StaticResource PlaceholderTextStyle}"
                           Visibility="{Binding FilterText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                <ListBox x:Name="ItemsListBox" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Extended" SelectionChanged="ItemsListBox_SelectionChanged"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ToolTip="Ctrl/Shift-click to select several items for mass edit">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedItemsCommand}"/>
                    </ListBox.InputBindings>
                    <ListBox.GroupStyle>
                        <GroupStyle AlternationCount="6">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,8,4,2"
                                               views:GroupColor.Index="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=GroupItem}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource GroupStripeStyle}" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Style="{StaticResource GroupTitleStyle}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}"
                                        Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Values that differ from the game's">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel Margin="0,1,6,1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Text="{Binding ItemName}" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource FaintForegroundBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ItemName}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding ItemsEmptyText}" Style="{StaticResource EmptyStateTextStyle}" IsHitTestVisible="False"
                       Visibility="{Binding ItemsEmptyText, Converter={StaticResource NullToVisibilityConverter}}"/>

            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                <Button Content="New item from a game item…" Command="{Binding NewItemFromGameCommand}" Margin="0,0,8,4"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Make a brand-new item that starts as a copy of a game item: its own name, icon and stats, and a recipe or workshop purchase so players can get it"/>
                <Button Content="Change a game item (Editor page) →" Command="{Binding GoToGameEditorCommand}" Margin="0,0,8,4"
                        ToolTip="The Editor page is the easy way to change the game's own items (weight, armour, buffs, recipes) and save them into this mod or a new one"/>
                <Button Content="Search game data…" Command="{Binding SearchGameDataCommand}" Margin="0,0,8,4"
                        ToolTip="Find any item by name, and every place other items use it, e.g. every recipe that needs it"/>
                <Button Content="Check references" Command="{Binding CheckReferencesCommand}" Margin="0,0,8,4"
                        ToolTip="Finds links to rows that are in neither the game nor this mod (a typo, or a row a game update renamed), and items nothing uses. Also runs when you save."/>
                <Button x:Name="MoreButton" Content="More ▾" Click="MoreButton_Click" Margin="0,0,8,4" ToolTip="Copy a game row, duplicate, open the original file, insert a file, merge another mod, open the folder">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy a game row into this mod…" Command="{Binding AddItemFromGameCommand}" ToolTip="The raw way to change a game item: copy any row of the game's data, with all its values, then edit the fields you want"/>
                            <MenuItem Header="Duplicate (Ctrl+D)" Command="{Binding DuplicateItemCommand}" ToolTip="Copies the selected item under a new name"/>
                            <MenuItem Header="Take out of this mod (Delete)" Command="{Binding RemoveSelectedItemsCommand}" ToolTip="Removes the selected row(s) from this mod: a game row goes back to the game's values, a row this mod added is gone. Undo puts them back."/>
                            <MenuItem Header="Open original file" Command="{Binding OpenOriginalFileCommand}" ToolTip="Opens the game's own, unchanged data file for the selected item"/>
                            <MenuItem Header="Insert file at location…" Command="{Binding InsertFileAtLocationCommand}" ToolTip="Add one of the game's own real data files to this mod, with no rows yet"/>
                            <MenuItem Header="Merge existing mod into this one…" Command="{Binding MergeExistingModCommand}" ToolTip="Copy another Library mod's own items into this one — an item already here is left alone"/>
                            <MenuItem Header="Open mods folder" Command="{Binding OpenModsFolderCommand}" ToolTip="Opens this mod's folder in Explorer"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>

            <!-- Rare and raw: typing a file and row name by hand. Folded away; the buttons above are
                 the usual ways in. -->
            <Expander Grid.Row="4" Margin="0,4,0,0" IsExpanded="False" AutomationProperties.Name="Add an empty row">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Add an empty row" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                        <TextBlock DockPanel.Dock="Left" Text="advanced: type a file and row name" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                    </DockPanel>
                </Expander.Header>
                <StackPanel Margin="0,4,0,0">
                    <Grid>
                        <TextBox Text="{Binding NewItemCurrentFile, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Which game data file, e.g. Traits/D_Fuel.json"/>
                        <TextBlock Text="e.g. Traits/D_Fuel.json" Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="{Binding NewItemCurrentFile, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The row's name in that file, e.g. Item_Wood"/>
                        <TextBlock Text="e.g. Item_Wood" Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="{Binding NewItemName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                    <Button Content="Add row" Command="{Binding AddItemCommand}" Margin="0,4,0,0" HorizontalAlignment="Left"
                            ToolTip="Adds a new, empty row to this file (or adds the file if it's not already part of this mod)"/>
                </StackPanel>
            </Expander>
        </Grid>

        <!-- Right: views over the same selected item/package — Fields (structured, orange-marked),
             Scale rules and Not in this mod yet — sharing the left-hand selection. -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="Fields" Style="{StaticResource ThemeButtonStyle}" Margin="0"
                        Command="{Binding SetViewModeCommand}" CommandParameter="ItemFields"
                        ToolTip="The selected row in plain words: one box per value, one row per stat, the game's value beside each">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.ItemFields}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="Scale rules" Style="{StaticResource ThemeButtonStyle}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="ScaleRules"
                        ToolTip="Change one value across a whole game table, e.g. every item's weight × 0.5. After a game update it can redo the change on the new game data.">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.ScaleRules}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="Not in this mod yet" Style="{StaticResource ThemeButtonStyle}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="NotInMod"
                        ToolTip="Game rows of the tables this mod changes that it doesn't have yet (new items after a game update, say). Tick some and add them in one go.">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.NotInMod}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="⧉ Pop out" Command="{Binding PopOutCurrentViewCommand}" Margin="16,0,0,0"
                        ToolTip="Open whichever view is showing now in its own window, so you can keep it open alongside another view — both edit the same mod"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Visibility="{Binding ShowReferenceProblems, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" Command="{Binding HideReferenceProblemsCommand}" ToolTip="Hide"/>
                        <TextBlock Text="{Binding ReferenceSummary}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="140" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReferenceProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="0,0,0,3" Padding="6,2"
                                            Command="{Binding DataContext.GoToReferenceProblemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="Go to this row">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="0,8,0,0" Padding="8"
                    Visibility="{Binding IsMassEditActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Wraps, so a narrow window doesn't cut off Apply. -->
                <WrapPanel>
                    <TextBlock Foreground="{DynamicResource AccentForegroundBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Run Text="{Binding SelectedItemCount, Mode=OneWay}"/><Run Text=" items selected — mass edit:"/>
                    </TextBlock>
                    <TextBox Text="{Binding MassEditFieldName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,0,4" ToolTip="Field name"/>
                    <TextBox Text="{Binding MassEditFieldValue, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="8,0,0,4"
                             ToolTip="The value, e.g. 1313, or &quot;text&quot; in quotes. It's set on every selected item (added where it's missing)."/>
                    <Button Content="Apply to selection" Command="{Binding ApplyMassEditCommand}" Margin="8,0,0,4"
                            ToolTip="Sets this field on every selected item (added if an item doesn't already have it)"/>
                    <TextBlock Text="{Binding MassEditStatusMessage}" Foreground="{DynamicResource AccentForegroundBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,4" TextWrapping="Wrap"/>
                </WrapPanel>
            </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ItemFields}">
                <Grid>
                <TextBlock Text="{Binding NoDataRowsMessage}" TextWrapping="Wrap" Margin="16" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Visibility="{Binding NoDataRowsMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="Pick an item on the left to see its fields." Style="{StaticResource EmptyStateTextStyle}" IsHitTestVisible="False"
                           Visibility="{Binding ShowPickItemPrompt, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ScrollViewer x:Name="ItemFieldsScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10,12,4">
                        <DockPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                            <Button DockPanel.Dock="Right" Content="Open in Editor" Command="{Binding OpenInGameEditorCommand}" VerticalAlignment="Top"
                                    ToolTip="Show this game item on the Editor page, with all its other parts (armour, buff, recipe…) in plain words"/>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItem.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource FaintForegroundBrush}" FontFamily="Consolas" TextWrapping="Wrap">
                                    <Run Text="{Binding SelectedItem.RealPath, Mode=OneWay}"/><Run Text=" › "/><Run Text="{Binding SelectedItem.ItemName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="An orange border marks a value that differs from the game's. ↺ puts the game's value back; ✕ takes the field out of the mod." FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExmodFieldsBarTemplate}"
                                        Visibility="{Binding FieldsSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ItemsControl x:Name="FieldsList" ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource EditorFieldTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource ExmodFieldGroupItemStyle}" AlternationCount="6"/>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock Text="{Binding FieldsEmptyText}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Visibility="{Binding FieldsEmptyText, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExmodAddFieldTemplate}"
                                        Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ScaleRules}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="What a rule is" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,8"
                                   Text="A rule changes one field on every row of a game table, like every item's Weight ×0.5 or every crate's Slots ×2. Apply writes those rows into this mod from your current game data. After a game update, click Apply again: new items get the same change, so the mod doesn't go out of date."/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"
                                   Text="Multiply by: a number below 1 lowers the value (0.5 = half), above 1 raises it (2 = double), 1 leaves it as is, 0 makes it zero. Set to: every row gets exactly that number."/>

                        <!-- Rules this mod's own rows already follow -->
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                Background="{DynamicResource AccentSoftBrush}"
                                Visibility="{Binding HasScaleSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Suggested from this mod" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"
                                           Text="This mod already changes these fields the same way on many rows. As a rule, it writes the same values it has now, and after a game update it also changes the new rows."/>
                                <ItemsControl ItemsSource="{Binding ScaleSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Left" Content="Add as rule" Padding="8,1" VerticalAlignment="Top" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.AddSuggestedRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        ToolTip="Adds this rule to the list below. Apply rules then writes it (the same values this mod has now)."/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,8" Visibility="{Binding ScaleSuggestionsMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <Button DockPanel.Dock="Right" Content="Look again" Padding="8,1" Command="{Binding FindScaleSuggestionsCommand}" VerticalAlignment="Top" Margin="8,0,0,0"
                                    ToolTip="Looks through this mod's rows again for a field changed the same way on many rows"/>
                            <TextBlock Text="{Binding ScaleSuggestionsMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource FaintForegroundBrush}"/>
                        </DockPanel>

                        <TextBlock Text="No rules yet. Start from a suggestion above, a starter below, or Add rule." Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"
                                   TextWrapping="Wrap" Visibility="{Binding HasNoScaleRules, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- One-click starters: the Quality of life template's rules -->
                        <Expander Margin="0,0,0,10" IsExpanded="{Binding HasNoScaleRules, Mode=OneWay}" AutomationProperties.Name="Starter rules">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Starter rules" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="one click adds a ready rule; change its number after" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding ScaleStarters}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Margin="0,0,6,6" Padding="8,2"
                                                Command="{Binding DataContext.AddStarterRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="{Binding Details}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <ItemsControl ItemsSource="{Binding ScaleRuleRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" ToolTip="Remove this rule (Apply then takes its values back out of the mod)"
                                                        Command="{Binding DataContext.RemoveScaleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="On / off"
                                                          AutomationProperties.Name="Rule on"/>
                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" FontWeight="SemiBold"
                                                         ToolTip="What this rule is for, in your words" AutomationProperties.Name="Rule name"/>
                                            </DockPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <StackPanel Margin="0,0,8,4">
                                                    <TextBlock Text="Table" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <ComboBox ItemsSource="{Binding Tables}" Text="{Binding CurrentFile, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="250"
                                                              ToolTip="The game table, e.g. Traits-D_Itemable.json (items' weight and stack size)"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,8,4">
                                                    <TextBlock Text="Field" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <ComboBox ItemsSource="{Binding FieldOptions}" Text="{Binding Field, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="250"
                                                              ToolTip="A number in that table. Name.* means every stat inside it (ArmourStats.*). Name[].Field means that field in every entry of a list (Inputs[].Count)."/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,8,4">
                                                    <TextBlock Text="Change" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <ComboBox ItemsSource="{Binding OperationOptions}" SelectedIndex="{Binding OperationIndex}" Width="110"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,8,4">
                                                    <TextBlock Text="Value" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                             ToolTip="Multiply by: 0.5 halves, 2 doubles, 0 makes it zero. Set to: the exact number."/>
                                                </StackPanel>
                                            </WrapPanel>
                                            <WrapPanel>
                                                <StackPanel Margin="0,0,8,4">
                                                    <TextBlock Text="Only rows whose name contains (blank = all)" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBox Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}" Width="250"
                                                             ToolTip="Several words separated by commas match any of them, e.g. Storage, Crate, Cupboard"/>
                                                </StackPanel>
                                                <CheckBox Content="Also rows using the table's default value" IsChecked="{Binding IncludeInherited}" VerticalAlignment="Bottom" Margin="0,0,8,6"
                                                          ToolTip="Leave this off for stack sizes: items left at the default stack of 1 are tools, weapons and armour, and scaling them would make them stack."/>
                                                <Button Content="Preview" Command="{Binding RefreshPreviewCommand}" VerticalAlignment="Bottom" Margin="0,0,0,4" Padding="8,1"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding PreviewText}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Visibility="{Binding PreviewText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Game rows this mod doesn't have yet (ExmodEditorViewModel.NotInMod.cs) -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=NotInMod}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"
                               Text="Game rows of a table this mod changes that it doesn't have yet. After a game update, the new items show up here. Tick the ones you want and add them in one go."/>
                    <WrapPanel Grid.Row="1">
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Table" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding NotInModTables}" SelectedItem="{Binding NotInModTable}" Width="260"
                                      ToolTip="One of the game tables this mod changes"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Only rows that set" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding NotInModFieldOptions}" SelectedItem="{Binding NotInModField}" Width="200"
                                      ToolTip="A field this mod changes in that table. Only game rows that set it themselves are listed (a stack mod: only items that stack)."/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Search" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBox Text="{Binding NotInModSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="180"
                                     ToolTip="Part of the in-game name or the row name" AutomationProperties.Name="Search rows not in this mod"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Grid.Row="2" Text="{Binding NotInModSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,6"
                               Visibility="{Binding NotInModSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <ListBox Grid.Row="3" ItemsSource="{Binding NotInModRows}" Background="Transparent" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasNotInModRows, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsPicked}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              AutomationProperties.Name="{Binding Title}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GameValueText}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource FaintForegroundBrush}"/>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RowName}" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource FaintForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ShowRowName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding NotInModUseModChange}" Visibility="{Binding HasNotInModChange, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ToolTip="Off: they're added with the game's value, for you to change">
                            <TextBlock Text="{Binding NotInModChangeText}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Text="{Binding NotInModAddHint}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,8,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=NotInMod}">
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Tick all" Command="{Binding PickAllNotInModCommand}" ToolTip="Ticks every row in the list (the search narrows it)"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Tick none" Command="{Binding PickNoNotInModCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Add ticked rows" Command="{Binding AddNotInModRowsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                        ToolTip="{Binding NotInModAddHint}"/>
                <TextBlock Text="{Binding NotInModStatus}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>

            <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,8,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ScaleRules}">
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Add rule" Command="{Binding AddScaleRuleCommand}" ToolTip="Adds a new rule card above"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Preview all" Command="{Binding PreviewScaleRulesCommand}" Margin="8,0,0,0"
                        ToolTip="Shows what each rule would change, without changing the mod"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Apply rules" Command="{Binding ApplyScaleRulesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                        ToolTip="Writes every rule's changes into this mod, worked out from the current game data (you can undo it). Also how the mod catches up after a game update."/>
                <TextBlock Text="{Binding ScaleStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>

            <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,12,0,0" VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Saves every change so far into this mod's file, from every view (Fields, Scale rules, Not in this mod yet): they all edit the same mod"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Turn on &amp; go to Merge &amp; Install" Command="{Binding TurnOnAndGoToMergeCommand}" Margin="8,0,0,0"
                        Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Ticks this mod ON (adds it to the merge queue) and opens Merge &amp; Install, where Install puts it in the game"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Undo (Ctrl+Z)" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="8,0,0,0"
                        ToolTip="Takes back the last change: adding or removing a field, adding or duplicating an item, a mass edit, or applying raw JSON (not each key you type). Greyed out: nothing to undo yet."
                        ToolTipService.ShowOnDisabled="True"/>
                <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Redo (Ctrl+Y)" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="8,0,0,0"
                        ToolTip="Puts back what Undo just took away. Greyed out: nothing undone, or a new change since."
                        ToolTipService.ShowOnDisabled="True"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
