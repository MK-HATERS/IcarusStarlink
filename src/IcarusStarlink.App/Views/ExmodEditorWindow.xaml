<Window x:Class="IcarusStarlink.App.Views.ExmodEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="680" Width="1040" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: items, grouped implicitly by file via sort order + the "File — Item" display text. -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Items" Style="{StaticResource FieldLabelStyle}"/>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         DisplayMemberPath="Display" Background="Transparent" BorderThickness="0"/>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="Add item" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding NewItemCurrentFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                         ToolTip="Real game data file path, e.g. Traits/D_Fuel.json"/>
                <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                         ToolTip="Item/row name in that file, e.g. Item_Wood"/>
                <Button Content="Add item" Command="{Binding AddItemCommand}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <!-- Right: three views over the same selected item/package — Item fields (structured,
             amber-highlighted), File JSON (one file's raw JSON), Full EXMOD JSON (the whole
             package's raw JSON) — sharing the left-hand selection per the spec's "Item fields,
             File JSON, or Full EXMOD JSON views" + "sync scroll" bullets. -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="Item fields" Style="{StaticResource ThemeButtonStyle}" Margin="0"
                        Command="{Binding SetViewModeCommand}" CommandParameter="ItemFields"
                        ToolTip="Structured, one row per field — the amber-highlighted view">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.ItemFields}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="File JSON" Style="{StaticResource ThemeButtonStyle}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="FileJson"
                        ToolTip="The selected item's own file, as raw JSON you can edit directly">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.FileJson}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
                <Button Content="Full EXMOD JSON" Style="{StaticResource ThemeButtonStyle}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="FullExmodJson"
                        ToolTip="The whole mod's .EXMOD, as raw JSON you can edit directly">
                    <Button.Tag>
                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                            <Binding Path="ViewMode"/>
                            <Binding Source="{x:Static vm:ExmodEditorViewMode.FullExmodJson}"/>
                        </MultiBinding>
                    </Button.Tag>
                </Button>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ItemFields}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Fields}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FieldName}" VerticalAlignment="Top" Margin="0,4,8,0" TextWrapping="Wrap"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FFB84D"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="{Binding BaseValueText, StringFormat='base: {0}'}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding ParseError}" FontSize="11" Foreground="#E05555" Margin="0,2,0,0"
                                                       Visibility="{Binding ParseError, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="✕" Padding="6,2" VerticalAlignment="Top" Margin="8,0,0,0"
                                                ToolTip="Remove this field"
                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FileJson}">
                <TextBox Text="{Binding FileJsonText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Padding="8"
                         BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FullExmodJson}">
                <TextBox Text="{Binding FullExmodJsonText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Padding="8"
                         BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ItemFields}">
                <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="Field name"/>
                <TextBox Text="{Binding NewFieldValue, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="8,0,0,0"
                         ToolTip="JSON value, e.g. 1313 or &quot;text&quot;"/>
                <Button Content="Add field" Command="{Binding AddFieldCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FileJson}">
                <Button Content="Apply file JSON" Command="{Binding ApplyFileJsonCommand}"
                        ToolTip="Re-parse this box and replace the selected item's file in the mod"/>
                <TextBlock Text="{Binding RawJsonStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FullExmodJson}">
                <Button Content="Apply full EXMOD JSON" Command="{Binding ApplyFullExmodJsonCommand}"
                        ToolTip="Re-parse this box and replace the whole mod's contents"/>
                <TextBlock Text="{Binding RawJsonStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <Button Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
