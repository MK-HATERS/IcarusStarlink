<UserControl x:Class="IcarusStarlink.App.Views.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Upload mods to your Icarus dedicated server over FTP. Saved sites reconnect without re-entering a password."
                   Style="{StaticResource PageBodyTextStyle}" Margin="0,4,0,16"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Site Manager -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Saved sites" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}"
                         BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding Host, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Command="{Binding NewSiteCommand}" AutomationProperties.Name="New site">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="New site" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding DeleteSiteCommand}" AutomationProperties.Name="Delete">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- The connection form only shows while actively creating/editing a site — opens
                     automatically on "New site" or selecting a saved one; a user can also collapse
                     it manually (two-way bound) without losing anything typed. -->
                <Expander Grid.Row="0" IsExpanded="{Binding IsSiteFormOpen, Mode=TwoWay}" AutomationProperties.Name="Site details">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Site details" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Text="Name · Host · Port · Username · Password · Remote path · Encryption" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding SiteNameInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Host" FontSize="12" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding HostInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The server's FTP hostname or IP address"/>

                    <TextBlock Text="Port" FontSize="12" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Username" FontSize="12" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Password" FontSize="12" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                 ToolTip="Leave blank to keep whatever's already saved for this site — a saved password is never shown back"/>

                    <TextBlock Text="Remote path" FontSize="12" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding RemotePathInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Directory to land in on connect — e.g. the server's own mods folder. Blank = wherever the server logs you in."/>

                    <TextBlock Text="Encryption" FontSize="12" Margin="0,8,0,2"/>
                    <ComboBox ItemsSource="{Binding EncryptionModes}" SelectedItem="{Binding EncryptionModeInput}"/>

                    <Button Content="Save site" Command="{Binding SaveSiteCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding SiteStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Command="{Binding ConnectCommand}" IsEnabled="{Binding IsNotConnected}"
                                Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Connect">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconServerBars}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Connect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Phase 10: a semantic status badge alongside Disconnect, matching the
                             pill-badge language used for Downloads' Status column. -->
                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="9" Padding="7,3" Margin="0,0,10,0"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="CONNECTED" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <!-- Icarus-server-specific sync actions — a fixed relative path from the FTP
                         login root (Content/Paks/mods, Binaries/Win64/...), confirmed against a
                         real dedicated server rather than a per-site configurable field. Each one
                         names exactly what it's about to delete/upload/skip in its own confirmation
                         prompt before doing anything. -->
                    <TextBlock Text="Icarus server sync" Style="{StaticResource FieldLabelStyle}"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,20,0,6"/>
                    <WrapPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Install merged pak" Command="{Binding InstallPakToServerCommand}"
                                ToolTip="Uploads the last built merged pak (Merge &amp; Install's own Rebuild output) to the server's Content/Paks/mods, replacing whatever's already there."/>
                        <Button Content="Sync UE4SS loader" Command="{Binding SyncUe4ssLoaderToServerCommand}" Margin="8,0,0,0"
                                ToolTip="Checks the server's own UE4SS version and uploads the loader if it's missing or out of date. Never touches the server's own Mods folder or an existing UE4SS-settings.ini."/>
                        <Button Content="Sync UE4SS mods" Command="{Binding SyncUe4ssModsToServerCommand}" Margin="8,0,0,0"
                                ToolTip="Uploads any locally-enabled UE4SS mod the server doesn't already have. Never removes or overwrites a mod already on the server."/>
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Remote file browser -->
            <Grid Grid.Column="2" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding CurrentRemotePath}" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <Button Command="{Binding NavigateUpCommand}" Style="{StaticResource IconButtonStyle}" Width="28" Margin="12,0,0,0"
                            ToolTip="Up" AutomationProperties.Name="Up">
                        <Path Data="{StaticResource IconArrowUp}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Margin="8,0,0,0" AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateIntoCommand}" CommandParameter="{Binding SelectedRemoteEntry}" Margin="8,0,0,0" AutomationProperties.Name="Open folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Open folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding RemoteEntries}" SelectedItem="{Binding SelectedRemoteEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Type" Width="80" Binding="{Binding IsDirectory, Converter={StaticResource BoolToFolderFileConverter}}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="100"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt, StringFormat='{}{0:g}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Command="{Binding UploadCommand}"
                            ToolTip="Uploads a local file into the current remote folder" AutomationProperties.Name="Upload">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="Upload…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DownloadCommand}" Margin="8,0,0,0"
                            ToolTip="Downloads the selected remote file to a location you choose" AutomationProperties.Name="Download">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Download…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteRemoteCommand}" Margin="8,0,0,0"
                            ToolTip="Deletes the selected remote file from the server — asks for confirmation first" AutomationProperties.Name="Delete">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Column="2" Text="Connect to a saved site to browse and manage its files."
                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
