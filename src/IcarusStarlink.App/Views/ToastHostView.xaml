<UserControl x:Class="IcarusStarlink.App.Views.ToastHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
             mc:Ignorable="d">

    <!-- The pop-up message cards under the header's bell (see ToastsViewModel). Newest on top, at
         most three; click one to close it, hold the mouse over it to keep it. Only the cards take
         clicks: the empty area around them lets clicks through to the page underneath. -->
    <ItemsControl x:Name="Cards" ItemsSource="{Binding Toasts}" Width="340" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ToastItem}">
                <Border x:Name="Card" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave"
                        ToolTip="Click to close" AutomationProperties.Name="{Binding Message}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                      Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Stripe" Grid.Column="0" CornerRadius="7,0,0,7" Background="{DynamicResource SuccessBrush}"/>
                        <Path x:Name="KindIcon" Grid.Column="1" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" Margin="10,12,0,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="10,10,14,10"
                                   MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource DangerBrush}"/>
                        <Setter TargetName="KindIcon" Property="Stroke" Value="{DynamicResource DangerBrush}"/>
                        <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource IconWarning}"/>
                    </DataTrigger>
                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
