<Window x:Class="IcarusStarlink.App.Views.GameUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="760" Width="980" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- What a tick or choice does, under it, wrapping. -->
        <Style x:Key="GameUpdateHintStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="22,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>

        <!-- One line in a group: the mod, a short tag, why, and its one button. -->
        <DataTemplate x:Key="ReviewRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                    Background="{DynamicResource CardBackgroundBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" VerticalAlignment="Top" Margin="10,0,0,0" Padding="10,2"
                            IsEnabled="{Binding CanAct}"
                            Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Tag, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- After a game update: the run's steps as they go, then what it fixed, what needs a look and
         which mods the update's changes may not reach. Roll back is always at the bottom. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                       Visibility="{Binding Note, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <!-- The steps of Update everything: open while they run, foldable afterwards to give the
             results the room. -->
        <Expander Grid.Row="1" Margin="0,0,0,12" IsExpanded="True" AutomationProperties.Name="Steps"
                  Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVisibilityConverter}}">
            <Expander.Header>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Steps" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                    <TextBlock DockPanel.Dock="Left" Text="what Update everything did, one line each" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                </DockPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StateText" Text="{Binding StateLabel}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"/>
                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Before Start: what the run does, with a tick for each step that can be left out.
                     Nothing runs, and nothing is asked later, until Start. -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="These always run" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,12"
                               Text="Save your setup as it is now (so you can roll back), note the game files mods replace, refresh game data, and check every mod against the new game. None of these change a mod."/>

                    <TextBlock Text="When the check finds sure problems in a mod" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <RadioButton GroupName="GameUpdateFix" IsChecked="{Binding FixShowFirst}" Margin="0,2" Content="Show me first"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}"
                               Text="Stops after the check and lists what would be fixed in each mod, with a tick for each. Nothing is changed until you click Continue."/>
                    <RadioButton GroupName="GameUpdateFix" IsChecked="{Binding FixByItself}" Margin="0,2" Content="Fix by itself"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}"
                               Text="Makes the proven fixes without stopping. Each mod is backed up first."/>
                    <RadioButton GroupName="GameUpdateFix" IsChecked="{Binding FixDontFix}" Margin="0,2" Content="Don't fix"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}" Margin="22,0,0,12"
                               Text="Changes no mod. The review still lists what the check found."/>

                    <TextBlock Text="Also do" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox IsChecked="{Binding RedrawMaps}" Margin="0,2" Content="Redraw the maps that changed"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}"
                               Text="About a minute for each big map. This is the same box as Redraw during Update everything on the Map page."/>
                    <CheckBox IsChecked="{Binding CheckForModUpdates}" Margin="0,2" Content="Check for mod updates"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}"
                               Text="Looks for newer versions of your mods. Downloads nothing."/>
                    <CheckBox IsChecked="{Binding BuildMerge}" Margin="0,2" Content="Build the merge"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}"
                               Text="Makes the merged pak from your ticked mods. Unticking this also unticks Install."/>
                    <CheckBox IsChecked="{Binding Install}" IsEnabled="{Binding CanTickInstall}" Margin="0,2" Content="Install it in the game"/>
                    <TextBlock Style="{StaticResource GameUpdateHintStyle}"
                               Text="Copies the merged pak into the game's Paks\mods folder, backing up the one there. Ticking this is your yes: it isn't asked again at the end. Left out if Icarus is running by then."/>
                    <TextBlock Text="{Binding InstallNote}" Style="{StaticResource GameUpdateHintStyle}" Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasInstallNote, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <DockPanel LastChildFill="True" Margin="0,14,0,0">
                        <Button DockPanel.Dock="Left" Content="Start" Command="{Binding StartCommand}" IsDefault="True" Padding="18,4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Runs the steps above. Your choices are remembered for next time."/>
                        <TextBlock Text="Your choices are remembered. Close this window to do nothing." VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"
                                   FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </DockPanel>
                </StackPanel>

                <!-- Show me first: the run waits here after the check. Each mod with what would be
                     fixed and a tick; nothing is changed until Continue. -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsReviewingFixes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Sure fixes, not made yet" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"
                               Text="Only proven fixes: old copies of game data and links to rows the game no longer has. Untick a mod to leave it as it is. Each mod that is fixed is backed up first (right-click it in the Library › Restore latest backup undoes it)."/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Continue" Command="{Binding ContinueWithFixesCommand}" Padding="14,3" Margin="0,0,8,4" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Fixes the ticked mods, then goes on with the next steps."/>
                        <Button Content="Skip fixes" Command="{Binding SkipFixesCommand}" Padding="14,3" Margin="0,0,8,4"
                                ToolTip="Fixes nothing and goes on with the next steps."/>
                        <Button Content="Stop" Command="{Binding StopRunCommand}" Padding="14,3" Margin="0,0,8,4"
                                ToolTip="Fixes nothing and ends here. The later steps don't run."/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding FixesToReview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                                        Background="{DynamicResource CardBackgroundBrush}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsTicked}" VerticalAlignment="Top" Margin="0,2,10,0"
                                                  AutomationProperties.Name="{Binding Name}" ToolTip="Ticked: fixed when you click Continue. Unticked: left as it is."/>
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Tag, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Nothing needed fixing, nothing to look at and nothing at risk." FontSize="13" Margin="0,0,0,12"
                           Visibility="{Binding IsAllClear, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Most urgent first: High risk and Needs a look open, Fixed for you (already done,
                     just to know) folded with its count showing. -->
                <Expander Visibility="{Binding HasHighRisk, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12"
                          IsExpanded="True" AutomationProperties.Name="High risk">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="High risk" Style="{StaticResource ExpanderHeaderTitleStyle}" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ExpanderHeaderStateStyle}">
                                <Run Text="{Binding HighRisk.Count, Mode=OneWay}"/><Run Text=" mod(s) replace a game file this update changed"/>
                            </TextBlock>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="&quot;Out of date&quot; is proven: the mod still has the game's code from before the update. If something stops working, keep the mod off until its author updates it."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding HighRisk}" ItemTemplate="{StaticResource ReviewRowTemplate}"/>
                    </StackPanel>
                </Expander>

                <Expander Visibility="{Binding HasNeedsALook, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12"
                          IsExpanded="True" AutomationProperties.Name="Needs a look">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Needs a look" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ExpanderHeaderStateStyle}">
                                <Run Text="{Binding NeedsALook.Count, Mode=OneWay}"/><Run Text=" thing(s) to look over or update"/>
                            </TextBlock>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="Things Starlink wasn't sure enough to change by itself, and mods with a newer version out."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding NeedsALook}" ItemTemplate="{StaticResource ReviewRowTemplate}"/>
                    </StackPanel>
                </Expander>

                <Expander Visibility="{Binding HasFixedForYou, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12"
                          IsExpanded="False" AutomationProperties.Name="Fixed for you">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Fixed for you" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ExpanderHeaderStateStyle}">
                                <Run Text="{Binding FixedForYou.Count, Mode=OneWay}"/><Run Text=" mod(s) with proven fixes, each backed up first"/>
                            </TextBlock>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="Only proven fixes: old copies of game data and links to rows the game no longer has. Each mod was backed up first (right-click it in the Library › Restore latest backup undoes it)."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding FixedForYou}" ItemTemplate="{StaticResource ReviewRowTemplate}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding RollBackText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8"/>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseWindowCommand}" IsCancel="True" Margin="8,0,0,0" Padding="14,3"/>
                <Button DockPanel.Dock="Left" Content="Roll back to before the update" Command="{Binding RollBackCommand}" Padding="10,3"
                        ToolTip="{Binding RollBackText}" ToolTipService.ShowOnDisabled="True"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
