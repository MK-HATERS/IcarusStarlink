<Window x:Class="IcarusStarlink.App.Views.ThemedConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        SizeToContent="Height" Width="460" MinHeight="160" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!--
    Built in code, not bound to a view model: the static Show methods set the title, message and
    severity, then ShowDialog. Ctrl+C copies the whole box as text, as in the Windows message box.
    -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed"/>
    </Window.CommandBindings>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Path x:Name="SeverityIcon" Width="22" Height="22" StrokeThickness="1.8" Stretch="Uniform"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- MaxHeight is set in code from the screen height, so a long message scrolls and the buttons stay on screen. -->
        <ScrollViewer x:Name="MessageScroller" Grid.Row="1" Margin="0,0,0,20" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundBrush}" FontSize="13"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="72" Visibility="Collapsed"/>
            <Button x:Name="ThirdButton" Click="Third_Click" Margin="0,0,8,0" MinWidth="72" Visibility="Collapsed"/>
            <Button x:Name="NoButton" Content="No" Click="No_Click" Margin="0,0,8,0" MinWidth="72"/>
            <Button x:Name="YesButton" Content="Yes" Click="Yes_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
