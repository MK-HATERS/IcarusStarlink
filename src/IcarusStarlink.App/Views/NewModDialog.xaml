<Window x:Class="IcarusStarlink.App.Views.NewModDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="New mod" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <StackPanel Margin="20">
        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12"/>

        <TextBlock Text="Author" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox x:Name="AuthorBox" Margin="0,4,0,16"/>

        <TextBlock Text="Starting point" Style="{StaticResource FieldLabelStyle}"/>
        <!--
        All five real templates are classic IMM's own official ones (Jimk72's own GitHub) — the
        first two from its published Blank_Craftable_Item/Blank_Consumable_Item.EXMODZ, the other
        three from that same tool's own bundled NewItemOptions.json ("Add Item to Mod... premade
        templates") — each a genuinely complete, working item skeleton, not an invented one.
        -->
        <RadioButton x:Name="BlankRadio" GroupName="Template" IsChecked="True" Margin="0,6,0,0"
                     Content="Blank — no fields yet, build it up by hand"/>
        <RadioButton x:Name="QualityOfLifeRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Quality of life — stack sizes, weight, crafting and growth time…"
                     ToolTip="Not an item: a set of rules like 'Stack sizes ×4' and 'Item weight halved', each with its own on/off and number, built from your own game data. Change them in the editor's Scale rules view."/>
        <TextBlock Text="A new item, made from a game item" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,12,0,0"/>
        <RadioButton x:Name="EnvirosuitRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Envirosuit — bought in the workshop"
                     ToolTip="Opens the new-item wizard starting from the Xigo Envirosuit: your own name, icon and armour stats, sold in the orbital workshop's Envirosuits tab (or a tab of your own)."/>
        <RadioButton x:Name="ModuleRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Envirosuit module — bought in the workshop"
                     ToolTip="Opens the new-item wizard starting from a suit module: your own name, icon and stat bonuses, sold in the workshop's Modules tab."/>
        <RadioButton x:Name="ConsumableBuffRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Food or medicine with its own buff — crafted"
                     ToolTip="Opens the new-item wizard starting from Bread (pick any food or medicine): its own name, what eating it does and its own buff, cooked or crafted at a bench you choose."/>
        <RadioButton x:Name="WorkshopItemRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Any item, bought in a workshop tab of your own"
                     ToolTip="Opens the new-item wizard: pick any game item to start from; it's sold in a new orbital-workshop tab of this mod's own."/>
        <RadioButton x:Name="MapIconRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Map icon — for a blueprint or Lua mod"
                     ToolTip="A map and compass marker. Nothing shows it by itself: your mod's blueprint or Lua script looks it up by its row name, the way the Teleporters mod does."/>

        <TextBlock Text="Classic IMM templates" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,12,0,0"/>
        <RadioButton x:Name="CraftableRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Craftable / deployable item"
                     ToolTip="A complete placeable/craftable item skeleton (recipe, mesh, icon, all reusing a real vanilla campfire's own assets as placeholders) — the same official template classic IMM itself ships."/>
        <RadioButton x:Name="ConsumableRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Consumable / meta item"
                     ToolTip="A complete craftable consumable item skeleton (recipe, icon, byproducts) reusing a real vanilla crate icon as a placeholder — the same official template classic IMM itself ships."/>
        <RadioButton x:Name="BuildingPieceRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Building piece"
                     ToolTip="A craftable wood wall skeleton (recipe, stability/type traits, building-piece entry) reusing the real vanilla wood-kit mesh — its own Blueprint/icon are left as placeholders for your own custom art, the same as classic IMM's own template."/>
        <RadioButton x:Name="ElectricGeneratorRadio" GroupName="Template" Margin="0,6,0,0"
                     Content="Electric generator"
                     ToolTip="A craftable deployable that produces energy (recipe, resource/energy traits) — its own mesh/Blueprint are left as placeholders for your own custom art, the same as classic IMM's own template."/>
        <RadioButton x:Name="WaterPumpRadio" GroupName="Template" Margin="0,6,0,16"
                     Content="Water pump"
                     ToolTip="A craftable deployable that produces water for a resource network (recipe, generator/resource traits) reusing the real vanilla machining-kit mesh — its own Blueprint is left as a placeholder for your own custom art, the same as classic IMM's own template."/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Create" Click="Create_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
