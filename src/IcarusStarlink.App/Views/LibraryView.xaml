<UserControl x:Class="IcarusStarlink.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
             xmlns:utilities="clr-namespace:IcarusStarlink.App.Utilities"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- DataGridColumn.Visibility can't reach a nested VM via ElementName (see BindingProxy's
             own doc comment) — every toggleable IMM Database column binds through this proxy
             instead. Points at Downloads specifically (not the page's own DataContext), since the
             column-visibility properties live on DownloadsViewModel, folded in from the former
             standalone Downloads page along with the IMM Database tab itself. -->
        <utilities:BindingProxy x:Key="ViewModelProxy" Data="{Binding Downloads}"/>

        <HierarchicalDataTemplate DataType="{x:Type vm:LibraryGroupViewModel}" ItemsSource="{Binding Items}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count, StringFormat=' ({0} options)'}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- A download in progress — not a real mod yet, so no context menu/selection/detail pane,
             just a name and a spinner. Disappears on its own once the download finishes (success
             blends into a real row above via the normal LibraryChangedMessage reload; failure just
             removes the stub with nothing left behind). -->
        <DataTemplate DataType="{x:Type vm:DownloadStubViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2" IsHitTestVisible="False">
                <Path Style="{StaticResource SpinnerIconStyle}" Width="12" Height="12" Margin="0,0,7,0"/>
                <TextBlock FontStyle="Italic" Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text=" — downloading…"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Phase 10 redesign: real icons replace the raw emoji markers, and hovering a row
             reveals inline Pin/Favorite/Edit actions (RowActions, opacity 0→1 on IsMouseOver)
             instead of only the detail pane or the right-click menu below. -->
        <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <!-- SharedSizeGroup on every column, matching the header Grid above (both sit inside the
                 Mods tab's own Grid.IsSharedSizeScope="True") — the real column-alignment fix; see
                 that Grid's own comment for why Width="*" alone never actually worked here. A
                 nested/variant row's indentation still shifts its own columns slightly right of the
                 header's — TreeView has no fix for that specifically, accepted as a minor tradeoff
                 given most rows are top-level (unindented). -->
            <Grid x:Name="Row" Margin="0,3"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.Style>
                    <!-- Ctrl/Shift-click bulk selection for "Add to merge queue" — a soft accent
                         wash, distinct from the TreeView's own native selection highlight, so a
                         user can tell "picked for the merge queue" apart from "currently viewing
                         details for" at a glance. -->
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedForBulk}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColIcons"/>
                    <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="360" SharedSizeGroup="ColName"/>
                    <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ColAuthor"/>
                    <ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="ColVersion"/>
                    <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColSource"/>
                    <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColStatus"/>
                    <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="ColActions"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <!-- Right-clicking selects the row first (see code-behind), so Pin/Favorite here apply to
                         the same mod the detail pane is about to show. Notes doesn't need its own entry —
                         the same right-click already surfaces the Notes box in the detail pane below.
                         A ContextMenu is its own top-level Popup, not part of this Grid's visual tree, so a
                         plain RelativeSource AncestorType=UserControl lookup from inside it finds nothing —
                         confirmed the hard way earlier this session with the same shape of bug (a
                         VisualBrush.Visual binding that silently resolved to nothing). Row's own Tag above
                         relays the page VM across that boundary: PlacementTarget (a real property WPF sets
                         to whatever opened the menu, so it stays inside the real visual tree) exposes that
                         Tag back to the MenuItem below. -->
                    <ContextMenu>
                        <!-- The primary reason to right-click a mod at all now that Merge & Install
                             has no browsing pane of its own — Ctrl/Shift-click first to select more
                             than one, this adds the whole bulk selection (see EnsureBulkSelected in
                             code-behind), or just this row alone if nothing else is selected. -->
                        <MenuItem Command="{Binding PlacementTarget.Tag.AddToMergeQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Adds the selected mod(s) to Merge &amp; Install's queue">
                            <MenuItem.Header>
                                <TextBlock>
                                    <Run Text="Add to merge queue"/>
                                    <Run Text=" ("/><Run Text="{Binding PlacementTarget.Tag.BulkSelectedCount, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Pinned" IsCheckable="True" IsChecked="{Binding IsPinned}"/>
                        <MenuItem Header="Favorite" IsCheckable="True" IsChecked="{Binding IsFavorite}"/>
                        <Separator/>
                        <MenuItem Header="Rename…"
                                  Command="{Binding PlacementTarget.Tag.RenameItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Change how this mod displays in Library — its real folder/files aren't touched"/>
                        <Separator/>
                        <MenuItem Header="Create mod backup"
                                  Command="{Binding PlacementTarget.Tag.BackupModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Snapshots this mod's whole folder — a safety net before a risky manual edit"/>
                        <MenuItem Header="Restore latest backup"
                                  Command="{Binding PlacementTarget.Tag.RestoreModBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding HasModBackup}"
                                  ToolTip="Replaces this mod's current content with its most recent backup"
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="See what changed vs previous version…"
                                  Command="{Binding PlacementTarget.Tag.CompareToPreviousVersionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding HasModBackup}"
                                  ToolTip="Shows exactly which values and files the author changed between your previous copy and the current one — read-only, nothing is restored"
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Find in Database"
                                  Command="{Binding PlacementTarget.Tag.FindInDatabaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Search the community mod database for this mod by name"/>
                        <MenuItem Header="Search Nexus for this"
                                  Command="{Binding PlacementTarget.Tag.SearchNexusForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Search Nexus for this mod by name — useful when it has no Nexus link yet"/>
                        <MenuItem Header="Open on Nexus" Command="{Binding OpenOnNexusCommand}" IsEnabled="{Binding HasNexusLink}"
                                  ToolTip="Open this mod's Nexus page in your browser"
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Link to Nexus ID…"
                                  Command="{Binding PlacementTarget.Tag.LinkToNexusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Connect this mod to a real Nexus mod ID so it can be checked for updates"/>
                        <Separator/>
                        <MenuItem Header="Delete"
                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Removes this mod's folder from your Library — asks first, and can't be undone without a backup"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"
                          ToolTip="Locally edited in the EXMOD editor"
                          Visibility="{Binding IsLocallyEdited, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Path Data="{StaticResource IconPackage}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"
                          ToolTip="A rebuilt merged pak, re-imported as its own mod"
                          Visibility="{Binding IsMergedPack, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- A single TextBlock, not the StackPanel this used to be — StackPanel gives its
                     children unbounded measure width regardless of the column's own real size, which
                     silently defeats TextTrimming (nothing was ever actually being measured against a
                     bounded width to trim against). VariantSuffixConverter, not StringFormat: WPF
                     still runs String.Format even for a null source value (TargetNullValue is
                     substituted BEFORE StringFormat, not instead of it) — confirmed live, every row
                     rendered a bare " — " suffix even with no VariantLabel at all until this was
                     fixed. -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name}"/><Run Text="{Binding VariantLabel, Converter={StaticResource VariantSuffixConverter}}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="{Binding Author}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="8,0,0,0"/>

                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0">
                    <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>

                <Border Grid.Column="4" CornerRadius="7" Padding="5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                        Background="{DynamicResource InfoBrush}"
                        Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Source}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                </Border>

                <Border Grid.Column="5" CornerRadius="7" Padding="5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                        Background="{DynamicResource AccentBrush}" ToolTip="{Binding LatestVersion, StringFormat='Update available: v{0}'}"
                        Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Update" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}"/>
                </Border>

                <StackPanel x:Name="RowActions" Grid.Column="6" Orientation="Horizontal" Opacity="0" HorizontalAlignment="Right">
                    <ToggleButton IsChecked="{Binding IsPinned}" Style="{StaticResource IconToggleButtonStyle}"
                                  ToolTip="Pin" AutomationProperties.Name="Toggle pinned">
                        <Path Data="{StaticResource IconPin}" Width="12" Height="12" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsFavorite}" Style="{StaticResource IconToggleButtonStyle}"
                                  ToolTip="Favorite" AutomationProperties.Name="Toggle favorite">
                        <Path Data="{StaticResource IconStar}" Width="12" Height="12" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="#FFD24C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButtonStyle}" Width="22" Height="22" ToolTip="Edit…" AutomationProperties.Name="Edit mod"
                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Pinned/Favorite no longer duplicate onto a separate always-on left-side glyph
                     (the previous design) — the same right-side toggle icon IS the indicator now:
                     hover reveals it as an invitation to act on a not-yet-pinned/favorited row, and
                     it stays visible (its own Fill already turns solid/accent-colored via the
                     DataTriggers below) once the state is actually on, instead of disappearing again
                     the moment the mouse leaves. -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <TabControl Grid.Row="1" Margin="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Mods">
                <!-- IsSharedSizeScope + SharedSizeGroup (on the header Grid below and on the row
                     DataTemplate's own Grid, in UserControl.Resources above) is the real fix for
                     column alignment — a Width="*" column plainly does NOT resolve to a shared,
                     consistent width across a TreeView's independently-templated/virtualized rows,
                     confirmed by two failed attempts (HorizontalContentAlignment="Stretch" alone;
                     then that plus disabling horizontal scroll) that left every row's later columns
                     drifting by however much its own Name text's natural width differed from other
                     rows'. SharedSizeGroup is the WPF-native mechanism built for exactly this problem
                     — it computes one shared width per named group across every Grid in scope,
                     including inside a virtualized ItemsControl, independent of ScrollViewer/Measure
                     quirks. Star-sizing and SharedSizeGroup don't combine (a shared-size column is
                     always evaluated as Auto), so Name gets a generous fixed width instead of "fill
                     remaining space" — a real trade-off, but a correctly-aligned table beats an
                     elastic one that doesn't line up. -->
                <Grid Margin="0,12,0,0" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Phase 10 follow-up: grouped by purpose (refresh · create/import · check) with
                         thin dividers between groups, rather than one undifferentiated row. Import
                         folder… deliberately no longer carries PrimaryButtonStyle — with Fetch (row
                         below) now also primary-styled as the headline "get a mod" action, having a
                         second, unrelated primary button in the toolbar read as arbitrary. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding RefreshCommand}" Margin="0,0,10,0" ToolTip="Re-scan Extracted_Mods from disk" AutomationProperties.Name="Refresh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,4,10,4"/>

                        <Button Command="{Binding NewModCommand}" Margin="0,0,8,0" ToolTip="Create a blank EXMOD (name + author) and open it in the editor" AutomationProperties.Name="New mod">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="New mod…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFileCommand}" Margin="0,0,8,0" AutomationProperties.Name="Import EXMODZ">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Import EXMODZ…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFolderCommand}" Margin="0,0,8,0" AutomationProperties.Name="Import folder">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Import folder…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportPakCommand}" Margin="0,0,10,0"
                                ToolTip="Import a prebuilt .pak as an opaque library entry — no .EXMOD, can't be browsed or edited"
                                AutomationProperties.Name="Import .pak">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPackage}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Import .pak…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,4,10,4"/>

                        <Button Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0"
                                ToolTip="Checks every Nexus- or Database-sourced mod against its real current version"
                                AutomationProperties.Name="Check for updates">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Discoverable alternative to the row context menu's own "Add to merge
                             queue" — only appears once Ctrl/Shift-click has actually selected 2+
                             rows, since a single mod is just as easy to add via right-click alone. -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,4,10,4"
                                Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Command="{Binding AddToMergeQueueCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Adds the selected mods to Merge &amp; Install's queue"
                                AutomationProperties.Name="Add to merge queue">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMerge}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Add to merge queue ("/><Run Text="{Binding BulkSelectedCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Folded in from the former standalone Downloads page's own "Mods" tab: paste
                         a Nexus mod page URL (or an nxm:// link) to fetch and auto-import a mod
                         without going through the Nexus page at all. -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding Downloads.FetchNxmUrlCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Paste a Nexus mod page URL (fetches its main file) or an nxm:// link — imports automatically once downloaded"
                                AutomationProperties.Name="Fetch">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Fetch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Downloads.PendingDownloadStatusMessage}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="260"
                                   Visibility="{Binding Downloads.PendingDownloadStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Grid Margin="0,0,8,0">
                            <TextBox Text="{Binding Downloads.ManualNxmUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="e.g. nexusmods.com/icarus/mods/304 (or an nxm:// link from Mod Manager Download)"
                                       Style="{StaticResource PlaceholderTextStyle}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Downloads.ManualNxmUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </DockPanel>

                    <!-- Only shown when something genuinely needs attention — a successful download
                         already auto-imports and just becomes a normal row above, so the common case
                         is this section not appearing at all. -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Downloads.PendingDownloads.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Downloads needing attention" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Downloads.PendingDownloads}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="3*"/>
                                <DataGridTextColumn Header="Mod ID" Binding="{Binding ModId}" Width="80"/>
                                <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedAtUtc, StringFormat='{}{0:g}'}" Width="140"/>
                                <DataGridTemplateColumn Header="" Width="320">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Deleted from Library — click to reinstall" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="130"
                                                           Visibility="{Binding WasDeleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Margin="4,2"
                                                        Command="{Binding DataContext.Downloads.ActivatePendingDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Import this file into your Library — Reinstall replaces what's currently there"
                                                        AutomationProperties.Name="{Binding ActionLabel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding ActionLabel}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="4,2"
                                                        Command="{Binding DataContext.Downloads.DiscardPendingDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete the downloaded file and remove it from this list"
                                                        AutomationProperties.Name="Discard">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Discard" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, author, notes, or mod file/item contents"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding ModCount, Mode=OneWay}"/><Run Text=" mod(s) · "/><Run Text="{Binding GroupCount, Mode=OneWay}"/><Run Text=" group(s)"/>
                            <Run Text=" — double-click a mod for details, hover a row for quick actions" Foreground="{DynamicResource FaintForegroundBrush}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding UpdateCheckStatusMessage}"
                                   Visibility="{Binding UpdateCheckStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                   Text="{Binding UnreadableFoldersMessage}"
                                   Visibility="{Binding UnreadableFoldersMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Column headers — same fixed widths as the LibraryItemViewModel DataTemplate's
                         own Grid.ColumnDefinitions above, so labels line up with an unindented
                         (top-level) row's actual content. A TreeView has no real column-alignment
                         mechanism, so an indented variant row drifts right of these headers by its
                         own indent amount — accepted as a reasonable tradeoff (see the row template's
                         own comment) now that the inline detail pane (which this replaced) is gone
                         and double-clicking a mod opens ModDetailWindow instead. -->
                    <Grid Grid.Row="4" Margin="4,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColIcons"/>
                            <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="360" SharedSizeGroup="ColName"/>
                            <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ColAuthor"/>
                            <ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="ColVersion"/>
                            <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColSource"/>
                            <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColStatus"/>
                            <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="ColActions"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Column="2" Text="AUTHOR" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="VERSION" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="SOURCE" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="5" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <!-- The real column-alignment fix is Grid.IsSharedSizeScope/SharedSizeGroup
                             (see the Mods tab's own Grid, and the header/row column definitions) —
                             a plain Width="*" column never resolves to a shared width across a
                             TreeView's independently-rendered rows, confirmed live. Horizontal scroll
                             stays Auto (the TreeView default) rather than Disabled: with real
                             fixed/shared column widths now driving layout instead of "*", scroll
                             visibility no longer affects alignment either way, and Auto is what keeps
                             the row-actions column (Pin/Favorite/Edit/Delete) reachable if the window
                             is ever narrower than the columns' own combined MinWidths. -->
                        <TreeView x:Name="LibraryTree" ItemsSource="{Binding RootItems}" Background="Transparent" BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  SelectedItemChanged="LibraryTree_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="LibraryTree_PreviewMouseRightButtonDown"
                                  PreviewMouseLeftButtonDown="LibraryTree_PreviewMouseLeftButtonDown"
                                  MouseDoubleClick="LibraryTree_MouseDoubleClick"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="UE4SS mods">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Enable/disable UE4SS mods, then click Apply. Enabling moves a mod into the game's real Mods folder; disabling moves it back out here, ready to re-enable later."
                                   Style="{StaticResource PageBodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                        <Button Content="Import…" Command="{Binding ImportUe4ssModCommand}" Margin="12,0,0,0"
                                ToolTip="Stage a UE4SS mod from a downloaded zip — lands here disabled, ready to enable and Apply"/>
                        <Button Content="Refresh" Command="{Binding ReloadInstalledUe4ssModsCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Ue4ssStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="12" Margin="0,4,0,8"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Ue4ssMods}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="Checked = enabled (in the real game Mods folder). Nothing moves until you click Apply below."
                                              AutomationProperties.Name="{Binding Name, StringFormat='Enable {0}'}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="260"/>
                                    <!-- Set when this mod was downloaded through the Nexus pipeline (see
                                         DownloadsViewModel.EnrichUe4ssModFromNexusAsync) — a manually
                                         imported UE4SS mod has no link, so no badge. -->
                                    <Border Margin="0,0,6,0" CornerRadius="8" Padding="7,2" VerticalAlignment="Center"
                                            Background="{DynamicResource InfoBrush}"
                                            ToolTip="Downloaded via Nexus — linked to its catalog page for update-checking"
                                            Visibility="{Binding HasNexusLink, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Nexus" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                                    </Border>
                                    <Border Margin="0,0,6,0" CornerRadius="8" Padding="7,2" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}">
                                            <Run Text="Update available: v"/><Run Text="{Binding LatestVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="modified" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                               VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="Apply" Command="{Binding ApplyUe4ssChangesCommand}"
                            IsEnabled="{Binding HasPendingUe4ssChanges}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                            ToolTip="Moves every checked/unchecked mod to match — backs up anything removed from the game folder first"/>
                </Grid>
            </TabItem>

            <!-- Last, per explicit placement request — folded in from the former standalone
                 Downloads page. Every binding here targets Downloads (the nested DownloadsViewModel),
                 not this page's own LibraryViewModel DataContext. -->
            <TabItem Header="IMM Database">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button x:Name="ColumnsButton" Command="{Binding Downloads.ToggleColumnsMenuCommand}" AutomationProperties.Name="Columns">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGearTeeth}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Columns" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding Downloads.IsColumnsMenuOpen, Mode=TwoWay}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="170">
                                    <StackPanel>
                                        <TextBlock Text="Columns" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Author" IsChecked="{Binding Downloads.ShowAuthorColumn}" Margin="0,3"/>
                                        <CheckBox Content="Version" IsChecked="{Binding Downloads.ShowVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Inst.Ver" IsChecked="{Binding Downloads.ShowInstalledVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Compat." IsChecked="{Binding Downloads.ShowCompatibilityColumn}" Margin="0,3"/>
                                        <CheckBox Content="Category" IsChecked="{Binding Downloads.ShowCategoryColumn}" Margin="0,3"/>
                                        <CheckBox Content="Status" IsChecked="{Binding Downloads.ShowStatusColumn}" Margin="0,3"/>
                                        <CheckBox Content="Last Updated" IsChecked="{Binding Downloads.ShowLastUpdatedColumn}" Margin="0,3"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding Downloads.ClearCatalogFiltersCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Command="{Binding Downloads.DownloadAndExtractSelectedCommand}" Margin="8,0,0,0"
                                ToolTip="Downloads and imports every selected mod, one after another — Ctrl/Shift-click rows to select more than one"
                                Visibility="{Binding Downloads.HasCatalogSelectionForBatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="Download and extract selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Downloads.SelectedCatalogEntryCount, StringFormat='Download selected ({0})'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding Downloads.RefreshCatalogCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Refresh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource AccentForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,0,8,0">
                            <TextBox Text="{Binding Downloads.CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by name, author, or description"/>
                            <TextBlock Text="Search mods by name, author, or description…" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding Downloads.CatalogSearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </DockPanel>

                    <!-- WrapPanel, not a horizontal StackPanel — at a narrow window width this row has
                         more controls than fit on one line, and a StackPanel would just clip the
                         overflow off the right edge with no way to reach it; WrapPanel drops the
                         overflow onto a second line instead. -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Author:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding Downloads.AvailableAuthors}" SelectedItem="{Binding Downloads.SelectedAuthor}" Width="160"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding Downloads.AvailableCategories}" SelectedItem="{Binding Downloads.SelectedCategory}" Width="160"/>
                        </StackPanel>
                        <CheckBox Content="Show updates only" IsChecked="{Binding Downloads.ShowUpdatesOnly}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <CheckBox Content="Extracted only" IsChecked="{Binding Downloads.ExtractedOnly}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <CheckBox Content="Not downloaded only" IsChecked="{Binding Downloads.NotDownloadedOnly}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Game week:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox Text="{Binding Downloads.GameWeek, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0"/>
                        <CheckBox Content="Hide older weeks" IsChecked="{Binding Downloads.HideOlderWeeks}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12">
                            <Run Text="{Binding Downloads.CatalogShownCount, Mode=OneWay}"/><Run Text=" shown / "/><Run Text="{Binding Downloads.CatalogTotalCount, Mode=OneWay}"/><Run Text=" in catalog"/>
                        </TextBlock>
                        <TextBlock Text=" — loading…" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                   Visibility="{Binding Downloads.IsLoadingCatalog, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" x:Name="CatalogGrid" ItemsSource="{Binding Downloads.CatalogEntries}" SelectedItem="{Binding Downloads.SelectedCatalogEntry}"
                                  SelectionChanged="CatalogGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Fixed pixel widths on every column, not Star ("*"): a Star column
                                     always redistributes space among its sibling Star columns on any
                                     resize, so dragging one wider steals width from the others instead
                                     of growing the grid's total content width — which is also why no
                                     horizontal scrollbar could ever appear. Fixed widths let content
                                     genuinely overflow the viewport, so resizing one column no longer
                                     crunches the rest; the DataGrid's default ControlTemplate already
                                     shows a horizontal scrollbar (HorizontalScrollBarVisibility="Auto"
                                     is its own built-in default) once that happens. -->
                                <DataGridTextColumn Header="Mod Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"
                                                     Visibility="{Binding Data.ShowAuthorColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"
                                                     Visibility="{Binding Data.ShowVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Inst.Ver" Binding="{Binding InstalledVersion}" Width="70"
                                                     Visibility="{Binding Data.ShowInstalledVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Compat." Binding="{Binding CompatibilityDisplay}" Width="70"
                                                     Visibility="{Binding Data.ShowCompatibilityColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="150"
                                                     Visibility="{Binding Data.ShowCategoryColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTemplateColumn Header="Status" Width="90"
                                                         Visibility="{Binding Data.ShowStatusColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Phase 10: a small semantic badge instead of plain text — same
                                                 pill treatment Merge & Install's conflict badge uses. -->
                                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdatedDisplay}" Width="90"
                                                     Visibility="{Binding Data.ShowLastUpdatedColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Select a mod to see its details and download it."
                                       Style="{StaticResource PageBodyTextStyle}" Margin="0,8,0,0"
                                       Visibility="{Binding Downloads.SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <StackPanel Grid.Row="0" Visibility="{Binding Downloads.SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border Height="120" Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Downloads.SelectedCatalogEntry.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding Downloads.SelectedCatalogEntry.Author, Mode=OneWay}"/>
                                    <Run Text=" · v"/>
                                    <Run Text="{Binding Downloads.SelectedCatalogEntry.Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Downloads.SelectedCatalogEntry.Entry.Description}" Style="{StaticResource PageBodyTextStyle}" MaxWidth="260" Margin="0,0,0,12"/>
                                <Button Command="{Binding Downloads.DownloadAndExtractCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                                        IsEnabled="{Binding Downloads.SelectedCatalogEntry.HasDownloadableFile}"
                                        AutomationProperties.Name="Download and extract">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Download &amp; extract" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding Downloads.OpenCatalogReadmeCommand}" AutomationProperties.Name="Open readme">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Open readme" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding Downloads.CatalogStatusMessage}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                    Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
    </Grid>
</UserControl>
