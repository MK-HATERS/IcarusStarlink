<UserControl x:Class="IcarusStarlink.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
             mc:Ignorable="d">

    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:LibraryGroupViewModel}" ItemsSource="{Binding Items}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count, StringFormat=' ({0} options)'}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.ContextMenu>
                    <!-- Right-clicking selects the row first (see code-behind), so Pin/Favorite here apply to
                         the same mod the detail pane is about to show. Notes doesn't need its own entry —
                         the same right-click already surfaces the Notes box in the detail pane below. -->
                    <ContextMenu>
                        <MenuItem Header="Pinned" IsCheckable="True" IsChecked="{Binding IsPinned}"/>
                        <MenuItem Header="Favorite" IsCheckable="True" IsChecked="{Binding IsFavorite}"/>
                        <Separator/>
                        <MenuItem Header="Open on Nexus" IsEnabled="False"
                                  ToolTip="Available once Downloads links mods to their Nexus page (Phase 4)."
                                  ToolTipService.ShowOnDisabled="True"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="📌" Margin="0,0,4,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="★" Margin="0,0,4,0" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="✎" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           ToolTip="Locally edited in the EXMOD editor"
                           Visibility="{Binding IsLocallyEdited, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="📦" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           ToolTip="A rebuilt merged pack, re-imported as its own mod"
                           Visibility="{Binding IsMergedPack, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding VariantLabel, StringFormat=' — {0}'}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Visibility="{Binding VariantLabel, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="EXMOD library">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                                ToolTip="Re-scan Extracted_Mods from disk"/>
                        <Button Content="New mod…" Command="{Binding NewModCommand}" Margin="0,0,8,0"
                                ToolTip="Create a blank EXMOD (name + author) and open it in the editor"/>
                        <Button Content="Import EXMODZ…" Command="{Binding ImportFileCommand}" Margin="0,0,8,0"/>
                        <Button Content="Import Folder…" Command="{Binding ImportFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Import .pak…" Command="{Binding ImportPakCommand}"
                                ToolTip="Import a prebuilt .pak as an opaque library entry — no .EXMOD, can't be browsed or edited"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, author, notes, or mod file/item contents"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding ModCount, Mode=OneWay}"/><Run Text=" mod(s) · "/><Run Text="{Binding GroupCount, Mode=OneWay}"/><Run Text=" group(s)"/>
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <TreeView x:Name="LibraryTree" ItemsSource="{Binding RootItems}" Background="Transparent" BorderThickness="0"
                                      SelectedItemChanged="LibraryTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="LibraryTree_PreviewMouseRightButtonDown"/>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedItem.Name}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="{Binding SelectedItem.Author, Mode=OneWay}"/>
                                        <Run Text=" · v"/>
                                        <Run Text="{Binding SelectedItem.Version, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedItem.Description}" Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <CheckBox Content="Pinned" IsChecked="{Binding SelectedItem.IsPinned}" Margin="0,0,16,0"/>
                                        <CheckBox Content="Favorite" IsChecked="{Binding SelectedItem.IsFavorite}" Margin="0,0,16,0"/>
                                        <Button Content="Edit…" Command="{Binding EditSelectedCommand}" Margin="0,0,8,0"
                                                ToolTip="Open this mod's Item fields in the EXMOD editor"/>
                                        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"/>
                                    </StackPanel>

                                    <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding SelectedItem.Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

                                    <TabControl>
                                        <TabItem Header="Changes"
                                                 ToolTip="What this mod actually changes — read-only. For editing, see the EXMOD editor (planned).">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8" Height="200">
                                                <TextBox Text="{Binding SelectedItem.ChangesContent, Mode=OneWay}"
                                                         IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                         AcceptsReturn="True" BorderThickness="0" Padding="8"/>
                                            </Border>
                                        </TabItem>
                                        <TabItem Header="Files">
                                            <Grid Margin="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ListBox Grid.Column="0" ItemsSource="{Binding SelectedItem.AssetPaths}"
                                                         SelectedItem="{Binding SelectedItem.SelectedAssetPath}" Height="200"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedItem.SelectedAssetPreview, Mode=OneWay}"
                                                         Margin="8,0,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                         AcceptsReturn="True" Height="200"/>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Readme">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8" Height="200">
                                                <FlowDocumentScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                                                    Document="{Binding SelectedItem.ReadmeContent, Mode=OneWay, Converter={StaticResource MarkdownToFlowDocumentConverter}}"/>
                                            </Border>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>

                                <!-- Real EXMOD readmes conventionally carry an "ImageOnly" asset — see LibraryItemViewModel.LoadThumbnailIfPresent. -->
                                <Border Grid.Column="1" Width="120" Height="120" Margin="12,0,0,0" VerticalAlignment="Top"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        Visibility="{Binding SelectedItem.ThumbnailImage, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Image Source="{Binding SelectedItem.ThumbnailImage}" Stretch="Uniform" Margin="4"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="0" Text="Select a mod on the left to see details."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="UE4SS mods">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Mods already installed in your game's UE4SS Mods folder — read-only."
                                   Style="{StaticResource PageBodyTextStyle}" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Command="{Binding ReloadInstalledUe4ssModsCommand}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Ue4ssStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="12" Margin="0,4,0,8"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding InstalledUe4ssMods}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                    Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
    </Grid>
</UserControl>
