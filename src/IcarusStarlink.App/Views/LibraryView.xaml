<UserControl x:Class="IcarusStarlink.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Grey at low opacity: a faint stripe on the dark and the light themes alike. -->
        <SolidColorBrush x:Key="LibraryRowStripeBrush" Color="#14808080"/>

        <!-- Each panel's Name width and the empty column before the row buttons. A shared-size
             column can't be star-sized, so code-behind (UpdateColumnWidths) sets them from the
             panel's width: Name grows up to a cap, the rest goes to the empty column, so the other
             columns stay next to the name. Starting values before the first layout. -->
        <sys:Double x:Key="LibraryNameColumnWidth">220</sys:Double>
        <sys:Double x:Key="LibraryFillWidth">0</sys:Double>
        <sys:Double x:Key="Ue4ssNameColumnWidth">200</sys:Double>
        <sys:Double x:Key="Ue4ssFillWidth">0</sys:Double>

        <!-- A filter chip above the panels: outlined, filled in the accent while it's on; "Not in game
             yet" and "Problems" take their colour while they have something to show. -->
        <Style x:Key="LibraryFilterChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Height="28" Padding="11,0" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="accent"/>
                        <Condition Binding="{Binding HasCount}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="danger"/>
                        <Condition Binding="{Binding HasCount}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:LibraryGroupViewModel}" ItemsSource="{Binding Items}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count, StringFormat=' ({0} options)'}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- A download in progress — not a real mod yet, so no context menu/selection/detail pane,
             just a name and a spinner. Disappears on its own once the download finishes (success
             blends into a real row above via the normal LibraryChangedMessage reload; failure just
             removes the stub with nothing left behind). -->
        <DataTemplate DataType="{x:Type vm:DownloadStubViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2" IsHitTestVisible="False">
                <Path Style="{StaticResource SpinnerIconStyle}" Width="12" Height="12" Margin="0,0,7,0"/>
                <TextBlock FontStyle="Italic" Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text=" — downloading…"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Phase 10 redesign: real icons replace the raw emoji markers, and hovering a row
             reveals inline Pin/Favorite/Edit actions (RowActions, opacity 0→1 on IsMouseOver)
             instead of only the detail pane or the right-click menu below. -->
        <!-- A UE4SS (Lua) mod as a row in the SAME list as pak/EXMOD mods (the separate UE4SS tab is
             gone). Same SharedSizeGroup columns as the LibraryItemViewModel template below, so the
             columns line up; the "On" checkbox is the mod's pending enabled state (Apply moves it);
             Type says UE4SS; Status says In game / Needs Apply / Not enabled. A Lua mod that is the
             Lua half of a Mods-tab row (same download) is never listed here — see
             LibraryViewModel.Reload. -->
        <!-- A UE4SS (Lua) mod in the right-hand panel. Its own columns (no Type or Author: every row
             is a UE4SS mod, and they name no author); the "On" box is its pending state (Apply moves
             it). A mod's other half in the data panel (MkHatersBags / MkHaters Bags) lights up with it. -->
        <DataTemplate DataType="{x:Type vm:Ue4ssModRowViewModel}">
            <Grid x:Name="Row" Margin="0,3" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave">
                <Grid.Style>
                    <!-- Faint stripes, the row under the mouse lit, the row's other half (in the
                         other panel) lit in the accent while either is hovered; selection wins. -->
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="1">
                                <Setter Property="Background" Value="{StaticResource LibraryRowStripeBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLinkHighlighted}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelectedForBulk}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="6" SharedSizeGroup="ColCheckbox"/>
                    <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="ColEnabled"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColIcons"/>
                    <ColumnDefinition Width="Auto" MinWidth="{DynamicResource Ue4ssNameColumnWidth}" MaxWidth="{DynamicResource Ue4ssNameColumnWidth}" SharedSizeGroup="ColName"/>
                    <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="ColVersion"/>
                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="ColSource"/>
                    <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="ColStatus"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColLatest"/>
                    <ColumnDefinition Width="Auto" MinWidth="{DynamicResource Ue4ssFillWidth}" SharedSizeGroup="ColFill"/>
                    <ColumnDefinition Width="Auto" MinWidth="84" SharedSizeGroup="ColActions"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select all"
                                  Command="{Binding PlacementTarget.Tag.SelectAllForBulkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="Selects every mod currently shown, so one ON tick turns them all on or off"/>
                        <Separator/>
                        <MenuItem Header="Open folder"
                                  Command="{Binding PlacementTarget.Tag.OpenUe4ssModFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Opens this mod's folder — in the game's Mods folder when enabled, in this app's staging when disabled"/>
                        <MenuItem Header="Edit config…"
                                  Command="{Binding PlacementTarget.Tag.EditUe4ssModConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding HasConfig, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ToolTip="Change this mod's settings (its config file) for your game, and on your servers too if you like"/>
                        <Separator/>
                        <!-- Built-in UE4SS mods have no Nexus page and come back with UE4SS, so these
                             are greyed out for them (not hidden, which left the menu as two stray
                             separators). -->
                        <MenuItem Header="Open on Nexus" Command="{Binding OpenOnNexusCommand}" IsEnabled="{Binding HasNexusLink}"
                                  ToolTip="Open this mod's Nexus page in your browser. Greyed out: this mod isn't linked to Nexus." ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="{Binding NexusLinkActionLabel}"
                                  Command="{Binding PlacementTarget.Tag.LinkUe4ssModToNexusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding IsUserAdded}"
                                  ToolTip="Connect this mod to a real Nexus mod ID so it can be checked for updates. Greyed out: one of UE4SS's own built-in mods."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Set minimum UE4SS version…"
                                  Command="{Binding PlacementTarget.Tag.SetMinUe4ssVersionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding IsUserAdded}"
                                  ToolTip="Declare the minimum UE4SS loader version this mod needs, so this app can warn you if your installed loader is older. Greyed out: one of UE4SS's own built-in mods."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <Separator/>
                        <MenuItem Header="Delete"
                                  Command="{Binding PlacementTarget.Tag.DeleteUe4ssModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding IsUserAdded}"
                                  ToolTip="Removes this mod from the game's Mods folder (backed up first) and from staging — asks first. Greyed out: one of UE4SS's own built-in mods, which can only be turned off."
                                  ToolTipService.ShowOnDisabled="True"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <!-- A faint line under every row. -->
                <Border Grid.ColumnSpan="10" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-3" IsHitTestVisible="False"
                        Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Border Grid.ColumnSpan="10" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                        Visibility="{Binding IsLinkHighlighted, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0" IsChecked="{Binding IsEnabled}" Click="EnabledCheckbox_Click"
                          ToolTip="On = UE4SS starts it in the game. Changes apply when you click Apply under this list. With several rows selected, ticking one ticks them all."
                          AutomationProperties.Name="{Binding Name, StringFormat='Enable {0}'}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"
                          Margin="0,0,5,0" VerticalAlignment="Center"
                          Visibility="{Binding HasVersionWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                          ToolTip="{Binding VersionWarningTooltip}"/>
                </StackPanel>

                <!-- One line per row: the Nexus title and version the second line used to show are in the tooltip. -->
                <Grid Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding NexusSummary}" Width="{DynamicResource Ue4ssNameColumnWidth}" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                            Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            ToolTip="Ships with the UE4SS loader itself — not something you installed separately"
                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Default" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </Border>
                    <Border x:Name="LinkPill" Grid.Column="2" Margin="8,0,0,0" CornerRadius="8" Padding="7,1" VerticalAlignment="Center" Opacity="0"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" IsHitTestVisible="False"
                                Visibility="{Binding HasLinkedPartner, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource AccentBrush}"><Run Text="↔ "/><Run Text="{Binding LinkedPartner.Name, Mode=OneWay}"/></TextBlock>
                        </Border>
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding VersionText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0"
                           ToolTip="From the mod's own Scripts\main.lua when it states one, else the version it was downloaded at"
                           Visibility="{Binding DataContext.ShowVersionColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Border Grid.Column="5" Visibility="{Binding DataContext.ShowSourceColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Margin="8,0,0,0" CornerRadius="8" Padding="7,2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource InfoBrush}"
                            ToolTip="Linked to a Nexus mod page for update-checking"
                            Visibility="{Binding HasNexusLink, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Nexus" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                    </Border>
                </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowStatusColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding InstallStatus}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding InstallStatusDetail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInGame}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedsAction}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    </TextBlock>
                    <Border Margin="6,0,0,0" CornerRadius="8" Padding="7,2" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}">
                            <Run Text="Update v"/><Run Text="{Binding LatestVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="7" Text="{Binding LatestVersion}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowLatestColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- The same buttons on every row: endorse (Nexus mods), edit config (when it has one), more. -->
                <StackPanel x:Name="RowActions" Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.45">
                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0"
                            Command="{Binding DataContext.EndorseUe4ssModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding HasNexusLink, Converter={StaticResource BoolToHiddenConverter}}"
                            AutomationProperties.Name="Endorse on Nexus">
                        <Button.ToolTip>
                            <TextBlock><Run Text="{Binding EndorsementStatusDisplay, Mode=OneWay}"/><Run Text=" on Nexus — click to endorse"/></TextBlock>
                        </Button.ToolTip>
                        <Path Data="{StaticResource IconThumbsUp}" StrokeThickness="1.2" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEndorsed}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0" ToolTip="Edit config…" AutomationProperties.Name="Edit config"
                            Command="{Binding DataContext.EditUe4ssModConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding HasConfig, Converter={StaticResource BoolToHiddenConverter}}">
                        <Path Data="M4,6 H14 M18,6 H20 M4,12 H8 M12,12 H20 M4,18 H16 M14,6 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M8,12 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"
                              Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0" Click="RowMoreButton_Click"
                            ToolTip="More actions (the same as right-clicking the row)" AutomationProperties.Name="More actions">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource SecondaryForegroundBrush}"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource SecondaryForegroundBrush}" Margin="2.5,0"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- The row buttons sit faint until the row is hovered or selected (so every row looks
                     the same and nothing jumps in); the link pill shows while either half is hovered. -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                    <Setter TargetName="LinkPill" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelectedForBulk}" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLinkHighlighted}" Value="True">
                    <Setter TargetName="LinkPill" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!-- A pak/EXMOD mod in the left-hand panel. Name, its marks and the columns sit together (the
             spare width goes to an empty column before the row buttons, see LibraryView.UpdateColumnWidths);
             one line per row ("made for an older game" is in the name's tooltip). -->
        <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <Grid x:Name="Row" Margin="0,3" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave">
                <Grid.Style>
                    <!-- Faint stripes, the row under the mouse lit, the row's other half (in the
                         other panel) lit in the accent while either is hovered; selection wins. -->
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="1">
                                <Setter Property="Background" Value="{StaticResource LibraryRowStripeBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLinkHighlighted}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelectedForBulk}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="6" SharedSizeGroup="ColCheckbox"/>
                    <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="ColEnabled"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColIcons"/>
                    <ColumnDefinition Width="Auto" MinWidth="{DynamicResource LibraryNameColumnWidth}" MaxWidth="{DynamicResource LibraryNameColumnWidth}" SharedSizeGroup="ColName"/>
                    <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="ColType"/>
                    <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="ColAuthor"/>
                    <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="ColVersion"/>
                    <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColSource"/>
                    <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="ColStatus"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColLatest"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColImported"/>
                    <ColumnDefinition Width="Auto" MinWidth="{DynamicResource LibraryFillWidth}" SharedSizeGroup="ColFill"/>
                    <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="ColActions"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <!-- Right-clicking selects the row first (see code-behind), so Pin/Favorite here apply to
                         the same mod the detail pane is about to show. Notes doesn't need its own entry —
                         the same right-click already surfaces the Notes box in the detail pane below.
                         A ContextMenu is its own top-level Popup, not part of this Grid's visual tree, so a
                         plain RelativeSource AncestorType=UserControl lookup from inside it finds nothing —
                         confirmed the hard way earlier this session with the same shape of bug (a
                         VisualBrush.Visual binding that silently resolved to nothing). Row's own Tag above
                         relays the page VM across that boundary: PlacementTarget (a real property WPF sets
                         to whatever opened the menu, so it stays inside the real visual tree) exposes that
                         Tag back to the MenuItem below. -->
                    <ContextMenu>
                        <MenuItem Header="Select all"
                                  Command="{Binding PlacementTarget.Tag.SelectAllForBulkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="Selects every mod currently shown (respects the search box), ready for a bulk action below"/>
                        <Separator/>
                        <MenuItem Header="Pinned" IsCheckable="True" IsChecked="{Binding IsPinned}"/>
                        <MenuItem Header="Favorite" IsCheckable="True" IsChecked="{Binding IsFavorite}"/>
                        <Separator/>
                        <MenuItem Header="Rename…"
                                  Command="{Binding PlacementTarget.Tag.RenameItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Change how this mod displays in Library — its real folder/files aren't touched"/>
                        <MenuItem Header="Edit config…"
                                  Command="{Binding PlacementTarget.Tag.EditLinkedUe4ssConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding HasLuaConfig, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ToolTip="Change the settings of this mod's UE4SS part (its config file) for your game, and on your servers too if you like"/>
                        <MenuItem Header="Check against the game &amp; fix…"
                                  Command="{Binding PlacementTarget.Tag.OpenModFixCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding CanEdit}"
                                  ToolTip="Compares this mod with the current game: old copies of game data (from a mod made for an older version), rows both the mod and the game changed, and renamed rows. Shows each with a fix to choose. Greyed out: a prebuilt pak (make it editable first)."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Convert to EXMOD…"
                                  Command="{Binding PlacementTarget.Tag.ConvertToExmodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding IsOpaquePak}"
                                  ToolTip="Turns this prebuilt .pak import into a real, editable mod by diffing its own data against the current game data — backs up the original first. Greyed out: this mod is already editable."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <Separator/>
                        <MenuItem Header="Create mod backup"
                                  Command="{Binding PlacementTarget.Tag.BackupModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Snapshots this mod's whole folder — a safety net before a risky manual edit"/>
                        <MenuItem Header="Restore latest backup"
                                  Command="{Binding PlacementTarget.Tag.RestoreModBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding HasModBackup}"
                                  ToolTip="Replaces this mod's current content with its most recent backup. Greyed out: no backup yet (Create mod backup, or an update, makes one)."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Reinstall original"
                                  Command="{Binding PlacementTarget.Tag.ReinstallOriginalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Imports the mod again from the download ISL kept, exactly as its author made it. Fixes and edits made since are dropped (backed up first)."/>
                        <MenuItem Header="See what changed vs previous version…"
                                  Command="{Binding PlacementTarget.Tag.CompareToPreviousVersionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding HasModBackup}"
                                  ToolTip="Shows exactly which values and files the author changed between your previous copy and the current one — read-only, nothing is restored. Greyed out: no previous copy kept yet."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Find in Database"
                                  Command="{Binding PlacementTarget.Tag.FindInDatabaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Search the community mod database for this mod by name"/>
                        <MenuItem Header="Search Nexus for this"
                                  Command="{Binding PlacementTarget.Tag.SearchNexusForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Search Nexus for this mod by name — useful when it has no Nexus link yet"/>
                        <MenuItem Header="Open on Nexus" Command="{Binding OpenOnNexusCommand}" IsEnabled="{Binding HasNexusLink}"
                                  ToolTip="Open this mod's Nexus page in your browser. Greyed out: this mod isn't linked to Nexus."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="{Binding NexusLinkActionLabel}"
                                  Command="{Binding PlacementTarget.Tag.LinkToNexusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Connect this mod to a real Nexus mod ID so it can be checked for updates"/>
                        <MenuItem Header="Endorse" Command="{Binding EndorseCommand}"
                                  ToolTip="Endorses this mod on Nexus, on your account's behalf. Greyed out: not linked to Nexus, or already endorsed."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="Don't endorse (stop asking)" Command="{Binding AbstainCommand}"
                                  ToolTip="Tells Nexus you've decided not to endorse this mod, so you aren't asked again (Nexus calls this &quot;abstain&quot;). Greyed out: not linked to Nexus, or already set."
                                  ToolTipService.ShowOnDisabled="True"/>
                        <Separator/>
                        <MenuItem Header="Delete"
                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Removes the selected mod(s)' folders from your Library — asks first (naming how many), can't be undone without a backup"/>
                        <MenuItem Header="Delete all…"
                                  Command="{Binding PlacementTarget.Tag.DeleteAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="Removes every mod in your Library, regardless of what's selected — asks first (naming the real count), can't be undone without a backup"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <!-- A faint line under every row. -->
                <Border Grid.ColumnSpan="13" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-3" IsHitTestVisible="False"
                        Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Border Grid.ColumnSpan="13" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                        Visibility="{Binding IsLinkHighlighted, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0" IsChecked="{Binding IsEnabled}" Click="EnabledCheckbox_Click"
                          ToolTip="On = goes into the game on the next Merge &amp; Install (it's in the merge queue). Off = left out. With several rows selected, ticking one ticks them all."
                          AutomationProperties.Name="{Binding Name, StringFormat='Enable {0}'}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Path Data="{StaticResource IconPin}" Fill="{DynamicResource AccentBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                          ToolTip="Pinned to the top (right-click › Pinned)"
                          Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                          ToolTip="Changed in the mod editor"
                          Visibility="{Binding IsLocallyEdited, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Path Data="{StaticResource IconWrench}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                          ToolTip="{Binding FixedByIslToolTip}" AutomationProperties.Name="Fixed by ISL"
                          Visibility="{Binding IsFixedByIsl, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Path Data="{StaticResource IconPackage}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                          ToolTip="A rebuilt merged pak, re-imported as its own mod"
                          Visibility="{Binding IsMergedPack, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Set by "Check mods against game data": clickable, it opens the fix window. -->
                    <Button Style="{StaticResource IconButtonStyle}" Width="14" Height="14" Padding="0" Margin="0,0,5,0"
                            Command="{Binding DataContext.OpenModFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Doesn't fully fit the current game"
                            ToolTip="{Binding ModIssuesTooltip}"
                            Visibility="{Binding HasModIssues, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Name, then the risk pill and the link pill right beside it (not across the row). Its
                     width is the column's, so a long name shortens with "…" before a pill is cut. -->
                <Grid Grid.Column="3" VerticalAlignment="Center" Width="{DynamicResource LibraryNameColumnWidth}" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip Visibility="{Binding HasBuiltForText, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock MaxWidth="420" TextWrapping="Wrap"><Run Text="{Binding BuiltForText, Mode=OneWay}"/><Run Text=". Read from the game rows this mod carries: some were removed from the game after this. An older mod can still work; check it against the game to see what doesn't fit."/></TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                        <Run Text="{Binding Name}"/><Run Text="{Binding VariantLabel, Converter={StaticResource VariantSuffixConverter}}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </TextBlock>
                    <!-- The game files this mod replaces: High (the player character, a shared base) or Medium (one blueprint or screen). -->
                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                            ToolTip="{Binding FileRiskTooltip}" ToolTipService.ShowDuration="30000"
                            Visibility="{Binding HasFileRisk, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighFileRisk}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FileRiskLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                    </Border>
                    <Border x:Name="LinkPill" Grid.Column="2" Margin="8,0,0,0" CornerRadius="8" Padding="7,1" VerticalAlignment="Center" Opacity="0"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" IsHitTestVisible="False"
                                Visibility="{Binding HasLinkedPartner, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource AccentBrush}"><Run Text="↔ "/><Run Text="{Binding LinkedPartner.Name, Mode=OneWay}"/></TextBlock>
                        </Border>
                </Grid>

                <Border Grid.Column="4" CornerRadius="8" Padding="7,2" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Left"
                        Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.ToolTip>
                        <TextBlock Text="EXMOD: an editable data mod merged by Merge &amp; Install. Pak: a prebuilt pak folded in as-is. Pak + UE4SS: this download also ships Lua scripts, which enable together with it."/>
                    </Border.ToolTip>
                    <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>

                <TextBlock Grid.Column="5" Text="{Binding AuthorDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowAuthorColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Grid.Column="6" Text="{Binding VersionText}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowVersionColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Clickable: Nexus jumps to the mod's card on the Nexus page (by its mod ID),
                     Database to its row on the IMM Database tab. -->
                <Border Grid.Column="7" Visibility="{Binding DataContext.ShowSourceColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Background="{DynamicResource InfoBrush}" Margin="8,0,0,0"
                            CommandParameter="{Binding}"
                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="{Binding Source, StringFormat='Source: {0}'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                <Setter Property="Command" Value="{Binding DataContext.SearchNexusForCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Setter Property="ToolTip" Value="Find this mod's card on the Nexus page"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source}" Value="Database">
                                        <Setter Property="Command" Value="{Binding DataContext.FindInDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Setter Property="ToolTip" Value="Find this mod in the IMM Database tab"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Source}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                    </Button>
                </Border>

                <!-- Status, and the Update pill (a Database mod updates in place; a Nexus mod opens its card). -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowStatusColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding InstallStatus}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding InstallStatusDetail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInGame}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedsAction}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource PillButtonStyle}" Background="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                            Command="{Binding DataContext.GetUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding LatestVersion, StringFormat='Update available: v{0} — click to update'}"
                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="Get update">
                        <TextBlock Text="Update" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="9" Text="{Binding LatestVersion}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowLatestColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Grid.Column="10" Text="{Binding ImportedAtUtc.LocalDateTime, StringFormat='{}{0:d}'}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0" Visibility="{Binding DataContext.ShowImportedColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- The same buttons on every row: endorse (Nexus mods), favourite, edit, more. Pin,
                     delete and the rest are in more / right-click. -->
                <StackPanel x:Name="RowActions" Grid.Column="12" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.45">
                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0"
                            Command="{Binding EndorseCommand}"
                            Visibility="{Binding HasNexusLink, Converter={StaticResource BoolToHiddenConverter}}"
                            AutomationProperties.Name="Endorse on Nexus">
                        <Button.ToolTip>
                            <TextBlock><Run Text="{Binding EndorsementStatusDisplay, Mode=OneWay}"/><Run Text=" on Nexus — click to endorse"/></TextBlock>
                        </Button.ToolTip>
                        <Path Data="{StaticResource IconThumbsUp}" StrokeThickness="1.2" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEndorsed}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsFavorite}" Style="{StaticResource IconToggleButtonStyle}"
                                  ToolTip="Favourite" AutomationProperties.Name="Toggle favourite">
                        <Path Data="{StaticResource IconStar}" Width="12" Height="12" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="#FFD24C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" ToolTip="Open in mod editor" AutomationProperties.Name="Open in mod editor"
                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToHiddenConverter}}">
                        <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0" Click="RowMoreButton_Click"
                            ToolTip="More actions (the same as right-clicking the row)" AutomationProperties.Name="More actions">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource SecondaryForegroundBrush}"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource SecondaryForegroundBrush}" Margin="2.5,0"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- The row buttons sit faint until the row is hovered or selected (so every row looks
                     the same and nothing jumps in); the link pill shows while either half is hovered. -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                    <Setter TargetName="LinkPill" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelectedForBulk}" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLinkHighlighted}" Value="True">
                    <Setter TargetName="LinkPill" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid AllowDrop="True" DragOver="LibraryPage_DragOver" Drop="LibraryPage_Drop" PreviewKeyDown="LibraryPage_PreviewKeyDown" Background="Transparent">
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title and toolbar on one line. -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}" VerticalAlignment="Center" Margin="0,0,22,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}" Margin="0,0,10,0" ToolTip="Reload the mod list from disk" AutomationProperties.Name="Refresh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,4,10,4"/>

                        <Button Command="{Binding NewModCommand}" Margin="0,0,8,0" ToolTip="Make a new mod: new items (from a game item), quality-of-life rules, or a blank one. To change the game's own items, use the Editor page." AutomationProperties.Name="New mod">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="New mod…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="DropdownButton_Click" Margin="0,0,10,0" ToolTip="Bring a mod in from a file, a folder, or a prebuilt .pak" AutomationProperties.Name="Import">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="Import archive…" Command="{Binding ImportFileCommand}"
                                              ToolTip="A .zip/.rar/.7z/.EXMODZ — automatically recognized as an EXMOD-shaped mod, a bare .pak, or a UE4SS mod, whatever's actually inside"/>
                                    <MenuItem Header="Import folder…" Command="{Binding ImportFolderCommand}"
                                              ToolTip="An already-unpacked mod folder — recognized the same way as an archive (EXMOD, .pak or UE4SS mod). You can also drag folders or archives onto this page."/>
                                    <MenuItem Header="Import .pak…" Command="{Binding ImportPakCommand}"
                                              ToolTip="A prebuilt .pak — turned into an editable mod when it can be (needs UnrealPak.exe and game data), otherwise imported as it is"/>
                                    <MenuItem Header="Import UE4SS mod…" Command="{Binding ImportUe4ssModCommand}"
                                              ToolTip="A UE4SS (Lua) mod archive — lands in the list unticked; tick it and click Apply"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Import" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,4,10,4"/>

                        <Button Click="DropdownButton_Click" Margin="0,0,8,0"
                                ToolTip="Whole-library checks — these look at every mod, not just one, so they take longer than the actions above"
                                AutomationProperties.Name="Check">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <!-- Grouped by what they look at: mod updates, the game data, Nexus endorsements. -->
                                    <MenuItem Header="Check for updates" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanRunLibraryCheck}"
                                              ToolTip="Checks every Nexus- or Database-sourced mod against its current version. Greyed out: another library check is running." ToolTipService.ShowOnDisabled="True"/>
                                    <MenuItem Header="Update all" Command="{Binding UpdateAllCommand}" IsEnabled="{Binding CanRunLibraryCheck}"
                                              ToolTip="Updates every mod the last check found outdated — Database mods in place, Nexus mods listed on the Nexus page for one-click download. Greyed out: another library check is running." ToolTipService.ShowOnDisabled="True"/>
                                    <Separator/>
                                    <MenuItem Header="Check mods against game data" Command="{Binding CheckModsAgainstCurrentDataCommand}" IsEnabled="{Binding CanRunLibraryCheck}"
                                              ToolTip="Compares every editable mod with the current game data and flags what no longer fits (it only looks — fixes are made from the warning badge or Fix sure problems). Greyed out: another library check is running." ToolTipService.ShowOnDisabled="True"/>
                                    <MenuItem Header="Fix sure problems in every mod" Command="{Binding FixSureProblemsCommand}" IsEnabled="{Binding CanRunLibraryCheck}"
                                              ToolTip="After Check mods against game data: makes every sure fix in every flagged mod (old copies of game data, proven broken links and renames), each mod backed up first. What needs a look stays flagged. Greyed out: another library check is running." ToolTipService.ShowOnDisabled="True"/>
                                    <MenuItem Header="Make prebuilt paks editable…" Command="{Binding ConvertAllOpaqueModsCommand}" IsEnabled="{Binding CanRunLibraryCheck}"
                                              ToolTip="Tries again to turn every prebuilt .pak mod into an editable mod — useful right after setting up UnrealPak.exe (it also runs by itself after every Refresh game data). Greyed out: another library check is running." ToolTipService.ShowOnDisabled="True"/>
                                    <MenuItem Header="What the last game update changed…" Command="{Binding ShowLastGameUpdateCommand}"
                                              ToolTip="What the last Update everything fixed, what still needs a look, and which mods replace game files the update changed. Roll back is there too."/>
                                    <Separator/>
                                    <MenuItem Header="Check endorsements" Command="{Binding CheckEndorsementsCommand}" IsEnabled="{Binding CanRunLibraryCheck}"
                                              ToolTip="Fetches your Nexus endorsement history and shows which of your Nexus-linked mods you haven't endorsed yet. Greyed out: another library check is running." ToolTipService.ShowOnDisabled="True"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Check" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                </StackPanel>
            </WrapPanel>

            <!-- One line: search and the filter chips (each with its count). -->
            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                <Grid DockPanel.Dock="Left" Width="320" Margin="0,0,10,6" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="24,0,0,0"
                             ToolTip="Search by name, author, notes, or mod file/item contents (Ctrl+F)" AutomationProperties.Name="Search your library"/>
                    <Path Data="M10,3 a7,7 0 1 0 0.01,0 M15,15 L21,21" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search your library  (Ctrl+F)" Style="{StaticResource PlaceholderTextStyle}" Margin="28,0,0,0"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding FilterChips}" VerticalAlignment="Center" Margin="0,0,0,6" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                    Style="{StaticResource LibraryFilterChipStyle}" Margin="0,0,6,0" AutomationProperties.Name="{Binding Label}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}"/>
                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <StackPanel Grid.Row="2">
                        <!-- The results of the Check ▾ menu's whole-library checks, in one section the
                             user can fold away (three result lines used to stack up here and push the
                             list down). A new result opens it again; Clear empties it. -->
                        <Expander Margin="0,6,0,0" IsExpanded="{Binding IsCheckResultsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="Check results"
                                  Visibility="{Binding HasCheckResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Check results" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CheckResultsSummary}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCheckResultsCommand}" VerticalAlignment="Top" Margin="8,0,0,0"
                                        ToolTip="Hide these results (the badges on the mods stay)" AutomationProperties.Name="Clear check results"/>
                                <StackPanel>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding UpdateCheckStatusMessage}"
                                               Visibility="{Binding UpdateCheckStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding StalenessCheckStatusMessage}"
                                               Visibility="{Binding StalenessCheckStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding EndorsementCheckStatusMessage}"
                                               Visibility="{Binding EndorsementCheckStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Expander>
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                   Text="{Binding UnreadableFoldersMessage}"
                                   Visibility="{Binding UnreadableFoldersMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>

            <!-- The two panels: side by side, or one above the other in a narrow window
                 (LibraryView.ArrangePanels). The splitter's place is remembered. -->
            <Grid x:Name="PanelsGrid" Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DataColumn" Width="62*" MinWidth="320"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="14"/>
                    <ColumnDefinition x:Name="Ue4ssColumn" Width="38*" MinWidth="280"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DataRow" Height="*"/>
                    <RowDefinition x:Name="SplitterRow" Height="0"/>
                    <RowDefinition x:Name="Ue4ssRow" Height="0"/>
                </Grid.RowDefinitions>
                <!-- LEFT: data mods (EXMOD and pak) — Merge & Install puts them in the game. Each panel is its
                     own shared-size scope, so its header and rows line up on their own. -->
                <Border x:Name="DataPanel" Grid.Column="0" Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,8"
                                    ToolTip="Click to select, Ctrl-click to add, Shift-click for a range. Double-click for details, right-click for more.">
                            <TextBlock Text="DATA MODS" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Run Text="{Binding DataShownCount, Mode=OneWay}"/><Run Text=" · EXMOD and pak mods — Merge &amp; Install puts them in the game"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- What the selected mods in this panel can do (Ctrl/Shift-click to select). -->
                        <Border Grid.Row="1" Margin="10,0,10,8" Padding="12,4,6,4" CornerRadius="6" Background="{DynamicResource NavItemSelectedBrush}"
                                Visibility="{Binding HasDataSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0"
                                        Command="{Binding ClearSelectionCommand}" ToolTip="Clear the selection (Esc)" AutomationProperties.Name="Clear selection">
                                    <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Text="Space on/off · Del delete · Enter details" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0"><Run Text="{Binding DataSelectedCount, Mode=OneWay}"/><Run Text=" selected"/></TextBlock>
                                    <Button Content="Turn on" Command="{Binding TurnOnSelectedCommand}" CommandParameter="data" Padding="10,2" Margin="0,0,6,0"/>
                                    <Button Content="Turn off" Command="{Binding TurnOffSelectedCommand}" CommandParameter="data" Padding="10,2" Margin="0,0,6,0"/>
                                    <Button Content="Delete" Command="{Binding DeleteItemCommand}" Padding="10,2" Margin="0,0,6,0" Foreground="{DynamicResource DangerBrush}"
                                            ToolTip="Removes the selected mods from your Library — asks first"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="DataHeaderGrid" Grid.Row="2" Margin="4,0,4,4">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Author" IsCheckable="True" IsChecked="{Binding ShowAuthorColumn}"/>
                                    <MenuItem Header="Version" IsCheckable="True" IsChecked="{Binding ShowVersionColumn}"/>
                                    <MenuItem Header="Source" IsCheckable="True" IsChecked="{Binding ShowSourceColumn}"/>
                                    <MenuItem Header="Status" IsCheckable="True" IsChecked="{Binding ShowStatusColumn}"/>
                                    <MenuItem Header="Latest" IsCheckable="True" IsChecked="{Binding ShowLatestColumn}"
                                              ToolTip="The version last seen on Nexus/the Database, even when you're already up to date"/>
                                    <MenuItem Header="Imported" IsCheckable="True" IsChecked="{Binding ShowImportedColumn}"
                                              ToolTip="When this mod was added to your Library"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="6" SharedSizeGroup="ColCheckbox"/>
                                <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="ColEnabled"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColIcons"/>
                                <ColumnDefinition Width="Auto" MinWidth="{DynamicResource LibraryNameColumnWidth}" MaxWidth="{DynamicResource LibraryNameColumnWidth}" SharedSizeGroup="ColName"/>
                                <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="ColType"/>
                                <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="ColAuthor"/>
                                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="ColVersion"/>
                                <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColSource"/>
                                <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="ColStatus"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColLatest"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColImported"/>
                                <ColumnDefinition Width="Auto" MinWidth="{DynamicResource LibraryFillWidth}" SharedSizeGroup="ColFill"/>
                                <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="ColActions"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="ON" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Margin="0,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByColumnCommand}" CommandParameter="Name"
                                    ToolTip="Sort by name" AutomationProperties.Name="Sort by name">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NAME" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="4,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortIndicatorConverter}" ConverterParameter="Name">
                                                <Binding Path="SortColumn"/>
                                                <Binding Path="SortDescending"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="4" Text="TYPE" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButtonStyle}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByColumnCommand}" CommandParameter="Author"
                                    ToolTip="Sort by author" AutomationProperties.Name="Sort by author"
                                    Visibility="{Binding ShowAuthorColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AUTHOR" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="4,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortIndicatorConverter}" ConverterParameter="Author">
                                                <Binding Path="SortColumn"/>
                                                <Binding Path="SortDescending"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButtonStyle}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByColumnCommand}" CommandParameter="Version"
                                    ToolTip="Sort by version" AutomationProperties.Name="Sort by version"
                                    Visibility="{Binding ShowVersionColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="VERSION" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="4,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortIndicatorConverter}" ConverterParameter="Version">
                                                <Binding Path="SortColumn"/>
                                                <Binding Path="SortDescending"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="7" Style="{StaticResource ColumnHeaderButtonStyle}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByColumnCommand}" CommandParameter="Source"
                                    ToolTip="Sort by source" AutomationProperties.Name="Sort by source"
                                    Visibility="{Binding ShowSourceColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SOURCE" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="4,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortIndicatorConverter}" ConverterParameter="Source">
                                                <Binding Path="SortColumn"/>
                                                <Binding Path="SortDescending"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="8" Text="STATUS" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowStatusColumn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="9" Text="LATEST" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowLatestColumn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Grid.Column="10" Style="{StaticResource ColumnHeaderButtonStyle}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByColumnCommand}" CommandParameter="Imported"
                                    ToolTip="Sort by imported" AutomationProperties.Name="Sort by imported"
                                    Visibility="{Binding ShowImportedColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="IMPORTED" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="4,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortIndicatorConverter}" ConverterParameter="Imported">
                                                <Binding Path="SortColumn"/>
                                                <Binding Path="SortDescending"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="3">
                            <TreeView x:Name="LibraryTree" ItemsSource="{Binding DataRootItems}" Background="Transparent" BorderThickness="0" AlternationCount="2"
                                      HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource BorderBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectedItemChanged="LibraryTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="LibraryTree_PreviewMouseRightButtonDown"
                                      PreviewMouseLeftButtonDown="LibraryTree_PreviewMouseLeftButtonDown"
                                      MouseDoubleClick="LibraryTree_MouseDoubleClick"/>
                            <TextBlock Text="No data mods match." Margin="16,14" FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"
                                       IsHitTestVisible="False" Visibility="{Binding IsDataPanelEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <!-- What isn't in the game yet from this panel, and the one action that puts it there. -->
                        <Border Grid.Row="4" Padding="12,8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CardRaisedBackgroundBrush}"
                                Visibility="{Binding HasPendingPakChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Merge &amp; Install →" Command="{Binding GoToMergeInstallCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                                        ToolTip="Opens Merge &amp; Install, where the ticked mods are built into the game's merged pak"/>
                                <TextBlock Text="NOT IN GAME YET" Style="{StaticResource FieldLabelStyle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PendingDataText}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding PendingDataText}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Grid.Row="0" Width="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="PanelSplitter_DragCompleted"
                              ToolTip="Drag to give either panel more room" AutomationProperties.Name="Resize the panels">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Border x:Name="Grip" Width="4" Height="44" CornerRadius="2" Background="{DynamicResource BorderBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- RIGHT: UE4SS mods — Apply turns them on or off. -->
                <Border x:Name="Ue4ssPanel" Grid.Column="2" Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="14,10,14,8">
                            <CheckBox DockPanel.Dock="Right" Content="{Binding ShowUe4ssBuiltInsLabel}" IsChecked="{Binding ShowUe4ssBuiltIns}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"
                                      ToolTip="The mods that come with UE4SS itself (BPModLoaderMod, Keybinds, ConsoleEnablerMod…). Hidden by default — every UE4SS install has them."/>
                            <StackPanel Orientation="Horizontal" ToolTip="Click to select, Ctrl-click to add, Shift-click for a range. Right-click for more.">
                                <TextBlock Text="UE4SS MODS" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Ue4ssShownCount, Mode=OneWay}"/><Run Text=" · Lua scripts — Apply turns them on or off"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <!-- What the selected mods in this panel can do (Ctrl/Shift-click to select). -->
                        <Border Grid.Row="1" Margin="10,0,10,8" Padding="12,4,6,4" CornerRadius="6" Background="{DynamicResource NavItemSelectedBrush}"
                                Visibility="{Binding HasUe4ssSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Padding="0"
                                        Command="{Binding ClearSelectionCommand}" ToolTip="Clear the selection (Esc)" AutomationProperties.Name="Clear selection">
                                    <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Text="Space on/off · Del delete · Enter details" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0"><Run Text="{Binding Ue4ssSelectedCount, Mode=OneWay}"/><Run Text=" selected"/></TextBlock>
                                    <Button Content="Turn on" Command="{Binding TurnOnSelectedCommand}" CommandParameter="ue4ss" Padding="10,2" Margin="0,0,6,0"/>
                                    <Button Content="Turn off" Command="{Binding TurnOffSelectedCommand}" CommandParameter="ue4ss" Padding="10,2" Margin="0,0,6,0"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="Ue4ssHeaderGrid" Grid.Row="2" Margin="4,0,4,4">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Author" IsCheckable="True" IsChecked="{Binding ShowAuthorColumn}"/>
                                    <MenuItem Header="Version" IsCheckable="True" IsChecked="{Binding ShowVersionColumn}"/>
                                    <MenuItem Header="Source" IsCheckable="True" IsChecked="{Binding ShowSourceColumn}"/>
                                    <MenuItem Header="Status" IsCheckable="True" IsChecked="{Binding ShowStatusColumn}"/>
                                    <MenuItem Header="Latest" IsCheckable="True" IsChecked="{Binding ShowLatestColumn}"
                                              ToolTip="The version last seen on Nexus/the Database, even when you're already up to date"/>
                                    <MenuItem Header="Imported" IsCheckable="True" IsChecked="{Binding ShowImportedColumn}"
                                              ToolTip="When this mod was added to your Library"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="6" SharedSizeGroup="ColCheckbox"/>
                                <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="ColEnabled"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColIcons"/>
                                <ColumnDefinition Width="Auto" MinWidth="{DynamicResource Ue4ssNameColumnWidth}" MaxWidth="{DynamicResource Ue4ssNameColumnWidth}" SharedSizeGroup="ColName"/>
                                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="ColVersion"/>
                                <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="ColSource"/>
                                <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="ColStatus"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColLatest"/>
                                <ColumnDefinition Width="Auto" MinWidth="{DynamicResource Ue4ssFillWidth}" SharedSizeGroup="ColFill"/>
                                <ColumnDefinition Width="Auto" MinWidth="84" SharedSizeGroup="ColActions"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="ON" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Margin="0,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByColumnCommand}" CommandParameter="Name"
                                    ToolTip="Sort by name" AutomationProperties.Name="Sort by name">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NAME" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="4,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortIndicatorConverter}" ConverterParameter="Name">
                                                <Binding Path="SortColumn"/>
                                                <Binding Path="SortDescending"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="4" Text="VERSION" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowVersionColumn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="5" Text="SOURCE" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowSourceColumn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowStatusColumn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="7" Text="LATEST" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowLatestColumn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <Grid Grid.Row="3">
                            <TreeView x:Name="Ue4ssTree" ItemsSource="{Binding Ue4ssRootItems}" Background="Transparent" BorderThickness="0" AlternationCount="2"
                                      HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource BorderBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectedItemChanged="LibraryTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="LibraryTree_PreviewMouseRightButtonDown"
                                      PreviewMouseLeftButtonDown="LibraryTree_PreviewMouseLeftButtonDown"
                                      MouseDoubleClick="LibraryTree_MouseDoubleClick"/>
                            <TextBlock Text="{Binding Ue4ssEmptyText}" Margin="16,14" FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"
                                       IsHitTestVisible="False" Visibility="{Binding IsUe4ssPanelEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <!-- What isn't in the game yet from this panel, and the one action that puts it there. -->
                        <Border Grid.Row="4" Padding="12,8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CardRaisedBackgroundBrush}"
                                Visibility="{Binding HasPendingUe4ssChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyUe4ssChangesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                                        ToolTip="Moves every ticked/unticked UE4SS mod to match — backs up anything removed from the game folder first"/>
                                <TextBlock Text="NOT IN GAME YET" Style="{StaticResource FieldLabelStyle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PendingUe4ssText}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding PendingUe4ssText}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4">
                    <!-- A ticked UE4SS mod with no UE4SS in the game: it can't run. One click installs
                         the UE4SS that ships with Starlink (Settings does the work and asks first). -->
                    <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding ShowUe4ssLoaderMissing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding InstallUe4ssLoaderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                                    ToolTip="Installs the UE4SS that comes with Starlink into the game. Asks first and backs up anything it replaces.">
                                <TextBlock>
                                    <Run Text="Install UE4SS "/><Run Text="{Binding BundledUe4ssVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="UE4SS MISSING" Style="{StaticResource FieldLabelStyle}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="UE4SS mods are ticked, but UE4SS itself isn't installed in the game, so they won't run." VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding ShowPendingBar, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- After a game update: one click gets every mod ready for it (and shows what changed). -->
                                <Button Content="Dismiss" Command="{Binding DismissGameUpdateCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding HasGameUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Hide this until the next game update (nothing is changed)"/>
                                <Button Content="Update everything…" Command="{Binding UpdateEverythingCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                                        Visibility="{Binding HasGameUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Saves your setup (to roll back to), refreshes game data, checks and fixes every mod (proven fixes only), checks for mod updates, then builds and installs the merge. Shows what changed at the end."/>
                                <Button Content="{Binding TickWhatsInTheGameLabel}" Command="{Binding TickWhatsInTheGameCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding CanTickWhatsInTheGame, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="These mods are in the game but not ticked, so Merge &amp; Install would take them out. This ticks them again in the order they were merged (nothing changes in the game until Merge &amp; Install)."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PENDING" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding GameUpdateText}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                                           Visibility="{Binding HasGameUpdate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding TickWhatsInTheGameHint}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
            </StackPanel>
        </Grid>

        <!-- Results pop up here for a few seconds instead of a status line that stayed. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" MaxWidth="420" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding Notice, Converter={StaticResource NullToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Padding="0" Margin="10,0,0,0" VerticalAlignment="Top"
                        Command="{Binding DismissNoticeCommand}" ToolTip="Close" AutomationProperties.Name="Close message">
                    <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                </Button>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNoticeWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
