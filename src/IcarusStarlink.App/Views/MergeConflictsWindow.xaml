<Window x:Class="IcarusStarlink.App.Views.MergeConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge conflicts" Height="780" Width="1280" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Who wins where two queued mods change the same value: grouped by which mods collide, the
         values side by side kdiff-style, a winner per line or per group. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="290" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary}" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Expander Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding HasCollisions, Converter={StaticResource BoolToVisibilityConverter}}"
                  Header="New items with the same name in two mods (both are merged into one; nothing to pick)">
            <ItemsControl ItemsSource="{Binding Collisions}" Margin="8,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Which mods collide, and how often; pick a winner for a whole group at once. -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Show all" Command="{Binding ShowAllCommand}" Padding="8,1" ToolTip="List every conflict again"/>
                    <TextBlock Text="MODS THAT COLLIDE" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Mods}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="6,1" Margin="0,0,6,4" FontSize="11.5"
                                                        Command="{Binding DataContext.WinAllCommand, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        CommandParameter="{Binding}" ToolTip="This mod wins every conflict in this group">
                                                    <TextBlock>
                                                        <Run Text="{Binding Mode=OneWay}"/><Run Text=" wins all"/>
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Default for all" Padding="6,1" FontSize="11.5" HorizontalAlignment="Left"
                                            Command="{Binding WinAllCommand}" CommandParameter="{x:Null}"
                                            ToolTip="Back to the merge's own rule for this group: the mod lower in the queue wins, or lists take everyone's additions"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Every conflicting value, with who wins. -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Find a row, field or mod by name"/>
                    <TextBlock Text="Find a row, field or mod…" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="8,0,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ROW" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="FIELD" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="2" Text="CHANGED BY" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="3" Text="WINNER" Style="{StaticResource FieldLabelStyle}"/>
                </Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ListBox ItemsSource="{Binding ConflictsView}" SelectedItem="{Binding SelectedConflict}" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Row}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Row}"/>
                                        <TextBlock Text="{Binding Table}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Field}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Field}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ModsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModsText}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                                              ToolTip="Which mod's value goes into the game for this line"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ToolTip="Drag to resize"/>

        <!-- The selected line side by side: the game, each mod, the result. Click a mod to make it win. -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10"
                DataContext="{Binding SelectedConflict}"
                Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <DockPanel x:Name="Comparison">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="2" Background="#5539A845" Margin="0,0,4,0"/>
                        <TextBlock Text="the game doesn't have it" FontSize="11.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#55D04040" Margin="0,0,4,0"/>
                        <TextBlock Text="left out" FontSize="11.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#55E0A030" Margin="0,0,4,0"/>
                        <TextBlock Text="different from the game" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Row, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Field, Mode=OneWay}"/><Run Text="   wins: "/><Run Text="{Binding WinnerText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </DockPanel>

                <!-- Column headers: click a mod to make it win this line. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Columns}" Margin="0,0,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="{Binding DataContext.ColumnCount, ElementName=Comparison}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="6,0,6,0">
                                <Button DockPanel.Dock="Right" Content="Make it win" Padding="6,0" FontSize="11"
                                        Command="{Binding DataContext.PickColumnCommand, ElementName=Comparison}" CommandParameter="{Binding}"
                                        Visibility="{Binding CanPick, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock x:Name="Wins" DockPanel.Dock="Right" Text="WINS" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabelStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                    <Setter TargetName="Wins" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Matrix}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="{Binding DataContext.ColumnCount, ElementName=Comparison}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Cell" Padding="6,1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                                    <TextBlock x:Name="CellText" Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Text}"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                        <Setter TargetName="Cell" Property="Background" Value="#5539A845"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter TargetName="Cell" Property="Background" Value="#33D04040"/>
                                                        <Setter TargetName="CellText" Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter TargetName="CellText" Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                        <Setter TargetName="Cell" Property="Background" Value="#55E0A030"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsList, ElementName=Comparison}" Value="False">
                                                        <Setter TargetName="CellText" Property="FontFamily" Value="Consolas"/>
                                                        <Setter TargetName="CellText" Property="FontSize" Value="11.5"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="All back to default" Command="{Binding ResetAllCommand}"
                    ToolTip="Forget every pick here: the mod lower in the queue wins, or lists take everyone's additions"/>
            <Button DockPanel.Dock="Right" Content="Save picks" Click="Apply_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                    ToolTip="Saves these winners with the profile; the next Merge &amp; Install uses them. Nothing is written into the game until then."/>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </DockPanel>
    </Grid>
</Window>
