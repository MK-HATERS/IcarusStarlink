<Window x:Class="IcarusStarlink.App.Views.PickNexusFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Choose a file to download" Height="460" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ListBox x:Name="FilesListBox" Grid.Row="1" MouseDoubleClick="FilesListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text=" — recommended" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Bottom"
                                       Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                            <Run Text="{Binding CategoryName, Mode=OneWay}"/><Run Text=" · v"/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Notes}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Visibility="{Binding Notes, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <CheckBox x:Name="ShowOldVersionsCheckBox" Grid.Row="2" Content="Show old/archived versions too" Margin="0,10,0,0"
                  Checked="ShowOldVersionsCheckBox_Changed" Unchecked="ShowOldVersionsCheckBox_Changed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Download" Click="Download_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
