<UserControl x:Class="IcarusStarlink.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:IcarusStarlink.App.Utilities"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- DataGridColumn.Visibility can't reach the page's DataContext via ElementName (see
             BindingProxy's own doc comment) — every toggleable IMM Database column binds through
             this proxy instead. -->
        <utilities:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <TabControl Grid.Row="1" Margin="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="IMM Database">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button x:Name="ColumnsButton" Command="{Binding ToggleColumnsMenuCommand}" AutomationProperties.Name="Columns">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGearTeeth}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Columns" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding IsColumnsMenuOpen, Mode=TwoWay}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="170">
                                    <StackPanel>
                                        <TextBlock Text="Columns" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Author" IsChecked="{Binding ShowAuthorColumn}" Margin="0,3"/>
                                        <CheckBox Content="Version" IsChecked="{Binding ShowVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Inst.Ver" IsChecked="{Binding ShowInstalledVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Compat." IsChecked="{Binding ShowCompatibilityColumn}" Margin="0,3"/>
                                        <CheckBox Content="Category" IsChecked="{Binding ShowCategoryColumn}" Margin="0,3"/>
                                        <CheckBox Content="Status" IsChecked="{Binding ShowStatusColumn}" Margin="0,3"/>
                                        <CheckBox Content="Last Updated" IsChecked="{Binding ShowLastUpdatedColumn}" Margin="0,3"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding ClearCatalogFiltersCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Command="{Binding DownloadAndExtractSelectedCommand}" Margin="8,0,0,0"
                                ToolTip="Downloads and imports every selected mod, one after another — Ctrl/Shift-click rows to select more than one"
                                Visibility="{Binding HasCatalogSelectionForBatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="Download and extract selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedCatalogEntryCount, StringFormat='Download selected ({0})'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshCatalogCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Refresh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource AccentForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,0,8,0">
                            <TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by name, author, or description"/>
                            <TextBlock Text="Search mods by name, author, or description…" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding CatalogSearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </DockPanel>

                    <!-- WrapPanel, not a horizontal StackPanel — at a narrow window width this row has
                         more controls than fit on one line, and a StackPanel would just clip the
                         overflow off the right edge with no way to reach it; WrapPanel drops the
                         overflow onto a second line instead. -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Author:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableAuthors}" SelectedItem="{Binding SelectedAuthor}" Width="160"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Width="160"/>
                        </StackPanel>
                        <CheckBox Content="Show updates only" IsChecked="{Binding ShowUpdatesOnly}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <CheckBox Content="Extracted only" IsChecked="{Binding ExtractedOnly}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <CheckBox Content="Not downloaded only" IsChecked="{Binding NotDownloadedOnly}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Game week:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox Text="{Binding GameWeek, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0"/>
                        <CheckBox Content="Hide older weeks" IsChecked="{Binding HideOlderWeeks}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12">
                            <Run Text="{Binding CatalogShownCount, Mode=OneWay}"/><Run Text=" shown / "/><Run Text="{Binding CatalogTotalCount, Mode=OneWay}"/><Run Text=" in catalog"/>
                        </TextBlock>
                        <TextBlock Text=" — loading…" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                   Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" x:Name="CatalogGrid" ItemsSource="{Binding CatalogEntries}" SelectedItem="{Binding SelectedCatalogEntry}"
                                  SelectionChanged="CatalogGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Fixed pixel widths on every column, not Star ("*"): a Star column
                                     always redistributes space among its sibling Star columns on any
                                     resize, so dragging one wider steals width from the others instead
                                     of growing the grid's total content width — which is also why no
                                     horizontal scrollbar could ever appear. Fixed widths let content
                                     genuinely overflow the viewport, so resizing one column no longer
                                     crunches the rest; the DataGrid's default ControlTemplate already
                                     shows a horizontal scrollbar (HorizontalScrollBarVisibility="Auto"
                                     is its own built-in default) once that happens. -->
                                <DataGridTextColumn Header="Mod Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"
                                                     Visibility="{Binding Data.ShowAuthorColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"
                                                     Visibility="{Binding Data.ShowVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Inst.Ver" Binding="{Binding InstalledVersion}" Width="70"
                                                     Visibility="{Binding Data.ShowInstalledVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Compat." Binding="{Binding CompatibilityDisplay}" Width="70"
                                                     Visibility="{Binding Data.ShowCompatibilityColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="150"
                                                     Visibility="{Binding Data.ShowCategoryColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTemplateColumn Header="Status" Width="90"
                                                         Visibility="{Binding Data.ShowStatusColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Phase 10: a small semantic badge instead of plain text — same
                                                 pill treatment Merge & Install's conflict badge uses. -->
                                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdatedDisplay}" Width="90"
                                                     Visibility="{Binding Data.ShowLastUpdatedColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Select a mod to see its details and download it."
                                       Style="{StaticResource PageBodyTextStyle}" Margin="0,8,0,0"
                                       Visibility="{Binding SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <StackPanel Grid.Row="0" Visibility="{Binding SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border Height="120" Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedCatalogEntry.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding SelectedCatalogEntry.Author, Mode=OneWay}"/>
                                    <Run Text=" · v"/>
                                    <Run Text="{Binding SelectedCatalogEntry.Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedCatalogEntry.Entry.Description}" Style="{StaticResource PageBodyTextStyle}" MaxWidth="260" Margin="0,0,0,12"/>
                                <Button Command="{Binding DownloadAndExtractCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                                        IsEnabled="{Binding SelectedCatalogEntry.HasDownloadableFile}"
                                        AutomationProperties.Name="Download and extract">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Download &amp; extract" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenCatalogReadmeCommand}" AutomationProperties.Name="Open readme">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Open readme" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding CatalogStatusMessage}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- One tab for everything Nexus-mod-shaped: the tracked watchlist on top, and the
                 downloads waiting to install below it (they were a separate "Pending Downloads"
                 tab, but nothing non-Nexus ever lands there — one place is easier to follow).
                 The header badge counts files waiting to install; the dot means a download is
                 in flight right now. -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mods"/>
                        <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" ToolTip="Downloads waiting to install">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingDownloads.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PendingDownloads.Count}" FontSize="10" FontFamily="Consolas"
                                       Foreground="{DynamicResource AccentForegroundBrush}"/>
                        </Border>
                        <Ellipse Width="7" Height="7" Margin="6,0,0,0" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                 ToolTip="A download is in progress"
                                 Visibility="{Binding IsFetchingDownload, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- Scrolls as one page (same pattern as Settings' tabs) — the two lists size to
                     their content within min/max bounds instead of fighting over a fixed height
                     that clips whichever loses at a small window size. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Tracked mods" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Mods you follow — Check for updates flags the ones Nexus says changed recently."
                                   Style="{StaticResource PageBodyTextStyle}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- One toolbar row, same shape as the IMM Database tab's own: filter fills the
                         remaining space on the left, the "add" action docks to the right — instead
                         of two competing full-width boxes stacked on top of each other. -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding AddNexusUrlCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Add mod URL">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Add mod URL" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid DockPanel.Dock="Right" Width="280" Margin="16,0,8,0">
                            <TextBox Text="{Binding NewNexusUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Mod page URL, e.g. …/icarus/mods/304" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding NewNexusUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                        <Grid>
                            <TextBox Text="{Binding NexusFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Filter tracked mods…" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding NexusFilterText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding NexusEntries}" SelectedItem="{Binding SelectedNexusEntry}"
                              MinHeight="110" MaxHeight="320">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mod Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Nexus ID" Binding="{Binding NexusId}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Update?" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="7,2" Background="{DynamicResource AccentSoftBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Available" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Overlays the empty grid's body, centered — a first-visit user should see
                         how to get something in here, not a blank rectangle. -->
                    <TextBlock Grid.Row="2" Margin="12,44,12,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageBodyTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NexusEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Nothing tracked yet. Paste a mod page URL above (e.g. https://www.nexusmods.com/icarus/mods/304) and click Add mod URL, or click Track on any mod on the Nexus page."/>
                    </TextBlock>

                    <!-- Row-selection actions sit directly under the grid they act on. -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Command="{Binding BrowseOnNexusCommand}" Margin="0,0,8,0" AutomationProperties.Name="Browse on Nexus">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Browse on Nexus" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshNexusEntryInfoCommand}" CommandParameter="{Binding SelectedNexusEntry}" Margin="0,0,8,0"
                                ToolTip="Re-fetch this one mod's real name from Nexus — needs a signed-in Nexus API key, set in Settings"
                                AutomationProperties.Name="Refresh info">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh info" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckForNexusUpdatesCommand}" Margin="0,0,8,0"
                                ToolTip="Checks every mod above against Nexus's own recently-updated list (last month) — needs a signed-in Nexus API key, set in Settings"
                                AutomationProperties.Name="Check for updates">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportNexusFileCommand}" Margin="0,0,8,0" AutomationProperties.Name="Import file">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Import file…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveNexusEntryCommand}" AutomationProperties.Name="Remove from list">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove from list" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Checking…" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Visibility="{Binding IsCheckingNexusUpdates, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding NexusStatusMessage}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>

                    <!-- Downloads waiting to install — was its own "Pending Downloads" tab. -->
                    <StackPanel Grid.Row="5" Margin="0,4,0,10">
                        <Border Style="{StaticResource SectionDividerStyle}" Margin="0,10,0,14"/>
                        <TextBlock Text="Downloads waiting to install" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource PageBodyTextStyle}" HorizontalAlignment="Left"
                                   Text="Files land here from the Nexus page's Download button or a website &quot;Mod Manager Download&quot; — activate one to import it into your Library, or discard it."/>
                    </StackPanel>

                    <DockPanel Grid.Row="6" Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding FetchNxmUrlCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Manually paste and fetch an nxm:// link — the same path a real 'Mod Manager Download' click will eventually use"
                                AutomationProperties.Name="Fetch">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Fetch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,0,8,0">
                            <TextBox Text="{Binding ManualNxmUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Fetch a download link by hand, e.g. nxm://icarus/mods/290/files/12345" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding ManualNxmUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </DockPanel>

                    <DataGrid Grid.Row="7" ItemsSource="{Binding PendingDownloads}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="3*"/>
                            <DataGridTextColumn Header="Mod ID" Binding="{Binding ModId}" Width="80"/>
                            <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedAtUtc, StringFormat='{}{0:g}'}" Width="150"/>
                            <DataGridTemplateColumn Header="" Width="320">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Deleted from Library — click to reinstall" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="130"
                                                       Visibility="{Binding WasDeleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Margin="4,2"
                                                    Command="{Binding DataContext.ActivatePendingDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Import this file into your Library — Reinstall replaces what's currently there"
                                                    AutomationProperties.Name="{Binding ActionLabel}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding ActionLabel}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="4,2"
                                                    Command="{Binding DataContext.DiscardPendingDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete the downloaded file and remove it from this list"
                                                    AutomationProperties.Name="Discard">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Discard" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Same first-visit-hint idea as the tracked list, stacked under the grid
                         (this row is Auto-sized, so an overlay would sit on the header row). -->
                    <TextBlock Grid.Row="8" Margin="4,6,4,0" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageBodyTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PendingDownloads.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="No downloads waiting. Click Download on a Nexus page card, use a Mod Manager Download button on the website, or paste an nxm:// link above (e.g. nxm://icarus/mods/290/files/12345)."/>
                    </TextBlock>

                    <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Fetching…" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsFetchingDownload, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding PendingDownloadStatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
