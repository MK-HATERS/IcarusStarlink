<UserControl x:Class="IcarusStarlink.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:IcarusStarlink.App.Utilities"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- DataGridColumn.Visibility can't reach the page's DataContext via ElementName (see
             BindingProxy's own doc comment) — every toggleable IMM Database column binds through
             this proxy instead. -->
        <utilities:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="IMM Database">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button x:Name="ColumnsButton" Content="Columns" Command="{Binding ToggleColumnsMenuCommand}"/>
                            <Popup PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding IsColumnsMenuOpen, Mode=TwoWay}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="170">
                                    <StackPanel>
                                        <TextBlock Text="Columns" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Author" IsChecked="{Binding ShowAuthorColumn}" Margin="0,3"/>
                                        <CheckBox Content="Version" IsChecked="{Binding ShowVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Inst.Ver" IsChecked="{Binding ShowInstalledVersionColumn}" Margin="0,3"/>
                                        <CheckBox Content="Compat." IsChecked="{Binding ShowCompatibilityColumn}" Margin="0,3"/>
                                        <CheckBox Content="Category" IsChecked="{Binding ShowCategoryColumn}" Margin="0,3"/>
                                        <CheckBox Content="Status" IsChecked="{Binding ShowStatusColumn}" Margin="0,3"/>
                                        <CheckBox Content="Last Updated" IsChecked="{Binding ShowLastUpdatedColumn}" Margin="0,3"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding ClearCatalogFiltersCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCatalogCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 ToolTip="Search by name, author, or description"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Author:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableAuthors}" SelectedItem="{Binding SelectedAuthor}" Width="160" Margin="0,0,16,0"/>
                        <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Width="160" Margin="0,0,16,0"/>
                        <CheckBox Content="Show updates only" IsChecked="{Binding ShowUpdatesOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox Content="Extracted only" IsChecked="{Binding ExtractedOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox Content="Not downloaded only" IsChecked="{Binding NotDownloadedOnly}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Game week:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox Text="{Binding GameWeek, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0"/>
                        <CheckBox Content="Hide older weeks" IsChecked="{Binding HideOlderWeeks}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12">
                            <Run Text="{Binding CatalogShownCount, Mode=OneWay}"/><Run Text=" shown / "/><Run Text="{Binding CatalogTotalCount, Mode=OneWay}"/><Run Text=" in catalog"/>
                        </TextBlock>
                        <TextBlock Text=" — loading…" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                   Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding CatalogEntries}" SelectedItem="{Binding SelectedCatalogEntry}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Fixed pixel widths on every column, not Star ("*"): a Star column
                                     always redistributes space among its sibling Star columns on any
                                     resize, so dragging one wider steals width from the others instead
                                     of growing the grid's total content width — which is also why no
                                     horizontal scrollbar could ever appear. Fixed widths let content
                                     genuinely overflow the viewport, so resizing one column no longer
                                     crunches the rest; the DataGrid's default ControlTemplate already
                                     shows a horizontal scrollbar (HorizontalScrollBarVisibility="Auto"
                                     is its own built-in default) once that happens. -->
                                <DataGridTextColumn Header="Mod Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"
                                                     Visibility="{Binding Data.ShowAuthorColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"
                                                     Visibility="{Binding Data.ShowVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Inst.Ver" Binding="{Binding InstalledVersion}" Width="70"
                                                     Visibility="{Binding Data.ShowInstalledVersionColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Compat." Binding="{Binding CompatibilityDisplay}" Width="70"
                                                     Visibility="{Binding Data.ShowCompatibilityColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="150"
                                                     Visibility="{Binding Data.ShowCategoryColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"
                                                     Visibility="{Binding Data.ShowStatusColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdatedDisplay}" Width="90"
                                                     Visibility="{Binding Data.ShowLastUpdatedColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Visibility="{Binding SelectedCatalogEntry, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border Height="120" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                    <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedCatalogEntry.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding SelectedCatalogEntry.Author, Mode=OneWay}"/>
                                    <Run Text=" · v"/>
                                    <Run Text="{Binding SelectedCatalogEntry.Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedCatalogEntry.Entry.Description}" Style="{StaticResource PageBodyTextStyle}" MaxWidth="260" Margin="0,0,0,12"/>
                                <Button Content="Download &amp; extract" Command="{Binding DownloadAndExtractCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                                        IsEnabled="{Binding SelectedCatalogEntry.HasDownloadableFile}"/>
                                <Button Content="Open readme" Command="{Binding OpenCatalogReadmeCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding CatalogStatusMessage}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                </Grid>
            </TabItem>

            <TabItem Header="Nexus Mods">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding NexusFilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             ToolTip="Filter my Nexus list…"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Add mod URL" Command="{Binding AddNexusUrlCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBox Text="{Binding NewNexusUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 ToolTip="Paste a nexusmods.com/icarus/mods/&lt;id&gt; URL"/>
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding NexusEntries}" SelectedItem="{Binding SelectedNexusEntry}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mod Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Nexus ID" Binding="{Binding NexusId}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Update?" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Available" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="4,0"
                                                   Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Browse on Nexus" Command="{Binding BrowseOnNexusCommand}" Margin="0,0,8,0"/>
                        <Button Content="Check for updates" Command="{Binding CheckForNexusUpdatesCommand}" Margin="0,0,8,0"
                                ToolTip="Checks every mod above against Nexus's own recently-updated list (last month) — needs a signed-in Nexus API key, set in Settings"/>
                        <Button Content="Import file…" Command="{Binding ImportNexusFileCommand}" Margin="0,0,8,0"/>
                        <Button Content="Remove from list" Command="{Binding RemoveNexusEntryCommand}"/>
                        <TextBlock Text="Checking…" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Visibility="{Binding IsCheckingNexusUpdates, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding NexusStatusMessage}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
