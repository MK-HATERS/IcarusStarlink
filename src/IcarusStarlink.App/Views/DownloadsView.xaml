<UserControl x:Class="IcarusStarlink.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- The Downloads page: every file fetched from Nexus and what it turned into. A download is
         activated (imported) automatically the moment it lands, so for most people this page is a
         history — the row's Reinstall is the way back after a delete, and "Get X" fetches a
         dependency the mod's README named. The DataContext is the shared DownloadsViewModel (the
         same instance the Nexus page and the Database page's IMM Database tab use). -->
    <Grid Margin="32,32,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Downloads" Style="{StaticResource PageHeaderStyle}"/>
            <!-- How many downloads in all, installed ones included. -->
            <TextBlock Text="{Binding PendingDownloads.Count, StringFormat='· {0}'}" Style="{StaticResource SectionCountTextStyle}"
                       FontSize="16" Margin="8,0,0,8" ToolTip="Downloads in all, installed ones included"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Everything downloaded through this app, from Nexus or the IMM Database. A download is imported the moment it finishes — one download is one mod: its paks and any Lua part all land in Library's list, as linked rows. Reinstall puts a removed mod back; Discard deletes the downloaded file."/>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <!-- ContentStringFormat, not Binding.StringFormat: Content is an object, so a
                 StringFormat on its binding is ignored and the box read just "3". -->
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowInstalledDownloads}" VerticalAlignment="Center"
                      Content="{Binding InstalledDownloadCount}" ContentStringFormat="Show installed ({0})"
                      ToolTip="Downloads that are fully installed are hidden by default — tick to see them (Reinstall lives there)"/>
            <!-- Only while something is downloading: stops every download in progress (an install
                 already under way finishes — cutting it off could leave a mod half-copied). -->
            <Button DockPanel.Dock="Right" Margin="0,0,12,0" Content="Cancel downloads"
                    Command="{Binding CancelDownloadsCommand}"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Stop every download in progress"/>
            <TextBlock Text="{Binding PendingDownloadStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding VisiblePendingDownloads}" AutoGenerateColumns="False" IsReadOnly="True">
            <!-- Every cell's text centred in the row, level with the buttons on the right. -->
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Mod" Width="*" MinWidth="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- The downloaded file's own name (Nexus appends version/date/hash) is a hover away. -->
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CenteredCellTextStyle}" FontWeight="SemiBold"
                                       ToolTip="{Binding FileName}" ToolTipService.InitialShowDelay="600"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                <DataGridTextColumn Header="Contains" Binding="{Binding PartsSummary}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WasDeleted}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Sized to what the rows need (usually nothing), capped so one long README line can't take the row. -->
                <DataGridTemplateColumn Header="Needs" Width="Auto" MaxWidth="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RequirementsSummary}" Style="{StaticResource CenteredCellTextStyle}" ToolTip="{Binding RequirementsSummary}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedAtUtc.LocalDateTime, StringFormat='{}{0:d MMM yyyy, HH:mm}'}" Width="Auto" MinWidth="130"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="4,2"
                                        Command="{Binding DataContext.ActivatePendingDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Import this download — Reinstall replaces what's currently there"
                                        AutomationProperties.Name="{Binding ActionLabel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ActionLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="4,2"
                                        Command="{Binding DataContext.GetRequirementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanGetRequirement, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{Binding RequirementsSummary}"
                                        AutomationProperties.Name="Get requirement">
                                    <TextBlock Text="{Binding GetRequirementLabel}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Margin="4,2"
                                        Command="{Binding DataContext.DiscardPendingDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Delete the downloaded file and remove it from this list (the installed mod, if any, stays)"
                                        AutomationProperties.Name="Discard">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Discard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Instead of a blank table: nothing downloaded yet, or every download installed and hidden. -->
        <TextBlock Grid.Row="3" Text="{Binding DownloadsEmptyText}" Style="{StaticResource EmptyStateTextStyle}" IsHitTestVisible="False"
                   Visibility="{Binding DownloadsEmptyText, Converter={StaticResource NullToVisibilityConverter}}"/>
    </Grid>
</UserControl>
