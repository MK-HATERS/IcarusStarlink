<Window x:Class="IcarusStarlink.App.Views.FindBrokenModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find the broken mod" Height="720" Width="900" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Find the broken mod (FindBrokenModViewModel): say what's broken, see the suspects, then
         rounds where Starlink installs part of the mods and the player says what they saw, then
         the answer and putting every mod back. One step shows at a time. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Find the broken mod" Style="{StaticResource PageHeaderStyle}" Margin="0,0,0,8"/>

        <!-- Step 1: what's broken, and the suspects -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsDescribeStep, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Something broken in game, like you can't drink from a canteen? This finds the mod behind it. Each round Starlink installs part of your mods, you start the game and check, then say what you saw. At the end all your mods go back in."/>

            <TextBlock DockPanel.Dock="Top" Text="WHAT'S BROKEN (YOU CAN SKIP THIS)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox Text="{Binding ProblemText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="What's broken"
                         ToolTip="A word from the item or thing that's broken. Mods that change it are tested first."/>
                <TextBlock Text="e.g. canteen" Style="{StaticResource PlaceholderTextStyle}"
                           Visibility="{Binding ProblemText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Pick this row" Command="{Binding PickRowCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                        ToolTip="Points the search at exactly this game row (double-click a row does the same). Without a pick, the words you typed are used."/>
                <ListBox x:Name="MatchList" ItemsSource="{Binding MatchingRows}" SelectedItem="{Binding SelectedMatch}" DisplayMemberPath="Display"
                         Height="110" MouseDoubleClick="MatchList_MouseDoubleClick" AutomationProperties.Name="Matching game rows"/>
            </DockPanel>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PickedRows}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,4"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" ToolTip="{Binding Display}"/>
                                <Button Content="✕" Padding="4,0" Margin="6,0,0,0" FontSize="10" ToolTip="Take this row out of the search"
                                        Command="{Binding DataContext.UnpickRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Left" Content="Find suspects" Command="{Binding FindSuspectsCommand}" IsEnabled="{Binding IsIdle}"
                        ToolTip="Looks at your queued mods for the ones that change what you described"/>
                <TextBlock Text="{Binding SuspectSummary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="Only data mods (the Merge &amp; Install queue) are tested. UE4SS (Lua) mods and merge options stay as they are."/>

            <ListBox ItemsSource="{Binding Suspects}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Suspects">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Button DockPanel.Dock="Right" Content="Fix…" VerticalAlignment="Top" Margin="8,0,0,0"
                                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DataContext.OpenSuspectFixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Opens this mod's fix window: often the quickest answer"/>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Step 2: a round -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsRoundStep, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding RoundTitle}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding RoundText}" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border DockPanel.Dock="Top" Padding="12,10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Start the game, check, then come back. Is it still broken?" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="Still broken" Command="{Binding StillBrokenCommand}" Margin="0,0,8,0" MinWidth="110"
                                ToolTip="It's still broken with only these mods in"/>
                        <Button Content="Works now" Command="{Binding WorksNowCommand}" Margin="0,0,8,0" MinWidth="110"
                                ToolTip="It works with only these mods in"/>
                        <Button Content="Can't tell" Command="{Binding CantTellCommand}" MinWidth="110"
                                ToolTip="You couldn't check this time: the next round tests a different set"/>
                    </WrapPanel>
                    <TextBlock Text="Close the game before you answer: the next round installs right away." FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="IN THE GAME THIS ROUND" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding InGameMods}" AutomationProperties.Name="In the game this round"/>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OutOfGameHeader}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding OutOfGameMods}" AutomationProperties.Name="Out for this round"/>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Step 3: the answer -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsResultStep, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ResultTitle}" Style="{StaticResource SectionHeaderStyle}" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ResultText}" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Culprits}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Found mods">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Open fix window" Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenCulpritFixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="Checks this mod against the game and shows what to fix"/>
                                    <Button Content="Turn it off" Margin="0,0,8,0" IsEnabled="{Binding CanTurnOff}"
                                            Command="{Binding DataContext.TurnOffCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="Takes it out of your merge queue: it stays out when your mods go back in. Turn it on again in the Library."/>
                                    <Button Content="Open Nexus page"
                                            Visibility="{Binding HasNexusPage, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.OpenNexusPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="The mod's page: look for an update, or tell its author"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The end: every mod is back -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding DoneText}" Style="{StaticResource EmptyStateTextStyle}"/>
        </StackPanel>

        <!-- Status and buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0"
                        Visibility="{Binding IsDescribeStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Backs up your saves, then installs the first round"/>
                <Button Content="Install this round" Command="{Binding InstallRoundCommand}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0"
                        Visibility="{Binding IsRoundStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Installs this round's mods again (after a failed install, or if you changed something in the game folder)"/>
                <Button Content="Stop and put my mods back" Command="{Binding StopCommand}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0"
                        Visibility="{Binding IsRoundStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Ends the search and installs all your mods again"/>
                <Button Content="Put my mods back" Command="{Binding PutModsBackCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0"
                        Visibility="{Binding IsResultStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Installs all your mods again (except any you turned off)"/>
                <Button Content="Close" Click="Close_Click" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </DockPanel>
    </Grid>
</Window>
