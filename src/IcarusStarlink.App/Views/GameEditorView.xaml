<UserControl x:Class="IcarusStarlink.App.Views.GameEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GameEditorViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="32,32,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Margin="0,6,0,14" Style="{StaticResource PageBodyTextStyle}"
                   Text="Change the game's own items: make the default Envirosuit lighter, Bread's buff stronger, a recipe cheaper. Pick an item, change the numbers you want, then save into a new mod or one of your own mods. Only what you change goes into the mod. To make a brand-new item instead, use New mod… in Library."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- The gaps are splitters: drag to give the item list, the cards or the save panel more room. -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize"
                          AutomationProperties.Name="Resize the item list"/>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize"
                          AutomationProperties.Name="Resize the save panel"/>

            <!-- The game's items -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search game items"/>
                    <TextBlock Text="Search, e.g. envirosuit, bread, axe" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding FilterText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Border Grid.Row="1" Margin="0,6,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <!-- No sideways scrolling: the in-game name on top, the row name smaller under it,
                         both cut with … and shown in full on hover. -->
                    <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1" ToolTip="{Binding Display}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="10.5" FontFamily="Consolas"
                                               Foreground="{DynamicResource FaintForegroundBrush}"
                                               Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- The item's sections -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="{Binding NoDataMessage}" TextWrapping="Wrap" Margin="16" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Visibility="{Binding NoDataMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <!-- Empty state: what the page is for, and a few common items to start from
                         (only those in the loaded game data). -->
                    <StackPanel Margin="20,18" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                                Visibility="{Binding ShowPickPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="Pick a game item on the left to change its numbers, or start with a common one:"/>
                        <ItemsControl ItemsSource="{Binding QuickStarts}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EditorQuickStart}">
                                    <Button Margin="0,0,8,8" Padding="10,5" Width="170" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenQuickStartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="{Binding Item.Display}" AutomationProperties.Name="{Binding Label, StringFormat='Edit {0}'}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Margin="14">
                            <TextBlock Text="{Binding ItemTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,4,0,10">
                                <CheckBox DockPanel.Dock="Right" Content="Only changed values" IsChecked="{Binding ShowChangedValuesOnly}" VerticalAlignment="Top" Margin="12,0,0,0"
                                          ToolTip="Hide the values that are still the game's, so you see just what you (or the mod you save to) change. Untick to see them all."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Text="Each card is one of the game rows this item uses; click its title to fold it away. An orange border marks a value that differs from the game's; ↺ puts the game's value back."/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameItemSectionViewModel}">
                                        <!-- A card per game row, foldable: an item with many rows (armour, buff,
                                             recipe…) can be narrowed to the one being changed. -->
                                        <Expander IsExpanded="True" Margin="0,0,0,10" Background="{DynamicResource ContentBackgroundBrush}"
                                                  AutomationProperties.Name="{Binding Title}">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsShared}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding SharedText}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Source, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource FaintForegroundBrush}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <Border Margin="0,0,0,6" Padding="9,7" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}"
                                                        Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Other items use this row too. Changing it changes all of them." TextWrapping="Wrap" FontSize="12.5"/>
                                                        <WrapPanel Margin="0,4,0,0">
                                                            <RadioButton Content="Give this item its own copy (only it changes)" IsChecked="{Binding OwnCopy}" Margin="0,0,16,0"/>
                                                            <RadioButton Content="{Binding AllItemsText}" IsChecked="{Binding ChangeForAll}"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Every value here is still the game's (untick Only changed values to see them)." FontSize="12" Margin="0,2,0,6"
                                                           Foreground="{DynamicResource FaintForegroundBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding AllHidden, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,6">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:GameItemFieldViewModel}">
                                                            <!-- A number gets a short box with the game's value right beside it, so
                                                                 every number lines up at the same place; text gets the whole width. -->
                                                            <Grid Margin="0,4" Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="190"/>
                                                                    <ColumnDefinition>
                                                                        <ColumnDefinition.Style>
                                                                            <Style TargetType="ColumnDefinition">
                                                                                <Setter Property="Width" Value="Auto"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                                        <Setter Property="Width" Value="*"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ColumnDefinition.Style>
                                                                    </ColumnDefinition>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition>
                                                                        <ColumnDefinition.Style>
                                                                            <Style TargetType="ColumnDefinition">
                                                                                <Setter Property="Width" Value="*"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                                        <Setter Property="Width" Value="0"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ColumnDefinition.Style>
                                                                    </ColumnDefinition>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
                                                                           ToolTip="{Binding Label}"/>
                                                                <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"
                                                                         AcceptsReturn="{Binding IsText}" TextWrapping="Wrap">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                            <Setter Property="Width" Value="130"/>
                                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                                    <Setter Property="Width" Value="NaN"/>
                                                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DiffersFromGame}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ValueHint}" FontSize="11.5" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                               Visibility="{Binding ValueHint, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding GameText}" FontSize="11.5" Foreground="{DynamicResource FaintForegroundBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding GameText}"/>
                                                                    <Button Content="&#x21BA;" Command="{Binding UseGameValueCommand}" Margin="6,0,0,0" Padding="5,0"
                                                                            ToolTip="Back to the game's value" AutomationProperties.Name="Back to the game's value"
                                                                            Visibility="{Binding DiffersFromGame, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding Error}" FontSize="11.5" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                                                               Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ContentControl Margin="0,0,0,0" Content="{Binding Picker}" ContentTemplate="{StaticResource StatPickerTemplate}"
                                                                Visibility="{Binding CanAddStat, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding KeptAsGames}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Visibility="{Binding KeptAsGames, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Saving -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="SAVE TO" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Display" Margin="0,6,0,0"
                                  ToolTip="A new mod, or a mod you made in Starlink. Mods from Nexus or the IMM Database aren't listed: an update would replace your changes."/>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsNewTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Name" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBox Text="{Binding NewModName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" AutomationProperties.Name="New mod name"/>
                            <TextBlock Text="Author" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBox Text="{Binding NewModAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" AutomationProperties.Name="New mod author"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,8,0,12"
                                   Text="Only mods you made in Starlink are listed: changes can't go into a mod from Nexus or the IMM Database."/>

                        <TextBlock Style="{StaticResource FieldLabelStyle}">
                            <Run Text="YOUR CHANGES"/><Run Text="{Binding PendingCount, Mode=OneWay, StringFormat=' ({0})'}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Writes every changed value into the chosen mod (only those values)"/>
                            <Button Content="Discard" Command="{Binding DiscardChangesCommand}" Margin="8,0,0,0" ToolTip="Forget the changes typed here, nothing saved"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Button Content="Turn on &amp; go to Merge &amp; Install" Command="{Binding TurnOnSavedModCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding HasSavedMod, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Ticks the saved mod ON (adds it to the merge queue) and opens Merge &amp; Install, where Install puts it in the game"/>
                    </StackPanel>

                    <!-- One line per changed value; the x puts that one back as it was shown. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Text="Nothing changed yet." FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Visibility="{Binding HasNoPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding PendingChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EditorPendingChange}">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="20" Height="20" VerticalAlignment="Top" Margin="4,0,0,0"
                                                    Command="{Binding Field.UndoChangeCommand}"
                                                    ToolTip="Undo this change" AutomationProperties.Name="Undo this change">
                                                <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Uniform"/>
                                            </Button>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
