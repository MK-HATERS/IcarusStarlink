<!-- What the mod editor window and its pop-out pane share: one field row, the field sections, the
     "Only changed fields" bar and the "Add a field" card. Merged into ExmodEditorWindow and
     ExmodPaneWindow; this EditorFieldTemplate replaces the older copy in Themes/Styles.xaml for both. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:IcarusStarlink.App.Views">

    <!-- The orange border on a value box that differs from the game's. -->
    <Style x:Key="ExmodChangedTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One field (EditorFieldViewModel): name | value + the game's value | ↺ ✕. Every kind has the
         same three columns, so labels, boxes and buttons line up down the list. -->
    <DataTemplate x:Key="EditorFieldTemplate">
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,3,10,0">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FieldName}" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource FaintForegroundBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <!-- Number -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNumberKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="{Binding Label}"
                                 Style="{StaticResource ExmodChangedTextBoxStyle}"/>
                        <TextBlock Text="{Binding BasePlainText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    </StackPanel>

                    <!-- Game text and plain text -->
                    <StackPanel Visibility="{Binding IsTextKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding PlainText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="{Binding Label}"
                                 Style="{StaticResource ExmodChangedTextBoxStyle}"/>
                        <TextBlock Text="{Binding BasePlainText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsStringKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding PlainString, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" AutomationProperties.Name="{Binding Label}"
                                 Style="{StaticResource ExmodChangedTextBoxStyle}"/>
                        <TextBlock Text="{Binding BasePlainText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" FontFamily="Consolas" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    </StackPanel>

                    <!-- True/false -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBoolKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}"/>
                        <TextBlock Text="{Binding BasePlainText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    </StackPanel>

                    <!-- A link to another table's row, or one of the game's own values: only real ones -->
                    <StackPanel Visibility="{Binding IsListKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox ItemsSource="{Binding Options}" Text="{Binding SelectedOption, UpdateSourceTrigger=LostFocus}"
                                  IsEditable="True" IsTextSearchEnabled="True" MaxWidth="420" HorizontalAlignment="Left" MinWidth="260"
                                  AutomationProperties.Name="{Binding Label}" ToolTip="Type to search; only values in the list are kept">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <TextBlock Text="{Binding BasePlainText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    </StackPanel>

                    <!-- One row per stat -->
                    <StackPanel Visibility="{Binding IsStatsKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsKept}" AutomationProperties.Name="{Binding Label}"
                                                 Style="{StaticResource ExmodChangedTextBoxStyle}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding GameText}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource FaintForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDropped}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="✕" Padding="6,1" Command="{Binding RemoveCommand}" ToolTip="Remove this stat from the mod's list (a game stat left out is gone in game)"
                                                    AutomationProperties.Name="Remove stat" Visibility="{Binding IsKept, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Put back" Padding="6,1" Command="{Binding PutBackCommand}" ToolTip="Keep the game's stat in this mod's list"
                                                    Visibility="{Binding IsDropped, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentControl Content="{Binding Picker}" ContentTemplate="{StaticResource StatPickerTemplate}" Margin="0,4,0,0"
                                        Visibility="{Binding HasPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Anything else: the JSON -->
                    <StackPanel Visibility="{Binding IsRawKind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                 Style="{StaticResource ExmodChangedTextBoxStyle}"
                                 ToolTip="This field as JSON (a list, link or nested value). An orange border means it differs from the game's."/>
                        <TextBlock Text="{Binding BaseValueText, StringFormat='game: {0}'}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"
                                   Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding OriginalValueText, StringFormat='was (before this edit): {0}'}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                               Visibility="{Binding IsChangedFromOriginal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ParseError}" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"
                               Visibility="{Binding ParseError, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="&#x21BA;" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="Back to the game's value (then this field changes nothing in game)" AutomationProperties.Name="Back to the game's value"
                            Command="{Binding UseGameValueCommand}"
                            Visibility="{Binding CanUseGameValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="✕" Padding="6,2"
                            ToolTip="Take this field out of the mod (the game's value applies again)" AutomationProperties.Name="Remove field"
                            Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A section of fields ("Numbers", "Names and text"…), foldable. -->
    <Style x:Key="ExmodFieldGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" AutomationProperties.Name="{Binding Name}"
                              views:GroupColor.Index="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}">
                        <Expander.Header>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource GroupStripeStyle}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource GroupTitleStyle}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ItemCount}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                            </DockPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Above the fields (DataContext: the editor): how many differ, and the "Only changed fields" switch. -->
    <DataTemplate x:Key="ExmodFieldsBarTemplate">
        <DockPanel Margin="0,4,0,0" LastChildFill="True">
            <CheckBox DockPanel.Dock="Right" Content="Only changed fields" IsChecked="{Binding ShowChangedFieldsOnly}" VerticalAlignment="Center"
                      ToolTip="Hide the fields that still have the game's value (a copied game row carries many). Untick to see them all."/>
            <TextBlock Text="{Binding FieldsSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </DataTemplate>

    <!-- Under the fields (DataContext: the editor): add a field the game's row has, by plain name,
         with the game's value; or, folded away, any field by name and JSON. -->
    <DataTemplate x:Key="ExmodAddFieldTemplate">
        <Border Padding="10,8" Margin="0,10,0,4" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding AddFieldTitle}" FontWeight="SemiBold" FontSize="12.5"/>
                <StackPanel Visibility="{Binding HasAddableFields, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,6,0,0">
                        <TextBox Text="{Binding AddFieldSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search fields to add"/>
                        <TextBlock Text="Search: weight, stack, durability, slots…" Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="{Binding AddFieldSearch, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding MatchingAddableFields}" SelectedItem="{Binding SelectedAddableField}" MaxHeight="170" Margin="0,4,0,0"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GameText}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                                               MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Add field" Command="{Binding AddGameFieldCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"
                            ToolTip="Adds the picked field to this row with the game's value, ready to change"/>
                </StackPanel>
                <Expander Margin="0,8,0,0" IsExpanded="False" AutomationProperties.Name="Type a field by hand">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Type a field by hand" Style="{StaticResource ExpanderHeaderTitleStyle}" FontSize="12"/>
                            <TextBlock DockPanel.Dock="Left" Text="advanced: a field the game doesn't have" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                        </DockPanel>
                    </Expander.Header>
                    <WrapPanel Margin="0,4,0,0">
                        <Grid Width="160" Margin="0,0,8,4">
                            <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Field name" AutomationProperties.Name="Field name"/>
                            <TextBlock Text="e.g. MaxStack" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding NewFieldName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                        <Grid Width="200" Margin="0,0,8,4">
                            <TextBox Text="{Binding NewFieldValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="JSON value, e.g. 1313 or &quot;text&quot;" AutomationProperties.Name="Field value"/>
                            <TextBlock Text="e.g. 1313 or &quot;text&quot;" Style="{StaticResource PlaceholderTextStyle}"
                                       Visibility="{Binding NewFieldValue, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                        <Button Content="Add" Command="{Binding AddFieldCommand}" Margin="0,0,0,4" ToolTip="Adds this field and value to the selected row"/>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
