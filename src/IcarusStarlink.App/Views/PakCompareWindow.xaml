<Window x:Class="IcarusStarlink.App.Views.PakCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Compare paks" Height="640" Width="980" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Unpacks two .pak files and compares their contents. DataTable JSON is compared row by row and field by field (formatting differences don't count), everything else byte for byte. Differences read as the SECOND pak relative to the first — 'New'/'new item' means only in the second pak, 'Removed' means only in the first."/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="First pak" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="FirstPakBox" Grid.Column="1" Text="{Binding FirstPakPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Usually this app's own staged build (prefilled when one exists)."/>
            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseFirstPakCommand}" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Second pak" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="SecondPakBox" Grid.Column="1" Text="{Binding SecondPakPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. another mod manager's installed merged pak, to verify the two tools produce equivalent output."/>
            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseSecondPakCommand}" Margin="8,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Compare" Command="{Binding CompareCommand}"
                    ToolTip="Extracts both paks to a temporary folder (deleted afterwards) and compares — nothing is modified, this is read-only."/>
            <TextBlock Text="{Binding SummaryMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap" MaxWidth="700"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding ChangedFiles}" SelectedItem="{Binding SelectedFile}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DataGrid Grid.Column="2" ItemsSource="{Binding SelectedFile.Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="140"/>
                    <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="130"/>
                    <DataGridTemplateColumn Header="Change" Width="100" CellTemplate="{StaticResource ChangeKindBadgeTemplate}"/>
                    <DataGridTextColumn Header="Value in first pak" Binding="{Binding OldValueDisplay}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="Value in second pak" Binding="{Binding NewValueDisplay}" Width="*" MinWidth="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="5" Visibility="{Binding HasAssetDifferences, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,12,0,0">
            <TextBlock Text="Other file differences (binary assets, non-DataTable files)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding AssetDifferences}" MaxHeight="120" FontSize="12" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</Window>
