<UserControl x:Class="IcarusStarlink.App.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IcarusStarlink.App.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="SavesResources.xaml"/>
    </UserControl.Resources>

    <Grid Margin="32,32,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Edits Icarus player data. Every save and restore takes a full backup of the slot first, and nothing writes while the game is running — but a manual backup before experimenting is still the smart move."
                   Style="{StaticResource PageBodyTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap" MaxWidth="720"/>

        <!-- Slot picker + backup/restore. The slot picker stays inline (every tab depends on it);
             Backup now/Restore/Open backups folder — real but occasional — collapse into one
             Expander next to it, matching Merge & Install's own "Advanced actions" pattern, so they
             don't compete with the picker for attention on every visit. -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="True">
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" MinWidth="240" Margin="0,0,8,0"
                      ToolTip="Steam player slots found under the game's own PlayerData folder">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Expander IsExpanded="False" HorizontalAlignment="Left" AutomationProperties.Name="Backup and restore">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Backup &amp; restore" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LastBackupDisplay}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                    </DockPanel>
                </Expander.Header>
                <WrapPanel>
                    <Button Command="{Binding BackupNowCommand}" AutomationProperties.Name="Backup now"
                            ToolTip="Zips the whole slot into this app's own save_backups cache — never inside the game's folders">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Backup now" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MinWidth="230" Margin="8,0,0,0"
                              ToolTip="Backups of this slot, newest first">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Restore" Command="{Binding RestoreBackupCommand}" Margin="8,0,0,0"
                            ToolTip="Replaces the slot with the selected backup — writes a pre_restore safety zip of the current state first, so this is itself undoable"/>
                    <Button Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}" Margin="8,0,0,0"/>
                </WrapPanel>
            </Expander>
        </DockPanel>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Overview: character cards + account snapshot, per Icarus Workshop's own save
                 editor layout ("character cards plus account snapshot ... Click a card to edit"). -->
            <TabItem Header="Overview">
                <views:SavesOverviewTab/>
            </TabItem>

            <!-- Characters: edit the selected character + profile currencies (spec: "Profile
                 currencies on the same tab"). -->
            <TabItem Header="Characters">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="160" MaxWidth="420"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GridSplitter Grid.Column="1" Style="{StaticResource VerticalPaneSplitterStyle}" Width="16"
                                  AutomationProperties.Name="Resize character list"/>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" *" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="Unsaved changes"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Act on whichever character is selected above. Duplicate is instant, no
                             confirm (matches ExmodEditorViewModel's own Duplicate) — it only adds
                             data. Delete removes the character's entire progress and confirms first,
                             unlike every other destructive edit on this page (those stay staged in
                             memory until Save's own confirm covers them; a whole character is too
                             big a loss for that). -->
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Command="{Binding DuplicateCharacterCommand}" CommandParameter="{Binding SelectedCharacter}"
                                    AutomationProperties.Name="Duplicate character"
                                    ToolTip="Clones the selected character under a fresh character slot — talents/flags/cosmetics all come along, the name is suffixed '(Copy)'">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteCharacterCommand}" CommandParameter="{Binding SelectedCharacter}"
                                    Margin="8,0,0,0" AutomationProperties.Name="Delete character"
                                    ToolTip="Permanently removes the selected character's entire progress — confirms first">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <!-- Two cards side by side (they wrap on a narrow window): the character's own
                             fields, and the account's currencies; Appearance folded away under them. -->
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left"
                                    Visibility="{Binding SelectedCharacter, Converter={StaticResource NullToVisibilityConverter}}">
                            <WrapPanel>
                                <Border Width="400" Margin="0,0,12,12" Padding="16,12" VerticalAlignment="Top" CornerRadius="6"
                                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Character" Style="{StaticResource ExpanderHeaderTitleStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding SelectedCharacter.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" AutomationProperties.Name="Character name"/>

                                        <TextBlock Text="XP" Style="{StaticResource FieldLabelStyle}"/>
                                        <DockPanel Margin="0,4,0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLevelDisplay}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Visibility="{Binding SelectedLevelDisplay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBox Text="{Binding SelectedCharacter.XpText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="XP"/>
                                        </DockPanel>
                                        <TextBlock Text="Experience points. The game works out the level from this: higher = a higher level."
                                                   Foreground="{DynamicResource FaintForegroundBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="Slot "/><Run Text="{Binding SelectedCharacter.ChrSlot, Mode=OneWay}"/><Run Text=" · Location: "/><Run Text="{Binding SelectedCharacter.LocationDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Width="400" Margin="0,0,12,12" Padding="16,12" VerticalAlignment="Top" CornerRadius="6"
                                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Profile currencies" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="Account-wide: every character shares them. Higher = more to spend in the workshop and on talents; 0 = none." FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Currencies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="190" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12.5" TextAlignment="Right"
                                                                 AutomationProperties.Name="{Binding Label}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Appearance (was its own Cosmetics tab): raw values, folded away. -->
                            <Expander Header="Appearance (raw values)" Margin="0,0,12,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Raw hash values with no known way to map them to option names: useful for copying an exact look from one of your characters to another (read the value here, paste it there)."
                                               Foreground="{DynamicResource FaintForegroundBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Male" IsChecked="{Binding SelectedCharacter.IsMale}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding SelectedCharacter.Cosmetics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3,0,3">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" Width="220" VerticalAlignment="Center" FontSize="12.5"/>
                                                    <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- Talents: character talents searchable with rank editing; workshop research below.
                 Every talent the game defines is available via "Show unlearned" — turning a rank
                 up grants it (rank 0 is the format's own "doesn't have it"). -->
            <!-- Talents: the selected character's talent, blueprint and solo trees, grouped by tree under
                 the game's own names (SaveGameNames.TalentTrees). Workshop research and missions are
                 the account's and have their own tabs. -->
            <TabItem Header="Talents">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="TalentGroups" Source="{Binding FilteredTalents}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Group"/>
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </TabItem.Resources>
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox Width="260" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search talents (name or tree)…"
                                 Text="{Binding TalentSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search talents (name or tree)"/>
                        <TextBlock Text="Show" VerticalAlignment="Center" Margin="14,0,6,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding TalentKindOptions}" SelectedItem="{Binding TalentKind}" Width="110" AutomationProperties.Name="Which trees"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Show unlearned" IsChecked="{Binding ShowUnlearnedTalents}"
                                  Margin="14,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Lists every talent the game defines, not just this character's — set a rank above 0 to grant one"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,2">
                        <Run Text="{Binding SelectedCharacter.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/><Run Text=" · "/><Run Text="{Binding TalentRanksSummary, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- Over budget: more ranks than the installed curves give. -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,6"
                            Visibility="{Binding OverBudgetNote, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding OverBudgetNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <!-- Where the budgets come from: level cap, which curves keep rising, bonuses, mods. -->
                    <Expander DockPanel.Dock="Top" Header="How these points work" Margin="0,0,0,6"
                              Visibility="{Binding HasPointsNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Margin="4,4,0,4" MaxWidth="900" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding PointsNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12" Margin="0,1" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Change points per level: makes the "Starlink Player Points" Library mod. -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding CanChangePoints, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Change points per level" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,6" Foreground="{DynamicResource FaintForegroundBrush}"
                                           Text="Makes a mod in your Library with its own copies of the game's point curves (no game file replaced). 1 = the game's own, 2 = twice as many at every level. Works with Remove Level Cap; the save itself isn't changed."/>
                                <ItemsControl ItemsSource="{Binding PointsEditors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding Label}" Width="80" VerticalAlignment="Center" FontSize="12.5"/>
                                                <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <TextBox Text="{Binding MultiplierText, UpdateSourceTrigger=PropertyChanged}" Width="60" FontFamily="Consolas" AutomationProperties.Name="{Binding Label, StringFormat='{}{0} points multiplier'}"/>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="{Binding KeepRisingLabel}" IsChecked="{Binding KeepRising}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Preview}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Make the mod" Command="{Binding MakePointsModCommand}" Padding="10,3"/>
                                    <Button Content="Turn on and go to Merge &amp; Install" Command="{Binding TurnOnPointsModCommand}" Padding="10,3" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PointsModStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding PointsModStatus, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <!-- Tag: the tab's summary, so each tree's count follows a rank change. -->
                    <ListBox ItemsSource="{Binding Source={StaticResource TalentGroups}}" HorizontalContentAlignment="Stretch" Tag="{Binding TalentRanksSummary}"
                             views:SaveGroupExpansion.Scope="Talents" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemTemplate="{StaticResource SaveTalentRowTemplate}">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource SaveCollapsibleGroupItemStyle}"/>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Workshop: the account's research, grouped by workshop tree, with what it costs. -->
            <TabItem Header="Workshop">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="WorkshopGroups" Source="{Binding FilteredWorkshop}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Group"/>
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </TabItem.Resources>
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox Width="260" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search research…"
                                 Text="{Binding WorkshopSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search research"/>
                        <TextBlock Text="{Binding WorkshopSummary}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Account-wide: every character can buy what's researched here from the Workshop." FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Source={StaticResource WorkshopGroups}}" HorizontalContentAlignment="Stretch" Tag="{Binding WorkshopSummary}"
                             views:SaveGroupExpansion.Scope="Workshop" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemTemplate="{StaticResource SaveTalentRowTemplate}">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource SaveCollapsibleGroupItemStyle}"/>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Missions: the account's completed missions (the profile's Prospect_* entries), by map. -->
            <TabItem Header="Missions">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="MissionGroups" Source="{Binding FilteredMissions}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Group"/>
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </TabItem.Resources>
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox Width="260" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search missions…"
                                 Text="{Binding MissionSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search missions"/>
                        <TextBlock Text="{Binding MissionsSummary}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Only not done" IsChecked="{Binding ShowUndoneMissionsOnly}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"
                               Text="Account-wide. Marking a mission done also turns on the unlock it rewards on the Unlocks tab (a message says which). Ren and Exotics it pays aren't added: change those under Characters. Turning a mission off leaves its reward on, as the game does."/>
                    <ListBox ItemsSource="{Binding Source={StaticResource MissionGroups}}" HorizontalContentAlignment="Stretch" Tag="{Binding MissionsSummary}"
                             views:SaveGroupExpansion.Scope="Missions" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource SaveCollapsibleGroupItemStyle}"/>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2" ToolTip="{Binding RowName}">
                                    <Ellipse Style="{StaticResource ChangedMarkStyle}"/>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsDone}" VerticalAlignment="Center"
                                              Margin="0,0,10,0" AutomationProperties.Name="{Binding DisplayName, StringFormat='Done: {0}'}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- A mission the game's tables don't list shows a readable name with its row id faint beside it. -->
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text="  "/><Run>
                                                <Run.Style>
                                                    <Style TargetType="Run" BasedOn="{StaticResource SaveRawIdRunStyle}">
                                                        <Setter Property="Text" Value="{Binding RowName, Mode=OneWay}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInGameTables}" Value="True">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LinkHint}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding LinkHint, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Source.Label}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource SaveRowSourceStyle}"/>
                                        <TextBlock Text="{Binding PackNote}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Visibility="{Binding PackNote, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Unlocks (was Flags): grouped by what each flag is for (SaveGameNames.FlagInfo, researched
                 2026-10-23 against the game's tables). Mission rewards and bonus talent points are worth
                 editing; markers, prompts and talent-granted flags sit under Advanced; flags the game
                 doesn't use hide unless asked for. -->
            <TabItem Header="Unlocks">
                <views:SavesUnlocksTab/>
            </TabItem>

            <!-- Bestiary: encounter points per creature, from the account-wide BestiaryData.json.
                 Points required to fully unlock a creature's field-guide entry come from the game's
                 own D_BestiaryData table (TotalPointsRequired) — Set max fills that in directly. -->
            <TabItem Header="Bestiary">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="BestiaryGroups" Source="{Binding FilteredBestiaryEntries}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Group"/>
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </TabItem.Resources>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Width="240" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search creatures…"
                                 Text="{Binding BestiarySearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search creatures"/>
                        <TextBlock Text="{Binding BestiarySummary}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Only not complete" IsChecked="{Binding ShowIncompleteBestiaryOnly}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="Complete all shown" Command="{Binding CompleteShownBestiaryCommand}" Padding="10,3" Margin="14,0,0,0"
                                ToolTip="Fills every creature listed right now (after the search and filter) to its full points"/>
                    </WrapPanel>

                    <!-- Tag: the tab's summary, so each biome's count follows a creature completed. -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Source={StaticResource BestiaryGroups}}" HorizontalContentAlignment="Stretch" Tag="{Binding BestiarySummary}"
                             views:SaveGroupExpansion.Scope="Bestiary" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource SaveCollapsibleGroupItemStyle}"/>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="{StaticResource SaveRowMaxWidth}"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                <DockPanel Margin="2">
                                    <Ellipse Style="{StaticResource ChangedMarkStyle}"/>
                                    <!-- Fixed widths so every row's box, "/ max" and button line up. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding PointsText, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="Consolas" TextAlignment="Right"
                                                 AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} points'}"
                                                 ToolTip="Field guide points for this creature. Higher = more of its entry unlocked; the number after the slash completes it."/>
                                        <TextBlock Text="{Binding PointsRequired, StringFormat='/ {0}'}" Width="56" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" FontFamily="Consolas" FontSize="12"/>
                                        <Button Content="Set max" Command="{Binding SetMaxCommand}" Padding="8,2" Margin="4,0,0,0"
                                                ToolTip="Fills in this creature's own TotalPointsRequired — fully unlocks its field-guide entry"/>
                                    </StackPanel>
                                    <!-- Resolved lazily off the base game's own extracted pak content (see
                                         IBaseGameIconDecoder) — collapsed entirely until (if ever) it
                                         resolves, so a row never shows an empty placeholder box. -->
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0" Background="{StaticResource SaveIconTileBrush}" CornerRadius="5"
                                            Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding RowName, Mode=OneWay}" Style="{StaticResource SaveRawIdRunStyle}"/>
                                        </TextBlock>
                                        <TextBlock Text="Boss" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding IsBoss, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Points against the creature's max, for scanning a biome at a glance. -->
                                        <ProgressBar Height="4" MaxWidth="240" Margin="0,4,0,0" BorderThickness="0" Focusable="False"
                                                     Maximum="{Binding PointsRequired, Mode=OneWay}" Value="{Binding EffectivePoints, Mode=OneWay}"
                                                     Visibility="{Binding CanSetMax, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Accolades: from the account-wide Accolades.json, by category. Only CompletedAccolades
                 is editable here — the raw progress counters that make an accolade eligible
                 (PlayerTrackers/PlayerTaskListTrackers) are preserved untouched. A tiered set
                 ("Wolf Killer I" to "V") is one cell with a chip per tier; each chip is still its
                 own accolade (SaveAccoladeLineViewModel). -->
            <TabItem Header="Accolades">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="AccoladeGroups" Source="{Binding FilteredAccolades}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Category"/>
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </TabItem.Resources>
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox Width="260" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search accolades…"
                                 Text="{Binding AccoladeSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search accolades"/>
                        <TextBlock Text="{Binding AccoladesSummary}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Only not earned" IsChecked="{Binding ShowUnearnedAccoladesOnly}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource AccoladeGroups}}" Tag="{Binding AccoladesSummary}" views:SaveGroupExpansion.Scope="Accolades"
                                      Margin="0,0,8,0">
                            <ItemsControl.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource SaveCollapsibleGroupItemStyle}"/>
                            </ItemsControl.GroupStyle>
                            <!-- One cell width for every accolade, so the names line up in columns. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="340"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SaveRowHoverStyle}" Padding="4,3" Margin="0,0,10,1" ToolTip="{Binding Description}">
                                        <DockPanel>
                                            <Ellipse Style="{StaticResource ChangedMarkStyle}"/>
                                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tiers}" Focusable="False" VerticalAlignment="Center"
                                                          Visibility="{Binding IsTiered, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource AccoladeTierChipStyle}" Content="{Binding Label}" IsChecked="{Binding Accolade.IsCompleted}"
                                                                      ToolTip="{Binding Accolade.DisplayName}" AutomationProperties.Name="{Binding Accolade.DisplayName}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Visibility="{Binding IsTiered, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Single.IsCompleted}" AutomationProperties.Name="{Binding Name}"
                                                          Visibility="{Binding Single, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </CheckBox>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Items: the account-wide MetaInventory bank — view + delete only (see
                 SaveInventoryItemViewModel's own doc comment for why per-field editing isn't
                 offered). Real display names resolved through D_ItemsStatic's own Itemable trait
                 reference into D_Itemable, since D_ItemsStatic rows carry no name of their own. -->
            <TabItem Header="Items">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Width="260" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search items…"
                             Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search items"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredMetaInventoryItems}" HorizontalContentAlignment="Stretch"
                             Visibility="{Binding ItemsEmptyText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="{StaticResource SaveRowMaxWidth}"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                <DockPanel Margin="2">
                                    <Button DockPanel.Dock="Right" Content="Delete" Padding="8,2"
                                            Command="{Binding DataContext.DeleteMetaInventoryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat='Delete {0}'}"
                                            ToolTip="Removes this item from the meta bank — nothing else in the bank is touched"/>
                                    <!-- Resolved lazily off the base game's own extracted pak content (see
                                         IBaseGameIconDecoder) — collapsed entirely until (if ever) it
                                         resolves, so a row never shows an empty placeholder box. -->
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0" Background="{StaticResource SaveIconTileBrush}" CornerRadius="5"
                                            Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding RowName, Mode=OneWay}" Style="{StaticResource SaveRawIdRunStyle}"/><Run Text="  "/><Run Text="{Binding WeightDisplay, Mode=OneWay}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/><Run Text="  "/><Run Text="{Binding MaxStackDisplay, Mode=OneWay}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Source.Label}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource SaveRowSourceStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- An empty bank is normal; say what would be here instead of a blank panel. -->
                    <TextBlock Grid.Row="1" Text="{Binding ItemsEmptyText}" Style="{StaticResource EmptyStateTextStyle}"
                               Visibility="{Binding ItemsEmptyText, Converter={StaticResource NullToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Mounts: account-wide, Mounts.json. The list's name and level, and (MountBlob, plan step 4)
                 the mount's own data: its copy of the name, experience to match the level, talents,
                 genetics, lineage and look. Inside editing only for a mount whose data writes back
                 byte for byte; species is never changed. -->
            <TabItem Header="Mounts">
                <views:SavesMountsTab/>
            </TabItem>
            <TabItem Header="Worlds" x:Name="WorldsTab">
                <views:WorldSettingsView DataContext="{Binding WorldSettings}" Margin="0,10,0,0"/>
            </TabItem>
        </TabControl>

        <!-- Save bar: its own row under the tabs (it used to float over the lists), saying what's unsaved. -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Reload" Command="{Binding ReloadCommand}" Padding="10,4" Margin="0,0,8,0"
                    AutomationProperties.Name="Reload save"
                    ToolTip="Reads the save from disk again, for example after you played. Unsaved edits on this page are lost (it asks first)."/>
            <!-- Hidden on the Worlds tab: world settings are a different file with their own Save
                 world settings button, and two save buttons there read as one choice. -->
            <Button Command="{Binding SaveChangesCommand}"
                    IsEnabled="{Binding HasUnsavedChanges}" AutomationProperties.Name="Save player data"
                    ToolTip="Writes your edits into the save — a full backup of the slot is taken automatically first. Refused while Icarus is running. Greyed out: nothing changed yet."
                    ToolTipService.ShowOnDisabled="True">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, ElementName=WorldsTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Save player data" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
            <!-- On the Worlds tab, unsaved player data edits still show (ChangesSummary): this says where they save. -->
            <TextBlock DockPanel.Dock="Right" Text="Player data saves from the other tabs." VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, ElementName=WorldsTab}" Value="True"/>
                                    <Condition Binding="{Binding HasUnsavedChanges}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Left" Text="{Binding ChangesSummary}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Visibility="{Binding ChangesSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding SkippedSectionsNote}" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" FontSize="11"
                           Visibility="{Binding SkippedSectionsNote, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
