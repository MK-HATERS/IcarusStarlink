<UserControl x:Class="IcarusStarlink.App.Views.WeeklyChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="History:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox ItemsSource="{Binding ReportHistory}" SelectedItem="{Binding SelectedReport}"
                      MinWidth="260"
                      ToolTip="This app keeps roughly a month of past Update data folder runs — pick one to see what changed in it">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding Settings.UpdateDataFolderCommand}" Margin="16,0,0,0"
                    ToolTip="Re-extract the game's current data and compare it against last time — same action as Settings' own Update data folder"
                    AutomationProperties.Name="Run update data folder">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Update data folder" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Settings.DataFolderStatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0"
                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding SummaryMessage}" Style="{StaticResource PageBodyTextStyle}" MaxWidth="900" Margin="0,10,0,16"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding ChangedFiles}" SelectedItem="{Binding SelectedFile}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- IsReadOnly is load-bearing, not cosmetic — without it, double-clicking a cell makes
                 WPF try to enter edit mode on a TwoWay binding to a get-only ChangedRowViewModel
                 property, throwing an unhandled InvalidOperationException that crashes the app
                 (confirmed live for the same row type on Library's own IMM Database grid). -->
            <DataGrid Grid.Column="2" ItemsSource="{Binding SelectedFile.Rows}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="140"/>
                    <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="130"/>
                    <DataGridTemplateColumn Header="Change" Width="100" CellTemplate="{StaticResource ChangeKindBadgeTemplate}"/>
                    <!-- Star-sized so the new value stays on screen at the default window size —
                         fixed widths pushed it off the right edge behind a scrollbar, which
                         defeats the point of a before/after grid. -->
                    <DataGridTextColumn Header="Old value" Binding="{Binding OldValueDisplay}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="New value" Binding="{Binding NewValueDisplay}" Width="*" MinWidth="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
