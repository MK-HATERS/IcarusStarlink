<UserControl x:Class="IcarusStarlink.App.Views.ActivityPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:activity="clr-namespace:IcarusStarlink.Core.Activity;assembly=IcarusStarlink.Core"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type activity:ActivityEntry}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Top">
                <Ellipse Width="7" Height="7" Margin="0,5,10,0" VerticalAlignment="Top">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource InfoBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel MaxWidth="220">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:t}'}" FontSize="10"
                               Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,14,16,10">
                <TextBlock Text="Activity" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="THIS SESSION" FontSize="10" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Separator Grid.Row="0" VerticalAlignment="Bottom"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10,14,10"
                          Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Entries}"/>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Text="Nothing yet — actions like Rebuild, Install, and imports will show up here."
                       TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" FontSize="12"
                       Margin="16" VerticalAlignment="Top"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>
