<UserControl x:Class="IcarusStarlink.App.Views.NexusCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- The whole Nexus page: a native mod list driven by the API key saved in Settings. There is
         deliberately no embedded web browser — signing in here as well as in Settings would be a
         second sign-in for the same account, and a native list is what lets this app own the
         search box and show its own "In Library"/"Downloaded"/"Update" badges. Mod pages and any
         non-premium download open in the user's real browser instead (Open page). -->
    <Grid Margin="32,32,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <!-- Same two-row shape as the IMM Database tab: search fills the primary row with the one
             real action (Refresh) docked opposite it; browse mode + display filters get their own
             row below, since they're a different kind of control (what to show vs. an action). -->
        <DockPanel Grid.Row="1" Margin="0,12,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Refresh list">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource AccentForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="Loading…" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search every Icarus mod on Nexus — clear to go back to the lists"/>
                <TextBlock Text="Search all Icarus mods…" Style="{StaticResource PlaceholderTextStyle}"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>
        </DockPanel>

        <!-- WrapPanel, not a fixed row: at a narrower window width the filter toggles would
             otherwise clip off the right edge — the same fix Downloads' own filter row needed. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <TextBlock Text="Browse:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <ListBox ItemsSource="{Binding BrowseKinds}" SelectedItem="{Binding SelectedKind}" VerticalAlignment="Center"
                         Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}"
                         ToolTip="All = every Icarus mod on Nexus, most endorsed first. Trending/Latest/Updated are Nexus's own curated lists (they need a signed-in API key). Clear the search box to use these.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Hide ones you have"
                      IsChecked="{Binding HideOwned}" Margin="0,0,16,4" VerticalAlignment="Center"
                      ToolTip="Hides mods already in your Library or waiting in Pending Downloads — what's left is what you don't have yet"/>
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Updates only"
                      IsChecked="{Binding UpdatesOnly}" Margin="0,0,16,4" VerticalAlignment="Center"
                      ToolTip="Shows only mods whose Nexus version differs from your Library copy's — works best on the All list"/>
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Tracked"
                      IsChecked="{Binding TrackedOnly}" Margin="0,0,16,4" VerticalAlignment="Center"
                      ToolTip="Shows only mods you've tracked — click Track on a card to add one, click again to untrack"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" MaxWidth="420"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320" Margin="0,0,12,12" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="150" Background="{DynamicResource CardRaisedBackgroundBrush}" ClipToBounds="True">
                                    <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- A string URL binds straight to Source — WPF downloads it async itself; a null
                                         or failed URL just leaves the placeholder behind it showing. -->
                                    <Image Source="{Binding Mod.PictureUrl}" Stretch="UniformToFill"/>
                                </Grid>
                                <StackPanel Margin="12,10,12,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Mod.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Mod.Name}"/>
                                        <!-- This machine's own status, computed locally — Nexus's API exposes no
                                             site-notification feed to sync the website's own badges from. -->
                                        <Border Margin="6,0,0,0" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                                Background="{DynamicResource InfoBrush}"
                                                Visibility="{Binding LocalBadge, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding LocalBadge}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                                        </Border>
                                        <Border Margin="4,0,0,0" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                ToolTip="A newer version than your Library copy"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Update" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,1,0,0" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="{Binding Mod.Author, Mode=OneWay}"/><Run Text=" · v"/><Run Text="{Binding Mod.Version, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Mod.DatesDisplay}" Margin="0,1,0,6" FontSize="10.5"
                                               Foreground="{DynamicResource FaintForegroundBrush}"
                                               Visibility="{Binding Mod.DatesDisplay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Mod.Summary}" Style="{StaticResource PageBodyTextStyle}" FontSize="12"
                                               TextWrapping="Wrap" MaxHeight="52" ClipToBounds="True" ToolTip="{Binding Mod.Summary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.DownloadModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Mod}"
                                                ToolTip="Downloads the mod's main file straight into Pending Downloads (needs Nexus Premium — otherwise use Open page's Mod Manager Download)"
                                                AutomationProperties.Name="Download mod">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Download" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Same button toggles Track/Untrack — TrackModCommand checks
                                             watchlist membership itself, so the click always does
                                             the opposite of whatever IsTracked shows right now. -->
                                        <Button Command="{Binding DataContext.TrackModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Mod}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="ToolTip" Value="Add to Downloads' Nexus watchlist, so it's checked for updates"/>
                                                    <Setter Property="AutomationProperties.Name" Value="Track mod"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                            <Setter Property="ToolTip" Value="Stop tracking this mod"/>
                                                            <Setter Property="AutomationProperties.Name" Value="Untrack mod"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconPlus}"/>
                                                            <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}"/>
                                                            <Setter Property="StrokeThickness" Value="1.8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Track"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                    <Setter Property="Text" Value="Tracked"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding DataContext.OpenModPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Mod}"
                                                ToolTip="Open the mod's page in your browser — downloads start there via Mod Manager Download"
                                                AutomationProperties.Name="Open mod page">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Open page" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Real Prev/Next paging, not an ever-appending "Load more" — 229 real mods would be
                 8 clicks deep before this fix, and the list would never stop growing. -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12"
                        Visibility="{Binding PageDisplay, Converter={StaticResource NullToVisibilityConverter}}">
                <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                        Style="{StaticResource IconButtonStyle}" Width="30" ToolTip="Previous page" AutomationProperties.Name="Previous page">
                    <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
                <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="10,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"
                        Style="{StaticResource IconButtonStyle}" Width="30" ToolTip="Next page" AutomationProperties.Name="Next page">
                    <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
