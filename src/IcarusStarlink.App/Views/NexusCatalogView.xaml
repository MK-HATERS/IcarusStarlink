<UserControl x:Class="IcarusStarlink.App.Views.NexusCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:IcarusStarlink.App.Utilities"
             mc:Ignorable="d">

    <!-- The whole Nexus page: a native mod list driven by the API key saved in Settings. There is
         deliberately no embedded web browser — signing in here as well as in Settings would be a
         second sign-in for the same account, and a native list is what lets this app own the
         search box and show its own "In Library"/"Downloaded"/"Update" badges. Mod pages and any
         non-premium download open in the user's real browser instead (Open page). -->
    <Grid Margin="32,32,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <!-- Same two-row shape as the IMM Database tab: search fills the primary row with the one
             real action (Refresh) docked opposite it; browse mode + display filters get their own
             row below, since they're a different kind of control (what to show vs. an action). -->
        <DockPanel Grid.Row="1" Margin="0,12,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Refresh list">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource AccentForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="Loading…" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search every Icarus mod on Nexus — clear to go back to the lists"/>
                <TextBlock Text="Search all Icarus mods…" Style="{StaticResource PlaceholderTextStyle}"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>
        </DockPanel>

        <!-- WrapPanel, not a fixed row: at a narrower window width the filter toggles would
             otherwise clip off the right edge — the same fix Downloads' own filter row needed. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <TextBlock Text="Browse:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <ListBox ItemsSource="{Binding BrowseKinds}" SelectedItem="{Binding SelectedKind}" VerticalAlignment="Center"
                         Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}"
                         ToolTip="All = every Icarus mod on Nexus, most endorsed first. Trending/Latest/Updated are Nexus's own curated lists (they need a signed-in API key). Clear the search box to use these.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Hide ones you have"
                      IsChecked="{Binding HideOwned}" Margin="0,0,16,4" VerticalAlignment="Center"
                      ToolTip="Hides mods already in your Library or on the Downloads page — what's left is what you don't have yet"/>
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Updates only"
                      IsChecked="{Binding UpdatesOnly}" Margin="0,0,16,4" VerticalAlignment="Center"
                      ToolTip="Shows only mods whose Nexus version differs from your Library copy's — works best on the All list"/>
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Tracked"
                      IsChecked="{Binding TrackedOnly}" Margin="0,0,16,4" VerticalAlignment="Center"
                      ToolTip="Shows only mods you've tracked — click Track on a card to add one, click again to untrack"/>
            <!-- Classic IMM's Show New: mods published on Nexus since your last visit. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center"
                        Visibility="{Binding HasNew, Converter={StaticResource BoolToVisibilityConverter}}">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding NewOnly}" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="Shows only mods published since your last visit, newest first, in place of the list">
                    <TextBlock Text="{Binding NewCountDisplay, StringFormat='New only ({0})'}"/>
                </CheckBox>
                <Button Content="Mark all seen" Command="{Binding MarkSeenCommand}" Padding="8,2" VerticalAlignment="Center"
                        ToolTip="Clears the New tags now. They also clear by themselves when you close Starlink after looking here."/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" MaxWidth="420"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </WrapPanel>

        <!-- Visible, non-tooltip warning — a real bug found live: Download here can never succeed
             for a non-Premium account (see NexusCatalogViewModel.IsPremium's own doc comment), but
             nothing said so until AFTER clicking it and getting a rejection. Only shown once a
             saved key is confirmed non-Premium — stays hidden while signed out or unconfirmed, so
             it never wrongly implies an account isn't Premium on a network hiccup. -->
        <Border Grid.Row="3" Margin="0,0,0,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource InfoBrush}"
                Visibility="{Binding IsKnownNonPremium, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WindowBackgroundBrush}" FontSize="12.5">
                <Run Text="Free Nexus account — " FontWeight="SemiBold"/>
                <Run Text="Download here only works for Nexus Premium members. Use each mod's "/>
                <Run Text="Open page" FontWeight="SemiBold"/>
                <Run Text=" button instead — its own Mod Manager Download works for every account."/>
            </TextBlock>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Equal columns that fill the width; each row is as tall as its tallest card. -->
                        <utilities:CardGridPanel MinColumnWidth="330" Spacing="12" Margin="0,0,4,12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <!-- DockPanel so the button row sits on the card's bottom edge and lines up
                                 across a row whatever the description's length. -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Height="150" Background="{DynamicResource CardRaisedBackgroundBrush}" ClipToBounds="True">
                                    <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- A string URL binds straight to Source — WPF downloads it async itself; a null
                                         or failed URL just leaves the placeholder behind it showing. -->
                                    <Image Source="{Binding Mod.PictureUrl}" Stretch="UniformToFill"/>

                                    <!-- This machine's own status, computed locally — Nexus's API exposes no
                                         site-notification feed to sync the website's own badges from. Overlaid
                                         on the thumbnail's own top-left corner (a drop shadow keeps them legible
                                         over a bright image) rather than sitting inline with the title below —
                                         the same corner-chip convention a media card typically uses for "you
                                         already have this," so it reads at a glance without competing with the
                                         title text for room. -->
                                    <StackPanel Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <!-- New / Updated since your last visit. -->
                                        <Border Margin="0,0,0,4" CornerRadius="8" Padding="6,2" Background="{DynamicResource SuccessBrush}"
                                                ToolTip="Published or updated on Nexus since your last visit"
                                                Visibility="{Binding NewTag, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                                            </Border.Effect>
                                            <TextBlock Text="{Binding NewTag}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                                        </Border>
                                        <Border CornerRadius="8" Padding="6,2" Background="{DynamicResource InfoBrush}"
                                                Visibility="{Binding LocalBadge, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                                            </Border.Effect>
                                            <TextBlock Text="{Binding LocalBadge}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                                        </Border>
                                        <Border Margin="0,4,0,0" CornerRadius="8" Padding="6,2" Background="{DynamicResource AccentBrush}"
                                                ToolTip="A newer version than your Library copy"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                                            </Border.Effect>
                                            <TextBlock Text="Update" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="12,10,12,10">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}"/>
                                    <TextBlock Margin="0,1,0,0" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="{Binding Mod.Author, Mode=OneWay}"/><Run Text=" · v"/><Run Text="{Binding Mod.Version, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Mod.DatesDisplay}" Margin="0,1,0,6" FontSize="10.5"
                                               Foreground="{DynamicResource FaintForegroundBrush}"
                                               Visibility="{Binding Mod.DatesDisplay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <!-- Three whole lines, then an ellipsis: a fixed line height makes MaxHeight
                                         land on a line boundary, so WPF trims the last line instead of cutting it. -->
                                    <TextBlock Text="{Binding Mod.Summary}" Style="{StaticResource PageBodyTextStyle}" FontSize="12"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="51"
                                               ToolTip="{Binding Mod.Summary}"/>
                                </StackPanel>
                                <!-- Pinned to the card's bottom edge so the row lines up across the grid.
                                     The small icon buttons (changelog, rename) sit at the right end of the
                                     same row instead of wrapping onto a line of their own. -->
                                <DockPanel Grid.Row="3" Margin="12,0,8,8" LastChildFill="True" VerticalAlignment="Bottom">
                                    <Button DockPanel.Dock="Right" Margin="4,0,0,4" Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DataContext.ShowChangelogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Mod}"
                                            ToolTip="Show this mod's changelog for its current version"
                                            AutomationProperties.Name="Show changelog">
                                        <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Margin="4,0,0,4" Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DataContext.RenameTrackedEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsTracked, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Rename this tracked entry (local only — doesn't touch anything on Nexus)"
                                            AutomationProperties.Name="Rename tracked entry">
                                        <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <WrapPanel VerticalAlignment="Center">
                                            <Button Margin="0,0,8,4"
                                                    Command="{Binding DataContext.DownloadModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Mod}"
                                                    AutomationProperties.Name="Download mod">
                                                <Button.Style>
                                                    <!-- A real bug found live: Download here can never succeed for a confirmed non-Premium
                                                         account (see NexusCatalogViewModel.IsPremium's own doc comment) — disabling it instead
                                                         of leaving it clickable-but-doomed, with the working alternative explained right in the
                                                         tooltip instead of only after a failed click. -->
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="ToolTip" Value="Downloads the mod and adds it to your Library (it's listed on the Downloads page too) — needs a Nexus Premium account"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsKnownNonPremium, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="ToolTip" Value="Not available on a free account — use Open page instead (its own Mod Manager Download button works for every account)"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Download" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- Same button toggles Track/Untrack — TrackModCommand checks
                                                 watchlist membership itself, so the click always does
                                                 the opposite of whatever IsTracked shows right now. -->
                                            <Button Command="{Binding DataContext.TrackModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Mod}" Margin="0,0,8,4"
                                                    AutomationProperties.Name="{Binding IsTracked, Converter={StaticResource TrackedAutomationNameConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="ToolTip" Value="Track this mod, so the Tracked switch above can show just the mods you follow"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                <Setter Property="ToolTip" Value="Stop tracking this mod"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource IconPlus}"/>
                                                                <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}"/>
                                                                <Setter Property="StrokeThickness" Value="1.8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Track"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                        <Setter Property="Text" Value="Tracked"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,0,4"
                                                    Command="{Binding DataContext.OpenModPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Mod}"
                                                    AutomationProperties.Name="Open mod page">
                                                <Button.Style>
                                                    <!-- Promoted to the same look Download normally has, once a confirmed non-Premium
                                                         account means this is genuinely the one button that will actually work here. -->
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="ToolTip" Value="Open the mod's page in your browser — downloads start there via Mod Manager Download"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsKnownNonPremium, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="ToolTip" Value="Open the mod's page in your browser — click its Mod Manager Download button there, it works on a free account"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Open page" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Real Prev/Next paging, not an ever-appending "Load more" — 229 real mods would be
                 8 clicks deep before this fix, and the list would never stop growing. -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12"
                        Visibility="{Binding IsPagingShown, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                        Style="{StaticResource IconButtonStyle}" Width="30" ToolTip="Previous page" AutomationProperties.Name="Previous page">
                    <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
                <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="10,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"
                        Style="{StaticResource IconButtonStyle}" Width="30" ToolTip="Next page" AutomationProperties.Name="Next page">
                    <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Says why the grid is empty (loading, nothing matched, needs a key) right where the cards would be. -->
        <TextBlock Grid.Row="4" Text="{Binding EmptyStateText}" Style="{StaticResource EmptyStateTextStyle}"
                   Visibility="{Binding EmptyStateText, Converter={StaticResource NullToVisibilityConverter}}"/>
    </Grid>
</UserControl>
