<UserControl x:Class="IcarusStarlink.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="32,32,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <!-- Tabbed like Downloads/Saves/Library — one topic per tab instead of one long scroll. -->
        <TabControl Grid.Row="1">

            <!-- ===================== Game & tools ===================== -->
            <TabItem Header="Game &amp; tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="The Icarus install and the UnrealPak tool used to build mod paks."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,12"/>

                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="Game folder and UnrealPak">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Game folder &amp; UnrealPak" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="{Binding SavedMessage}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Text="Icarus Content folder (…\Icarus\Icarus\Content)" Style="{StaticResource FieldLabelStyle}"/>
                        <DockPanel Margin="0,6,0,20">
                            <Button Command="{Binding BrowseIcarusContentFolderCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Browse">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AutoDetectIcarusContentFolderCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                    ToolTip="Looks for Icarus through your own Steam install (registry + library folders) and fills this in if found"
                                    AutomationProperties.Name="Auto-detect">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Auto-detect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding IcarusContentPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="UnrealPak.exe path" Style="{StaticResource FieldLabelStyle}"/>
                        <DockPanel Margin="0,6,0,8">
                            <Button Command="{Binding BrowseUnrealPakExeCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Browse">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding UnrealPakExePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Command="{Binding InstallBundledUnrealPakCommand}" IsEnabled="{Binding CanInstallBundledUnrealPak}"
                                    Content="{Binding InstallUnrealPakButtonLabel}"
                                    ToolTip="Installs UnrealPak 4.27 (the UE4 version Icarus itself uses) into Tools\UnrealPak next to the exe — from a copy shipped with this app if there is one, else downloaded fresh. Reinstalling repairs a broken copy. A newer UnrealPak is deliberately NOT offered: UE5 builds write pak formats Icarus's engine can't load."
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Check" Command="{Binding VerifyUnrealPakCommand}" Margin="8,0,0,0"
                                    ToolTip="Actually runs the configured UnrealPak.exe to confirm it works, and reports its engine version"/>
                            <TextBlock Text="{Binding UnrealPakStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"
                                       Visibility="{Binding UnrealPakStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <TextBlock Text="{Binding SavedMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                        </StackPanel>
                        </StackPanel>
                        </Expander>

                        <!-- The "Icarus has been updated" alert stays outside the Expander, always
                             visible regardless of collapse state — a real actionable warning, not
                             routine status. -->
                        <TextBlock Text="{Binding GameDataOutdatedMessage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="2,0,0,10" HorizontalAlignment="Left"
                                   Visibility="{Binding GameDataOutdatedMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Collapsed by default (redesign-round-2 pilot) — a routine "set it and
                             forget it" action for most users, re-opened only when Icarus actually
                             updates. -->
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" IsExpanded="False" AutomationProperties.Name="Refresh game data">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Refresh game data (after every Icarus update)" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DataFolderSummary}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Extracts the game's current DataTable JSON (Content\Data\data.pak) so merge/edit works against up-to-date data. Re-run this after a game update."
                                           Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Command="{Binding UpdateDataFolderCommand}" AutomationProperties.Name="Refresh game data">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Refresh game data" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ViewWeeklyChangesCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding HasWeeklyChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Jump to the Weekly Changes page to see exactly what changed"
                                            AutomationProperties.Name="View Weekly Changes">
                                        <TextBlock Text="View Weekly Changes →" VerticalAlignment="Center"/>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding DataFolderStatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Visibility="{Binding DataFolderStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Migrate from IMM ===================== -->
            <TabItem Header="Migrate from IMM">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="Migrate from classic IMM">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Migrate from classic IMM" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="One-time copy of your mods and merge list" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Text="Already using Jimk72's Icarus Mod Manager? Pick its merged mod list and everything comes across in one go: each mod is copied out of IMM's own folder into your Library, linked to the mod database or Nexus where that can be worked out, and your merge list is rebuilt in Merge &amp; Install in the same order — nothing to re-pick by hand. Classic IMM's own files are only read, never changed."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14" MaxWidth="600"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button Command="{Binding BrowseImmFolderCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Browse IMM folder">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <TextBox Text="{Binding ImmFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional — leave empty and this is worked out from wherever the mod list you pick lives. Set it if your IMM install is somewhere else."/>
                                <TextBlock Text="IMM's install folder, e.g. C:\Icarus Software — where IcarusModManager.exe lives (optional)"
                                           Style="{StaticResource PlaceholderTextStyle}"
                                           Visibility="{Binding ImmFolderPath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,10">
                            <!-- Named differently from Merge & Install's own "Import IMM mod list…" on
                                 purpose — that one only rebuilds the queue from mods already in your
                                 Library; this one is the fuller one-time migration, copying the mods
                                 themselves out of classic IMM's own folder first. Identical labels on
                                 two different actions was a real, reported point of confusion. -->
                            <Button Command="{Binding ImportImmModListCommand}" IsEnabled="{Binding CanMigrateFromImm}"
                                    AutomationProperties.Name="Migrate mods and mod list"
                                    ToolTip="Copies each mod out of classic IMM's own folder into your Library, then rebuilds your merge list in Merge &amp; Install — a one-time full migration, not just a queue re-sync. Pick LastMergedMods.txt from your classic IMM folder (or the IMM_Merged_Mod.txt next to the pak it installed into your game)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Migrate mods + mod list…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding MigrationStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding MigrationResults}" MaxHeight="180" FontSize="12"
                                 Visibility="{Binding HasMigrationResults, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Nexus ===================== -->
            <TabItem Header="Nexus">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="One sign-in powers everything Nexus in this app: browsing on the Nexus page, update checks for tracked mods, and direct downloads."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,12"/>

                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="Nexus account">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Account" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="{Binding NexusSignedInAs, StringFormat='Signed in as {0}', TargetNullValue='Not signed in'}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <StackPanel Visibility="{Binding NexusSignedInAs, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                            <!-- Real users have reported not knowing where to find this — the API Access
                                 page shows OAuth application connections first, with the actual key this
                                 app needs (the "Personal API Key") further down, easy to miss on a page
                                 that otherwise looks like it's for something else entirely. Spelled out
                                 step-by-step rather than left to the button/tooltip alone. -->
                            <TextBlock Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="Click "/><Run Text="Get API key…" FontWeight="SemiBold"/><Run Text=" below, then on that page scroll all the way down to "/><Run Text="Personal API Key" FontWeight="SemiBold"/><Run Text=" (past the OAuth application list near the top — that's a different thing). Click "/><Run Text="request an API key" FontStyle="Italic"/><Run Text=" if you don't have one yet, or copy your existing one, and paste it below."/>
                            </TextBlock>
                            <DockPanel Margin="0,0,0,8">
                                <Button Command="{Binding OpenNexusApiKeyPageCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        ToolTip="Opens your Nexus account's API Access page in your browser" AutomationProperties.Name="Get API key">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Get API key…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding NexusApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Paste your Nexus Personal API Key here (from the bottom of the API Access page, not an OAuth application key)"/>
                            </DockPanel>
                            <Button Content="Authorize" Command="{Binding AuthorizeNexusCommand}" HorizontalAlignment="Left"
                                    IsEnabled="{Binding CanAuthorizeNexus}"
                                    ToolTip="Validates the key with Nexus itself and, if it's accepted, saves it to Windows Credential Manager"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding NexusSignedInAs, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Signed in as "/><Run Text="{Binding NexusSignedInAs, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Content="Sign out" Command="{Binding SignOutNexusCommand}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding NexusStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Visibility="{Binding NexusStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>

                        <!-- Optional and set once, so it folds away once registered; open while it isn't,
                             so Register is in plain sight (folded, it read as "Register is gone").
                             The header says whether it's set up. -->
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" IsExpanded="{Binding IsNxmProtocolNotRegistered, Mode=OneWay}" AutomationProperties.Name="Download handler">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Download handler (nxm:// links)" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="{Binding NxmHandlerHeaderState}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Text="Makes Nexus's own &quot;Mod Manager Download&quot; buttons open IcarusStarlink directly, landing files on the Downloads page, where they install by themselves. Optional — you can always download from this app's own Nexus page instead."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,4,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsNxmProtocolNotRegistered, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Command="{Binding RegisterNxmProtocolCommand}"
                                    ToolTip="Writes a per-user registry entry (no admin rights needed) so nxm:// links launch IcarusStarlink — asks for confirmation first"
                                    AutomationProperties.Name="Register">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding NxmRegisterButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Windows keeps one nxm:// handler for every game, and other mod managers take it
                             when they start (user report 2026-10-23). NxmHandlerWatch acts on this. -->
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Take them back automatically"
                                  IsChecked="{Binding KeepNxmHandler}" Margin="0,0,0,8" HorizontalAlignment="Left"
                                  ToolTip="When another mod manager takes Nexus download links, Starlink takes them back when it starts or you switch to it. Links for that manager's own games are still passed on to it."/>
                        <TextBlock Text="Links for other games are passed on to your other mod managers, so they keep working. Starlink lists each one it replaced below."
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,8"/>

                        <!-- Routing: game -> app. Empty while Starlink has replaced nobody. -->
                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding HasNxmOtherApps, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Links for other games" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="Games: the name after nexusmods.com/ in the game's Nexus link (crimsondesert, stalker2heartofchornobyl), separated by commas. A game nobody lists goes to the app marked (others)."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding NxmOtherApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4" MaxWidth="560" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*" MinWidth="200"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ExePath}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                <TextBlock Text=" (others)" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           Visibility="{Binding GetsUnclaimedGames, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Games, UpdateSourceTrigger=LostFocus}" Margin="6,0"
                                                     AutomationProperties.Name="Games for this app"
                                                     ToolTip="This app's Nexus games, e.g. crimsondesert — its links are passed to it"/>
                                            <Button Grid.Column="2" Content="Remove"
                                                    Command="{Binding DataContext.RemoveNxmOtherAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Stop passing links to this app (it's added again if it takes the links later)"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsNxmProtocolRegisteredToThisApp, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Registered to this app." VerticalAlignment="Center"/>
                            <Button Content="Unregister" Command="{Binding UnregisterNxmProtocolCommand}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding NxmProtocolStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560"
                                   Visibility="{Binding NxmProtocolStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== UE4SS ===================== -->
            <TabItem Header="UE4SS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="UE4SS is Icarus's separate Lua/scripting mod framework (Binaries\Win64) — installing/updating it is unrelated to the EXMOD/pak system. Your existing mods and settings are never overwritten."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,12"/>
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="UE4SS loader">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="UE4SS loader" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="{Binding Ue4ssStatusText}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding InstallOrUpdateUe4ssCommand}"
                                    IsEnabled="{Binding CanInstallOrUpdateUe4ss}"
                                    ToolTip="Installs the UE4SS dev build that comes with Starlink (or a newer one Check for update found on GitHub) into Binaries\Win64. Backs up what's there first and asks before writing anything."
                                    AutomationProperties.Name="{Binding Ue4ssInstallButtonLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Ue4ssInstallButtonLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding UninstallUe4ssCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanUninstallUe4ss}"
                                    Visibility="{Binding IsUe4ssInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Removes the UE4SS loader completely (dwmapi.dll + the ue4ss folder). Your own mods are moved back to this app's staging first, everything removed is backed up, and Icarus's own files are never touched. Asks for confirmation."
                                    AutomationProperties.Name="Uninstall UE4SS">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Uninstall UE4SS" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Install from zip…" Command="{Binding InstallUe4ssFromZipCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanInstallOrUpdateUe4ss}"
                                    ToolTip="Install a UE4SS release zip you downloaded yourself, for a specific build or a PC without internet"/>
                            <Button Content="Check for update" Command="{Binding CheckForUe4ssUpdateCommand}" Margin="8,0,0,0"
                                    ToolTip="Asks GitHub for the newest UE4SS dev build and says whether it is newer than yours. Only runs when you press it (or the app's own Check for updates); nothing is installed until you choose to."/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Ue4ssStatusText}" TextWrapping="Wrap" Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                        <TextBlock Text="{Binding Ue4ssStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,6,0,0"
                                   Visibility="{Binding Ue4ssStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== UE4SS config ===================== -->
            <TabItem Header="UE4SS config" DataContext="{Binding Ue4ssConfig}">
                <DockPanel Margin="0,14,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Change UE4SS-settings.ini for your game or one of your servers. Saving only changes the settings you edit (every comment stays), backs the file up first, and UE4SS reads it when the game or server starts."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding NoTargetsText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Visibility="{Binding HasNoTargets, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <!-- Reload stays visible with no targets: it's how a UE4SS installed since finds its file. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                        Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Edit" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name" MinWidth="220"
                                          AutomationProperties.Name="Which UE4SS settings to edit"/>
                            </StackPanel>
                            <Button Content="Reload" Command="{Binding RefreshTargetsCommand}"
                                    ToolTip="Read the files again (and find a UE4SS or servers added since)"/>
                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="16,0,0,0"
                                     ToolTip="Show only settings whose name or description contains this"
                                     AutomationProperties.Name="Filter settings"
                                     Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasOtherTargets, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,8">
                                <TextBlock Text="Also save these changes to" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ItemsControl ItemsSource="{Binding AlsoSaveTo}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Target.Name}" IsChecked="{Binding IsChecked}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                      ToolTip="Only the settings you changed are written there; its other settings stay as they are"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="Writes the changed settings (backs the old file up to Backups\UE4SS-Settings first)"/>
                                <Button Content="Discard changes" Command="{Binding DiscardChangesCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One folding section per [Section] of the ini, open by default; fold
                                         the ones you don't need to get to the rest faster. -->
                                    <Expander IsExpanded="True" Margin="0,0,8,10" AutomationProperties.Name="{Binding Name}">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                            </DockPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="230"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="  changed" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DefaultText}" FontSize="11" Foreground="{DynamicResource FaintForegroundBrush}"/>
                                                                <Button Content="Reset to default" Command="{Binding ResetToDefaultCommand}" Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" FontSize="11"
                                                                        Visibility="{Binding CanResetToDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Grid Grid.Column="1" VerticalAlignment="Top">
                                                            <CheckBox IsChecked="{Binding IsOn}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Left"
                                                                      AutomationProperties.Name="{Binding Key}"
                                                                      Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <ComboBox ItemsSource="{Binding Choices}" Text="{Binding Value}" IsEditable="True"
                                                                      AutomationProperties.Name="{Binding Key}"
                                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="{Binding Key}"
                                                                     Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ===================== Maintenance ===================== -->
            <TabItem Header="Maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="App updates">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="App updates" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Style="{StaticResource ExpanderHeaderStateStyle}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="v{0} · {1} channel">
                                                <Binding Path="InstalledAppVersion" Mode="OneWay"/>
                                                <Binding Path="UpdateChannel" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Margin="0,0,0,10">
                            <Run Text="You have v"/><Run Text="{Binding InstalledAppVersion, Mode=OneWay}"/><Run Text=" installed."/>
                        </TextBlock>

                        <!-- Beta: also betas (GitHub prereleases). Stable while on a beta offers the newest stable to switch back. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Update channel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding UpdateChannelOptions}" SelectedItem="{Binding UpdateChannel}" Width="110"
                                      AutomationProperties.Name="Update channel"
                                      ToolTip="Stable: finished releases only. Beta: also test versions before they're released (they may have bugs). Switching back to Stable offers the newest stable version."/>
                            <TextBlock Text="Beta also offers test versions; Stable switches you back." Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StableUpdateSourceText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <CheckBox Content="Check for updates when Starlink starts" IsChecked="{Binding AutoCheckAppUpdates}" Margin="0,0,0,10"
                                  ToolTip="Looks on this channel each time Starlink starts and asks before installing anything. On a beta, it also tells you when a stable release is ready."/>

                        <WrapPanel>
                            <Button Command="{Binding CheckForAppUpdatesCommand}" IsEnabled="{Binding CanCheckForAppUpdates}" AutomationProperties.Name="Check for updates">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding UpdateNowCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsAppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Downloads the new version and installs it in place — the app closes, updates itself, and reopens. Your mods, profiles, and settings are never touched."
                                    AutomationProperties.Name="Update now">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Update now" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Open release page" Command="{Binding OpenLatestReleasePageCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsAppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="The manual fallback — opens the release's GitHub page in your browser instead"/>
                            <Button Content="View all releases" Command="{Binding OpenReleasesPageCommand}" Margin="8,0,0,0"
                                    ToolTip="Opens the repo's own Releases page on GitHub — every version, with its notes, always available regardless of whether a check has run"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding AppUpdateStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Visibility="{Binding AppUpdateStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="Diagnostics and safety">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Diagnostics &amp; safety" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="Logs and a diagnostics zip for bug reports" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Text="Starlink always keeps a basic log of what you did and what happened (at most 5 MB a file, the newest 14 files). If you run into a bug, export a diagnostics zip (logs + sanitized settings, never API keys or tokens) to attach to your report."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Advanced log" IsChecked="{Binding AdvancedLogging}" Margin="0,0,0,10"
                                  ToolTip="Off (Basic): the log records what you did and what happened: imports, merges, installs, fixes, warnings and errors. On (Advanced): also every detail, such as each fix made to a mod, the merge order and conflict picks, and every web request. Turn it on to chase a bug: it switches itself back to Basic after 24 hours. Takes effect at once. Either way each file stops at 5 MB and only the newest 14 are kept, so the logs never bloat."/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Performance tracking" IsChecked="{Binding PerformanceTrackingEnabled}" Margin="0,0,0,10"
                                  ToolTip="Off by default. When on, logs how long Rebuild/Install/catalog-refresh take to a separate app.perf log file — useful if something feels slow and you want to show real numbers in a bug report."/>
                        <WrapPanel>
                            <Button Command="{Binding ExportDiagnosticsCommand}" AutomationProperties.Name="Export diagnostics zip">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Export diagnostics zip…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0"
                                    ToolTip="Opens the folder with the log files (icarusstarlink-date.log)"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DiagnosticsStatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"
                                   Visibility="{Binding DiagnosticsStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="Backups">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Backups" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="{Binding BackupsSizeText}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Text="Starlink backs up your mods, the merged pak and your server before changing them. Clean up backups keeps the newest 2 of each and deletes the rest."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BackupsSizeText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Clean up backups" Command="{Binding CleanUpBackupsCommand}" AutomationProperties.Name="Clean up backups"
                                    ToolTip="Keeps the newest 2 backups of each mod, the merged pak and each server, and deletes older ones. The newest backup of anything is never deleted."/>
                        </StackPanel>
                        <TextBlock Text="{Binding BackupsStatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"
                                   Visibility="{Binding BackupsStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Appearance ===================== -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" AutomationProperties.Name="Messages">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Messages" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="Pop-ups under the bell" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Show pop-up messages" IsChecked="{Binding ShowPopUpMessages}" HorizontalAlignment="Left"
                                      ToolTip="When something finishes or goes wrong (a merge, an import, a save), a small message pops up under the bell for a few seconds. Click one to close it; hold the mouse over it to keep it. Everything is still listed under the bell either way."/>
                        </Expander>
                        <!-- The skin editor is two dozen colour boxes most people never touch, so it
                             folds away under its own heading instead of filling the tab. -->
                        <Expander Style="{StaticResource SectionCardExpanderStyle}" IsExpanded="False" AutomationProperties.Name="Custom skin">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Custom skin" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock Text="Your own colours for the Custom theme" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                        <StackPanel>
                        <TextBlock Text="Make the app look however you want: edit any color below (hex, #RRGGBB or #AARRGGBB with transparency), then Save skin. Pick the Custom theme in the top-right corner to use it. The skin lives in a plain JSON file you can also edit by hand or share."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14" MaxWidth="640"/>

                        <ItemsControl ItemsSource="{Binding SkinTokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" Margin="8,0"
                                                   ToolTip="{Binding Key}" TextTrimming="CharacterEllipsis"/>
                                        <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Width="96"
                                                 FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Save skin" Command="{Binding SaveSkinCommand}"
                                    ToolTip="Saves these colors to the skin file — applied immediately if the Custom theme is active"/>
                            <Button Content="Copy Icarus" Command="{Binding CopyThemeIntoSkinCommand}" CommandParameter="Icarus" Margin="8,0,0,0"
                                    ToolTip="Fill the boxes from the Icarus theme's values as a starting point (nothing saved until Save skin)"/>
                            <Button Content="Copy Dark" Command="{Binding CopyThemeIntoSkinCommand}" CommandParameter="Dark" Margin="8,0,0,0"
                                    ToolTip="Fill the boxes from the Dark theme's values as a starting point (nothing saved until Save skin)"/>
                            <Button Content="Copy Light" Command="{Binding CopyThemeIntoSkinCommand}" CommandParameter="Light" Margin="8,0,0,0"
                                    ToolTip="Fill the boxes from the Light theme's values as a starting point (nothing saved until Save skin)"/>
                            <Button Content="Open skin file" Command="{Binding OpenSkinFileCommand}" Margin="8,0,0,0"
                                    ToolTip="Opens the skin's own JSON file for hand-editing or sharing"/>
                            <Button Content="Reload skin file" Command="{Binding ReloadSkinFileCommand}" Margin="8,0,0,0"
                                    ToolTip="Re-reads the file into this editor after hand-editing it"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding SkinStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="640" Margin="0,6,0,0"
                                   Visibility="{Binding SkinStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
