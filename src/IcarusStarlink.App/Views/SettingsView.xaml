<UserControl x:Class="IcarusStarlink.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="32,32,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <!-- Tabbed like Downloads/Saves/Library — one topic per tab instead of one long scroll. -->
        <TabControl Grid.Row="1">

            <!-- ===================== Game & tools ===================== -->
            <TabItem Header="Game &amp; tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="The Icarus install and the UnrealPak tool used to build mod paks."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14"/>

                        <TextBlock Text="Icarus Content folder (…\Icarus\Icarus\Content)" Style="{StaticResource FieldLabelStyle}"/>
                        <DockPanel Margin="0,6,0,20">
                            <Button Command="{Binding BrowseIcarusContentFolderCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Browse">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AutoDetectIcarusContentFolderCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                    ToolTip="Looks for Icarus through your own Steam install (registry + library folders) and fills this in if found"
                                    AutomationProperties.Name="Auto-detect">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Auto-detect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding IcarusContentPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="UnrealPak.exe path" Style="{StaticResource FieldLabelStyle}"/>
                        <DockPanel Margin="0,6,0,8">
                            <Button Command="{Binding BrowseUnrealPakExeCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Browse">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding UnrealPakExePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Command="{Binding InstallBundledUnrealPakCommand}" IsEnabled="{Binding CanInstallBundledUnrealPak}"
                                    Content="{Binding InstallUnrealPakButtonLabel}"
                                    ToolTip="Installs UnrealPak 4.27 (the UE4 version Icarus itself uses) into Tools\UnrealPak next to the exe — from a copy shipped with this app if there is one, else downloaded fresh. Reinstalling repairs a broken copy. A newer UnrealPak is deliberately NOT offered: UE5 builds write pak formats Icarus's engine can't load."
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Check" Command="{Binding VerifyUnrealPakCommand}" Margin="8,0,0,0"
                                    ToolTip="Actually runs the configured UnrealPak.exe to confirm it works, and reports its engine version"/>
                            <TextBlock Text="{Binding UnrealPakStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"
                                       Visibility="{Binding UnrealPakStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <TextBlock Text="{Binding SavedMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                        </StackPanel>

                        <!-- The "Icarus has been updated" alert stays outside the Expander, always
                             visible regardless of collapse state — a real actionable warning, not
                             routine status. -->
                        <TextBlock Text="{Binding GameDataOutdatedMessage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,10"
                                   Visibility="{Binding GameDataOutdatedMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Collapsed by default (redesign-round-2 pilot) — a routine "set it and
                             forget it" action for most users, re-opened only when Icarus actually
                             updates. -->
                        <Expander IsExpanded="False" AutomationProperties.Name="Update data folder">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Update data folder" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DataFolderSummary}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Extracts the game's current DataTable JSON (Content\Data\data.pak) so merge/edit works against up-to-date data. Re-run this after a game update."
                                           Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding UpdateDataFolderCommand}" AutomationProperties.Name="Run update data folder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Update data folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding DataFolderStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                                    <Button Command="{Binding ViewWeeklyChangesCommand}" Margin="10,0,0,0"
                                            Visibility="{Binding HasWeeklyChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Jump to the Weekly Changes page to see exactly what changed"
                                            AutomationProperties.Name="View Weekly Changes">
                                        <TextBlock Text="View Weekly Changes →" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Migrate from IMM ===================== -->
            <TabItem Header="Migrate from IMM">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Already using Jimk72's Icarus Mod Manager? Pick its merged mod list and everything comes across in one go: each mod is copied out of IMM's own folder into your Library, linked to the mod database or Nexus where that can be worked out, and your merge list is rebuilt in Merge &amp; Install in the same order — nothing to re-pick by hand. Classic IMM's own files are only read, never changed."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14" MaxWidth="600"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button Command="{Binding BrowseImmFolderCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Browse IMM folder">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <TextBox Text="{Binding ImmFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional — leave empty and this is worked out from wherever the mod list you pick lives. Set it if your IMM install is somewhere else."/>
                                <TextBlock Text="IMM's install folder, e.g. C:\Icarus Software — where IcarusModManager.exe lives (optional)"
                                           Style="{StaticResource PlaceholderTextStyle}"
                                           Visibility="{Binding ImmFolderPath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Named differently from Merge & Install's own "Import IMM mod list…" on
                                 purpose — that one only rebuilds the queue from mods already in your
                                 Library; this one is the fuller one-time migration, copying the mods
                                 themselves out of classic IMM's own folder first. Identical labels on
                                 two different actions was a real, reported point of confusion. -->
                            <Button Command="{Binding ImportImmModListCommand}" IsEnabled="{Binding CanMigrateFromImm}"
                                    AutomationProperties.Name="Migrate mods and mod list"
                                    ToolTip="Copies each mod out of classic IMM's own folder into your Library, then rebuilds your merge list in Merge &amp; Install — a one-time full migration, not just a queue re-sync. Pick LastMergedMods.txt from your classic IMM folder (or the IMM_Merged_Mod.txt next to the pak it installed into your game)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Migrate mods + mod list…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding MigrationStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding MigrationResults}" MaxHeight="180" FontSize="12"
                                 Visibility="{Binding HasMigrationResults, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Nexus ===================== -->
            <TabItem Header="Nexus">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="One sign-in powers everything Nexus in this app: browsing on the Nexus page, update checks for tracked mods, and direct downloads."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14"/>

                        <TextBlock Text="Account" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                        <StackPanel Visibility="{Binding NexusSignedInAs, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                            <DockPanel Margin="0,0,0,8">
                                <Button Command="{Binding OpenNexusApiKeyPageCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        ToolTip="Opens your Nexus account's API Access page in your browser" AutomationProperties.Name="Get API key">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Get API key…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding NexusApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Paste your Nexus Personal API Key here"/>
                            </DockPanel>
                            <Button Content="Authorize" Command="{Binding AuthorizeNexusCommand}" HorizontalAlignment="Left"
                                    IsEnabled="{Binding CanAuthorizeNexus}"
                                    ToolTip="Validates the key with Nexus itself and, if it's accepted, saves it to Windows Credential Manager"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding NexusSignedInAs, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Signed in as "/><Run Text="{Binding NexusSignedInAs, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Content="Sign out" Command="{Binding SignOutNexusCommand}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding NexusStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,20"
                                   Visibility="{Binding NexusStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <TextBlock Text="Download handler (nxm:// links)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="Makes Nexus's own &quot;Mod Manager Download&quot; buttons open IcarusStarlink directly, landing files in Library's own Mods tab. Optional — you can always download through this app's own Nexus browsing tab instead."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,4,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsNxmProtocolNotRegistered, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Command="{Binding RegisterNxmProtocolCommand}"
                                    ToolTip="Writes a per-user registry entry (no admin rights needed) so nxm:// links launch IcarusStarlink — asks for confirmation first"
                                    AutomationProperties.Name="Register">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGlobeMeridian}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Register" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsNxmProtocolRegisteredToThisApp, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Registered to this app." VerticalAlignment="Center"/>
                            <Button Content="Unregister" Command="{Binding UnregisterNxmProtocolCommand}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding NxmProtocolStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560"
                                   Visibility="{Binding NxmProtocolStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== UE4SS ===================== -->
            <TabItem Header="UE4SS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="UE4SS is Icarus's separate Lua/scripting mod framework (Binaries\Win64) — installing/updating it is unrelated to the EXMOD/pak system. Your existing mods and settings are never overwritten."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding InstallOrUpdateUe4ssCommand}"
                                    IsEnabled="{Binding CanInstallOrUpdateUe4ss}"
                                    ToolTip="Downloads the latest stable UE4SS release from GitHub and installs it into Binaries\Win64 — backs up what's there first, asks for confirmation before writing anything"
                                    AutomationProperties.Name="{Binding Ue4ssInstallButtonLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Ue4ssInstallButtonLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding UninstallUe4ssCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanUninstallUe4ss}"
                                    Visibility="{Binding IsUe4ssInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Removes the UE4SS loader completely (dwmapi.dll + the ue4ss folder). Your own mods are moved back to this app's staging first, everything removed is backed up, and Icarus's own files are never touched. Asks for confirmation."
                                    AutomationProperties.Name="Uninstall UE4SS">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Uninstall UE4SS" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Ue4ssStatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Ue4ssStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560"
                                   Visibility="{Binding Ue4ssStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Maintenance ===================== -->
            <TabItem Header="Maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="App updates" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Margin="0,4,0,10">
                            <Run Text="You have v"/><Run Text="{Binding InstalledAppVersion, Mode=OneWay}"/><Run Text=" installed."/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding CheckForAppUpdatesCommand}" IsEnabled="{Binding CanCheckForAppUpdates}" AutomationProperties.Name="Check for updates">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefreshArrow}" Fill="{DynamicResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding UpdateNowCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsAppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Downloads the new version and installs it in place — the app closes, updates itself, and reopens. Your mods, profiles, and settings are never touched."
                                    AutomationProperties.Name="Update now">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Update now" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Open release page" Command="{Binding OpenLatestReleasePageCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsAppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="The manual fallback — opens the release's GitHub page in your browser instead"/>
                            <Button Content="View all releases" Command="{Binding OpenReleasesPageCommand}" Margin="8,0,0,0"
                                    ToolTip="Opens the repo's own Releases page on GitHub — every version, with its notes, always available regardless of whether a check has run"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AppUpdateStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,20"
                                   Visibility="{Binding AppUpdateStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <TextBlock Text="Diagnostics &amp; safety" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="If you run into a bug, export a diagnostics zip (logs + sanitized settings, never API keys or tokens) to attach to your report."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,4,0,10"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Performance tracking" IsChecked="{Binding PerformanceTrackingEnabled}" Margin="0,0,0,10"
                                  ToolTip="Off by default. When on, logs how long Rebuild/Install/catalog-refresh take to a separate app.perf log file — useful if something feels slow and you want to show real numbers in a bug report."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ExportDiagnosticsCommand}" AutomationProperties.Name="Export diagnostics zip">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Export diagnostics zip…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DiagnosticsStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Appearance ===================== -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Make the app look however you want: edit any color below (hex, #RRGGBB or #AARRGGBB with transparency), then Save skin. Pick the Custom theme in the top-right corner to use it. The skin lives in a plain JSON file you can also edit by hand or share."
                                   Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,14" MaxWidth="640"/>

                        <ItemsControl ItemsSource="{Binding SkinTokens}" MaxWidth="760" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" Margin="8,0"
                                                   ToolTip="{Binding Key}" TextTrimming="CharacterEllipsis"/>
                                        <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Width="96"
                                                 FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Save skin" Command="{Binding SaveSkinCommand}"
                                    ToolTip="Saves these colors to the skin file — applied immediately if the Custom theme is active"/>
                            <Button Content="Copy Icarus" Command="{Binding CopyThemeIntoSkinCommand}" CommandParameter="Icarus" Margin="8,0,0,0"
                                    ToolTip="Fill the boxes from the Icarus theme's values as a starting point (nothing saved until Save skin)"/>
                            <Button Content="Copy Dark" Command="{Binding CopyThemeIntoSkinCommand}" CommandParameter="Dark" Margin="8,0,0,0"
                                    ToolTip="Fill the boxes from the Dark theme's values as a starting point (nothing saved until Save skin)"/>
                            <Button Content="Copy Light" Command="{Binding CopyThemeIntoSkinCommand}" CommandParameter="Light" Margin="8,0,0,0"
                                    ToolTip="Fill the boxes from the Light theme's values as a starting point (nothing saved until Save skin)"/>
                            <Button Content="Open skin file" Command="{Binding OpenSkinFileCommand}" Margin="8,0,0,0"
                                    ToolTip="Opens the skin's own JSON file for hand-editing or sharing"/>
                            <Button Content="Reload skin file" Command="{Binding ReloadSkinFileCommand}" Margin="8,0,0,0"
                                    ToolTip="Re-reads the file into this editor after hand-editing it"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding SkinStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" MaxWidth="640" Margin="0,6,0,0"
                                   Visibility="{Binding SkinStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
