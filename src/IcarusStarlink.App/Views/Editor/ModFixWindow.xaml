<Window x:Class="IcarusStarlink.App.Views.ModFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="760" Width="1240" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- A mod editor for one job: what in this mod doesn't fit the current game, sorted by kind,
         each with a default fix, the mod's value next to the game's, and one Apply. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="270" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary}" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The kinds: count, what it means, and set-all. Click one to list only those. -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Show all" Command="{Binding ShowAllCommand}" Padding="8,1"
                            ToolTip="List every kind again"/>
                    <TextBlock Text="WHAT IT FOUND" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Choices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Padding="6,1" Margin="0,0,6,4" FontSize="11.5"
                                                        Command="{Binding DataContext.SetAllCommand, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Every flagged difference, with its fix. -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Find a row, field or table by name (for a mod's files: the file, the kind, like mesh, or the part of the game, like Deployables)"/>
                    <TextBlock Text="Find a row, field, table or file…" Style="{StaticResource PlaceholderTextStyle}"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="8,0,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ROW / FILE" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="FIELD / USES" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="2" Text="THE MOD HAS" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="3" Text="THE GAME HAS NOW" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Column="4" Text="FIX" Style="{StaticResource FieldLabelStyle}"/>
                </Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ListBox ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Row}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Row}"/>
                                        <TextBlock Text="{Binding Table}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Table}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Field}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Field}"/>
                                        <TextBlock Text="{Binding FieldSubtitle}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding FieldSubtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ModText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModText}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding GameText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameText}" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label"
                                              ToolTip="How to handle this one"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Drag to give the comparison below more room. -->
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ToolTip="Drag to resize"/>

        <!-- The selected one, side by side like kdiff: lists entry by entry in words, other values
             line by line; only the differences are coloured. The third column follows the fix chosen. -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10"
                DataContext="{Binding SelectedIssue}"
                Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6">
                    <Run Text="{Binding KindLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Issue.Why, Mode=OneWay}"/>
                </TextBlock>
                <!-- A mod's file and the game file it uses: what each one is, and what that part of the game holds. -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,6" CornerRadius="3" Background="{DynamicResource CardBackgroundBrush}"
                        Visibility="{Binding AssetHint, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5">
                        <Run Text="What these are: " FontWeight="SemiBold"/><Run Text="{Binding AssetHint, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding ShowValues, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="2" Background="#5539A845" Margin="0,0,4,0"/>
                        <TextBlock Text="only the mod has" FontSize="11.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#553F7FE0" Margin="0,0,4,0"/>
                        <TextBlock Text="only the game has" FontSize="11.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#55E0A030" Margin="0,0,4,0"/>
                        <TextBlock Text="different" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DiffSummary}" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,2" Visibility="{Binding ShowValues, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="THE MOD HAS" Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="THE GAME HAS NOW" Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding AfterTitle}" Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding ShowValues, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox ItemsSource="{Binding Diff}" BorderThickness="0" Background="Transparent" Focusable="False"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ModCell" Grid.Column="0" Padding="6,1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                        <TextBlock x:Name="ModText" Text="{Binding Mod}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Mod}"/>
                                    </Border>
                                    <Border x:Name="GameCell" Grid.Column="1" Padding="6,1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                        <TextBlock x:Name="GameText" Text="{Binding Game}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Game}"/>
                                    </Border>
                                    <Border x:Name="AfterCell" Grid.Column="2" Padding="6,1">
                                        <TextBlock x:Name="AfterText" Text="{Binding After}" TextTrimming="CharacterEllipsis" ToolTip="{Binding After}"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOnlyMod}" Value="True">
                                        <Setter TargetName="ModCell" Property="Background" Value="#5539A845"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOnlyGame}" Value="True">
                                        <Setter TargetName="GameCell" Property="Background" Value="#553F7FE0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter TargetName="ModCell" Property="Background" Value="#55E0A030"/>
                                        <Setter TargetName="GameCell" Property="Background" Value="#55E0A030"/>
                                    </DataTrigger>
                                    <!-- Code (not a list): monospace, so the lines line up. -->
                                    <DataTrigger Binding="{Binding DataContext.IsListDiff, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                        <Setter TargetName="ModText" Property="FontFamily" Value="Consolas"/>
                                        <Setter TargetName="GameText" Property="FontFamily" Value="Consolas"/>
                                        <Setter TargetName="AfterText" Property="FontFamily" Value="Consolas"/>
                                        <Setter TargetName="ModText" Property="FontSize" Value="11.5"/>
                                        <Setter TargetName="GameText" Property="FontSize" Value="11.5"/>
                                        <Setter TargetName="AfterText" Property="FontSize" Value="11.5"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Only the sure fixes" Command="{Binding OnlySureCommand}" Margin="0,0,8,0"
                    ToolTip="Fix only the sure ones; keep the mod's value for everything else"/>
            <Button DockPanel.Dock="Left" Content="Use suggestions" Command="{Binding UseSuggestionsCommand}" Margin="0,0,8,0"
                    ToolTip="Back to the suggested fix for everything"/>
            <Button DockPanel.Dock="Left" Content="Open in mod editor" Command="{Binding OpenEditorCommand}" Margin="0,0,8,0"
                    ToolTip="Edit the mod by hand instead (close this first)"/>
            <Button DockPanel.Dock="Left" Content="Restore backup" Command="{Binding RestoreBackupCommand}" Margin="0,0,8,0"
                    Visibility="{Binding HasBackup, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Puts this mod back exactly as it was before its last change (a fix, a rename or a refresh). The same as right-click the mod in Library › Restore latest backup."/>
            <Button DockPanel.Dock="Left" Content="{Binding RememberedText}" Command="{Binding ForgetChoicesCommand}" Margin="0,0,8,0"
                    Visibility="{Binding HasRemembered, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Your earlier choices for this mod are made by themselves, and values you kept aren't listed. This forgets them, so everything is suggested afresh."/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="8,0,0,0"
                       Foreground="{DynamicResource DangerBrush}"/>
            <Button DockPanel.Dock="Right" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding HasIssues}" Margin="8,0,0,0"
                    ToolTip="Backs the mod up, then makes these changes to it (Restore backup here, or right-click the mod in Library › Restore latest backup, undoes them). Greyed out: nothing to fix."
                    ToolTipService.ShowOnDisabled="True"/>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </DockPanel>
    </Grid>
</Window>
