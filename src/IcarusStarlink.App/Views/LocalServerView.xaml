<UserControl x:Class="IcarusStarlink.App.Views.LocalServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IcarusStarlink.App.Views"
             xmlns:converters="clr-namespace:IcarusStarlink.App.Converters"
             xmlns:server="clr-namespace:IcarusStarlink.Core.Server;assembly=IcarusStarlink.Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- The Server page's "Local server" tab (LocalServerViewModel): dedicated servers on this PC.
         Left: the profiles (drag the gap to widen it). Right: run state + Start/Stop/Restart, live
         tiles, then tabs: Overview (automation, firewall), Log (live tail of the server's own log
         file), Settings (launch options + ServerSettings.ini), Mods, Worlds & backups, World
         settings, Admins & bans. -->
    <UserControl.Resources>
        <converters:LogLineLevelConverter x:Key="LogLineLevelConverter"/>

        <!-- Eye for the password show/hide toggles; a slash is drawn over it while the text shows. -->
        <Geometry x:Key="ServerIconEye">M2 12C5 6.8 8.5 5 12 5C15.5 5 19 6.8 22 12C19 17.2 15.5 19 12 19C8.5 19 5 17.2 2 12Z M9.5 12A2.5 2.5 0 1 0 14.5 12A2.5 2.5 0 1 0 9.5 12Z</Geometry>

        <!-- A small hint under a field or section label. -->
        <Style x:Key="ServerHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource FaintForegroundBrush}"/>
        </Style>

        <!-- Section labels on every tab: the app's small caps label (FieldLabelStyle), with room under it. -->
        <Style x:Key="ServerSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Style="{StaticResource VerticalPaneSplitterStyle}" Width="16"
                      AutomationProperties.Name="Resize server list"/>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="SERVERS ON THIS PC" Style="{StaticResource ServerSectionLabelStyle}" Margin="0,0,0,6"/>
            <!-- No sideways scrolling: a long name or path is cut with … and shown in full on hover. -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding IsNotBusy}"
                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" ToolTipService.ShowOnDisabled="True"/>
                            <TextBlock Text="{Binding InstallFolder}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding InstallFolder}" ToolTipService.ShowOnDisabled="True"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="port "/><Run Text="{Binding Port, Mode=OneWay}"/><Run Text=" · query "/><Run Text="{Binding QueryPort, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Content="Install new server…" Command="{Binding InstallNewServerCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                        ToolTip="Downloads the Icarus dedicated server with SteamCMD (app 2089300 — free, no Icarus licence needed, about 10 GB) into a folder you choose"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add existing server…" Command="{Binding AddExistingServerCommand}"
                            ToolTip="Point at a dedicated server you already installed (the folder with IcarusServer.exe). Its settings are read from its own ServerSettings.ini."/>
                    <Button Content="Remove" Command="{Binding RemoveProfileCommand}" Margin="8,0,0,0"
                            ToolTip="Removes the entry from this list only — the server's files are not touched"/>
                </StackPanel>

                <!-- SteamCMD is only needed to install or update a server: with servers and no
                     SteamCMD this is one line that opens the full box (see ShowSteamCmdBox). -->
                <DockPanel Margin="0,14,0,0" Visibility="{Binding ShowSteamCmdLine, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button DockPanel.Dock="Right" Content="Set up…" Command="{Binding ExpandSteamCmdSetupCommand}" Padding="6,0" FontSize="11" Margin="6,0,0,0"
                            VerticalAlignment="Center" ToolTip="Install SteamCMD, or point at one you already have"/>
                    <TextBlock Text="SteamCMD not set up" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="SteamCMD is only needed to install or update a server. Set up… installs it, or points at one you already have."
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </DockPanel>
                <StackPanel Visibility="{Binding ShowSteamCmdBox, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="STEAMCMD" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding SteamCmdSummary}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <!-- Wraps: the server list is narrow and the second button was cut off. -->
                    <WrapPanel Margin="0,2,0,0">
                        <Button Content="Install SteamCMD" Command="{Binding InstallSteamCmdCommand}" Margin="0,4,8,0"
                                ToolTip="Downloads SteamCMD from Valve into a SteamCMD folder inside Starlink's own folder"/>
                        <Button Content="Use my SteamCMD…" Command="{Binding UseExistingSteamCmdCommand}" Margin="0,4,0,0"
                                ToolTip="Point at a steamcmd.exe you already have — your own update scripts and Starlink then share it"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding ShowSteamCmdPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Hide" Command="{Binding DismissSteamCmdOutputCommand}" Padding="6,0" FontSize="11"
                                Visibility="{Binding IsSteamCmdIdle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelSteamCmdCommand}" Padding="6,0" FontSize="11"
                                Visibility="{Binding IsSteamCmdBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Stops SteamCMD. Run the install or update again later; it carries on from what it already downloaded."/>
                        <TextBlock Text="STEAMCMD" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding SteamCmdProgress}" Maximum="100" Height="6" Margin="0,6,0,6"/>
                    <TextBlock Text="{Binding SteamCmdStatus}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <ListBox x:Name="SteamCmdOutputList" ItemsSource="{Binding SteamCmdOutput}" Height="160" Margin="0,6,0,0"
                             FontFamily="Consolas" FontSize="10.5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Column="2" Margin="0,40,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Visibility="{Binding HasNoProfile, Converter={StaticResource BoolToVisibilityConverter}}"
                   Text="No servers yet. Click 'Install new server…' to download one with SteamCMD, or 'Add existing server…' and pick the folder that holds IcarusServer.exe. Starlink then edits its ServerSettings.ini, starts and stops it, keeps it updated, manages its mods and backups, and shows its log here."/>

        <Grid Grid.Column="2" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Saves the settings below, then launches IcarusServer.exe in its own console window"/>
                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0"
                                ToolTip="Asks the server to shut down cleanly (it saves then only if 'Save on exit' is on in Settings); ends it after 60 seconds if it hasn't closed"/>
                        <Button Content="Restart" Command="{Binding RestartCommand}" Margin="8,0,0,0"
                                ToolTip="Stops the server cleanly, then starts it again (with 'Update on restart' on, a newer build is installed in between)"/>
                        <Button Content="Open folder" Command="{Binding OpenInstallFolderCommand}" Margin="16,0,0,0"
                                ToolTip="The server's install folder (the one with IcarusServer.exe)"/>
                        <Button Content="Open Saved" Command="{Binding OpenSavedFolderCommand}" Margin="8,0,0,0"
                                ToolTip="The server's Saved folder: settings, logs, worlds (PlayerData\DedicatedServer\Prospects)"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="8" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RunStateText}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InstallFolder}" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InstallFolder}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding BuildSummary}" FontSize="11.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="Check for update" Command="{Binding CheckForUpdateCommand}" Margin="12,0,0,0" Padding="8,2" FontSize="11.5"
                                    ToolTip="Asks Steam (through SteamCMD, anonymous) for the newest build on this profile's branch"/>
                            <Button Content="Update" Command="{Binding UpdateServerCommand}" Margin="6,0,0,0" Padding="8,2" FontSize="11.5"
                                    ToolTip="Stops the server if it's running, backs up its worlds and settings, then updates it with SteamCMD — also how a branch switch is applied"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- Live tiles: the selected server at a glance. -->
            <UniformGrid Grid.Row="2" Rows="1" Columns="6" Margin="0,8,0,0">
                <UniformGrid.Resources>
                    <Style x:Key="TileStyle" TargetType="Border">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style x:Key="TileValueStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Margin" Value="0,2,0,1"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style x:Key="TileHintStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                </UniformGrid.Resources>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="PLAYERS" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock Text="{Binding PlayersTile}" Style="{StaticResource TileValueStyle}" ToolTip="{Binding PlayersTile}"/>
                        <TextBlock Text="{Binding PlayersHint}" Style="{StaticResource TileHintStyle}" ToolTip="{Binding PlayersHint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="WORLD" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock Text="{Binding WorldTile}" Style="{StaticResource TileValueStyle}" ToolTip="{Binding WorldTile}"/>
                        <TextBlock Text="{Binding WorldHint}" Style="{StaticResource TileHintStyle}" ToolTip="{Binding WorldHint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="UPTIME" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock Text="{Binding UptimeTile}" Style="{StaticResource TileValueStyle}" ToolTip="{Binding UptimeTile}"/>
                        <TextBlock Text="{Binding UptimeHint}" Style="{StaticResource TileHintStyle}" ToolTip="{Binding UptimeHint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock Text="{Binding MemoryTile}" Style="{StaticResource TileValueStyle}" ToolTip="{Binding MemoryTile}"/>
                        <TextBlock Text="{Binding MemoryHint}" Style="{StaticResource TileHintStyle}" ToolTip="{Binding MemoryHint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="BUILD" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock Text="{Binding BuildTile}" Style="{StaticResource TileValueStyle}" ToolTip="{Binding BuildTile}"/>
                        <TextBlock Text="{Binding BuildHint}" Style="{StaticResource TileHintStyle}" ToolTip="{Binding BuildHint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="LAST BACKUP" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock Text="{Binding BackupTile}" Style="{StaticResource TileValueStyle}" ToolTip="{Binding BackupTile}"/>
                        <TextBlock Text="{Binding BackupHint}" Style="{StaticResource TileHintStyle}" ToolTip="{Binding BackupHint}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TabControl Grid.Row="3" Margin="0,8,0,0">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style x:Key="OptionHintStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Setter Property="Margin" Value="22,0,0,10"/>
                                </Style>
                            </Grid.Resources>

                            <!-- Automation: open by default (it's what the Overview is for); the header
                                 says which options are on, so it can be folded away once set. -->
                            <Expander Grid.Column="0" VerticalAlignment="Top" IsExpanded="True" AutomationProperties.Name="Automation">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="Automation" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="{Binding AutomationSummary}" Style="{StaticResource ExpanderHeaderStateStyle}" ToolTip="{Binding AutomationSummary}"/>
                                    </DockPanel>
                                </Expander.Header>
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AutoRestartOnCrash}" Margin="0,0,0,2">
                                    <TextBlock Text="Restart it if it crashes" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="Only when its log shows no clean exit. Up to 3 times in 10 minutes, then it is left stopped and you are told."/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <CheckBox IsChecked="{Binding DailyRestartEnabled}" VerticalAlignment="Center">
                                        <TextBlock Text="Restart every day at" FontWeight="SemiBold"/>
                                    </CheckBox>
                                    <TextBox Text="{Binding DailyRestartTime, UpdateSourceTrigger=PropertyChanged}" Width="56" Margin="8,0,0,0" Padding="2,0"
                                             AutomationProperties.Name="Daily restart time" ToolTip="24-hour time, like 05:00"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DailyRestartTimeError}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" Margin="22,0,0,0"
                                           Visibility="{Binding DailyRestartTimeError, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="Waits up to an hour for everyone to leave. Icarus has no way to message players from outside the game, so it can't warn them."/>

                                <CheckBox IsChecked="{Binding UpdateOnRestart}" Margin="0,0,0,2">
                                    <TextBlock Text="Update on restart" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="Before the daily restart and the Restart button, asks Steam for a newer build and installs it. Worlds are backed up first."/>

                                <CheckBox IsChecked="{Binding AutoUpdate}" Margin="0,0,0,2">
                                    <TextBlock Text="Update automatically" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="While it runs, checks Steam every hour. A newer build installs the next time nobody is online."/>

                                <CheckBox IsChecked="{Binding DailyBackup}" Margin="0,0,0,2">
                                    <TextBlock Text="Back up every day" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="While it runs, zips its worlds and settings once a day (Worlds &amp; backups tab). Older daily backups are tidied by the keep count there."/>

                                <CheckBox IsChecked="{Binding StartWithApp}" Margin="0,0,0,2">
                                    <TextBlock Text="Start with Starlink" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="Starts this server when Starlink opens, if it isn't running already."/>

                                <CheckBox IsChecked="{Binding StartMinimized}" Margin="0,0,0,2">
                                    <TextBlock Text="Start minimized" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource OptionHintStyle}"
                                           Text="Minimizes the server's console window as soon as it opens."/>

                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}"
                                           Text="Automation runs only while Starlink is open. Every server in the list is watched, not just the selected one."/>
                            </StackPanel>
                            </Expander>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding SaveOnExitWarning}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Visibility="{Binding SaveOnExitWarning, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <TextBlock Text="NEXT UP" Style="{StaticResource ServerSectionLabelStyle}"/>
                                <ItemsControl ItemsSource="{Binding NextUp}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Firewall: a set-once job, so folded by default; the header says
                                     whether every port gets through, so a problem is still seen. -->
                                <Expander IsExpanded="False" AutomationProperties.Name="Windows firewall">
                                    <Expander.Header>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="Windows firewall" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                            <TextBlock Text="{Binding FirewallState}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                        </DockPanel>
                                    </Expander.Header>
                                <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshFirewallCommand}" Padding="8,1" FontSize="11"
                                            ToolTip="Reads Windows Firewall's rules again (after changing them outside Starlink)"/>
                                    <TextBlock Text="Ports to check" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </DockPanel>
                                <WrapPanel>
                                    <StackPanel>
                                        <TextBlock Text="Game port" FontSize="12"/>
                                        <TextBox Text="{Binding FirewallGamePortText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,2,12,8"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Query port" FontSize="12"/>
                                        <TextBox Text="{Binding FirewallQueryPortText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,2,12,8"/>
                                    </StackPanel>
                                    <CheckBox Content="Also TCP on the game port" IsChecked="{Binding FirewallIncludeTcp}" VerticalAlignment="Center" Margin="0,8,0,0"
                                              ToolTip="Icarus needs UDP. Some hosts open TCP on the game port too; this is ticked when a rule for it already exists."/>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding FirewallPorts}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Open}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Blocked}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding FirewallSummary}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding FirewallNetworkText}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8"
                                           Visibility="{Binding FirewallNetworkText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open these ports" Command="{Binding OpenFirewallPortsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="Adds inbound allow rules for the ports that aren't open yet, only for this server's exe. Windows asks for administrator approval once."/>
                                    <Button Content="Remove Starlink's rules" Command="{Binding RemoveFirewallRulesCommand}" Margin="8,0,0,0"
                                            ToolTip="Removes only the rules Starlink added for this server. Rules you made yourself stay."/>
                                </StackPanel>
                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,8,0,0"
                                           Text="Players outside your home network also need both UDP ports forwarded on your router to this PC. Starlink can't change router settings."/>
                                </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Log">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Margin="8,0,0,0"
                                    ToolTip="Clears this view only; the server's log file is not touched"/>
                            <Grid DockPanel.Dock="Right" Width="200">
                                <TextBox Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Show only lines containing this text" AutomationProperties.Name="Filter log"/>
                                <TextBlock Text="Filter…" Style="{StaticResource PlaceholderTextStyle}"
                                           Visibility="{Binding LogFilter, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                            <CheckBox DockPanel.Dock="Right" Content="Follow" IsChecked="{Binding FollowLog}" Margin="12,0,12,0" VerticalAlignment="Center"
                                      ToolTip="Keeps the newest line in view as the server writes"/>
                            <CheckBox DockPanel.Dock="Right" Content="Hide noise" IsChecked="{Binding HideNoise}" VerticalAlignment="Center"
                                      ToolTip="Hides engine chatter (texture streaming, shaders, audio, HTTP…) — joins, prospect loads, mods, warnings and errors stay"/>
                            <TextBlock Text="{Binding LogPath}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource FaintForegroundBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}"/>
                        </DockPanel>
                        <!-- Drag the gap to give the log or the players/events side more room. -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="260" MinWidth="160"/>
                            </Grid.ColumnDefinitions>
                            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalPaneSplitterStyle}"
                                          AutomationProperties.Name="Resize log and events"/>
                            <ListBox x:Name="LogList" Grid.Column="0" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11.5"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <!-- Errors red, warnings amber. The level is worked out as a row is shown
                                     (two Contains calls), so a 4,000-line log costs nothing extra. -->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource LogLineLevelConverter}}" Value="{x:Static server:ServerLogLevel.Error}">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource LogLineLevelConverter}}" Value="{x:Static server:ServerLogLevel.Warning}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Column="0" IsHitTestVisible="False"
                                       Text="No log lines to show. The server's log appears here while it runs — or no line matches the filter.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogLines.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding OnlineSummary}" Style="{StaticResource FieldLabelStyle}"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding OnlinePlayers}" Margin="0,4,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,1">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Since, Mode=OneWay, StringFormat='  since {0:HH:mm} UTC'}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="2" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap">
                                    <Run Text="World: " Foreground="{DynamicResource SecondaryForegroundBrush}"/><Run Text="{Binding CurrentProspect, Mode=OneWay, TargetNullValue='lobby'}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Text="EVENTS" Style="{StaticResource ServerSectionLabelStyle}"/>
                                <ListBox Grid.Row="4" ItemsSource="{Binding Events}" FontSize="11.5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <!-- Grouped into folding sections so the everyday ones (name, passwords, ports,
                         world) stay in view and the rare ones (lobby timers, advanced launch
                         options, the command line) fold away. Save stays pinned under the list. -->
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Expander Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" IsExpanded="True" Margin="0,0,0,10" AutomationProperties.Name="Server">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="Server" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="{Binding SteamServerName}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Profile name (only in this app)" FontSize="12"/>
                                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Width="360" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Margin="0,2,0,8"/>
                                    <TextBlock Text="Server name in the browser (64 characters max)" FontSize="12"/>
                                    <TextBox Text="{Binding SteamServerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Width="360" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Margin="0,2,0,8"
                                             ToolTip="Sent as -SteamServerName — the ini's SessionName key does nothing, per the official docs"/>
                                    <TextBlock Text="Max players (1-8, blank = game default)" FontSize="12"/>
                                    <TextBox Text="{Binding MaxPlayersText, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8" Text="Higher = more people can play at once; lower = a smaller group."/>
                                    <TextBlock Text="Join password (blank = anyone can join)" FontSize="12"/>
                                    <Grid Width="280" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox views:PasswordBoxText.Text="{Binding JoinPassword}" AutomationProperties.Name="Join password">
                                            <PasswordBox.Style>
                                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ShowJoinPasswordToggle}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </PasswordBox.Style>
                                        </PasswordBox>
                                        <TextBox Text="{Binding JoinPassword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Join password"
                                                 Visibility="{Binding IsChecked, ElementName=ShowJoinPasswordToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ToggleButton x:Name="ShowJoinPasswordToggle" Grid.Column="1" Style="{StaticResource IconToggleButtonStyle}" Width="28" Height="28" Margin="4,0,0,0"
                                                      ToolTip="Show or hide the password" AutomationProperties.Name="Show join password">
                                            <Grid Width="16" Height="16">
                                                <Path Data="{StaticResource ServerIconEye}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                                      StrokeLineJoin="Round" Stretch="Uniform"/>
                                                <Line X1="2" Y1="14" X2="14" Y2="2" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Visibility="{Binding IsChecked, ElementName=ShowJoinPasswordToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </ToggleButton>
                                    </Grid>
                                    <TextBlock Text="Admin password" FontSize="12"/>
                                    <Grid Width="280" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox views:PasswordBoxText.Text="{Binding AdminPassword}" AutomationProperties.Name="Admin password">
                                            <PasswordBox.Style>
                                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ShowAdminPasswordToggle}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </PasswordBox.Style>
                                        </PasswordBox>
                                        <TextBox Text="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Admin password"
                                                 Visibility="{Binding IsChecked, ElementName=ShowAdminPasswordToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ToggleButton x:Name="ShowAdminPasswordToggle" Grid.Column="1" Style="{StaticResource IconToggleButtonStyle}" Width="28" Height="28" Margin="4,0,0,0"
                                                      ToolTip="Show or hide the password" AutomationProperties.Name="Show admin password">
                                            <Grid Width="16" Height="16">
                                                <Path Data="{StaticResource ServerIconEye}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                                      StrokeLineJoin="Round" Stretch="Uniform"/>
                                                <Line X1="2" Y1="14" X2="14" Y2="2" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Visibility="{Binding IsChecked, ElementName=ShowAdminPasswordToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </ToggleButton>
                                    </Grid>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"
                                               Visibility="{Binding AdminPasswordIsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="Empty: any player who types /AdminLogin in chat becomes admin. Set one."/>
                                </StackPanel>
                            </Expander>
                            <Expander Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" IsExpanded="True" Margin="0,0,0,10" AutomationProperties.Name="Branch and ports">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="Branch &amp; ports" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Style="{StaticResource ExpanderHeaderStateStyle}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · ports {1} / {2}">
                                                    <Binding Path="Branch"/>
                                                    <Binding Path="PortText"/>
                                                    <Binding Path="QueryPortText"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Steam branch" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding Branch}" Width="160" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,12"
                                               Text="Players on Icarus's Experimental branch can only join an experimental server. Changing this takes effect when you click Update."/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel>
                                            <TextBlock Text="Game port (UDP)" FontSize="12"/>
                                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,2,16,8"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Query port (UDP)" FontSize="12"/>
                                            <TextBox Text="{Binding QueryPortText, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,2,0,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8"
                                               Text="Forward both ports on your router for players outside your network. Defaults: 17777 and 27015."/>
                                </StackPanel>
                            </Expander>
                            <Expander Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" IsExpanded="True" Margin="0,0,0,10" AutomationProperties.Name="World">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="World" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="Which world starts · autosave · respawns" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <CheckBox Content="Resume the last prospect on start" IsChecked="{Binding ResumeProspect}" IsThreeState="True" Margin="0,0,0,4"
                                              ToolTip="A dash means: not set, the game's own default applies"/>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="20,0,0,6">
                                        <Run Text="Last prospect: "/><Run Text="{Binding LastProspectName, Mode=OneWay, TargetNullValue='(none yet)'}"/>
                                    </TextBlock>
                                    <TextBlock Text="Load prospect on start (blank = none)" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Prospects}" Text="{Binding LoadProspect, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="360" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Margin="0,2,0,8"
                                              ToolTip="A save under Saved\PlayerData\DedicatedServer\Prospects. Applied before Resume and Create."/>
                                    <TextBlock Text="Create a new world on start" FontSize="12"/>
                                    <StackPanel Visibility="{Binding HasProspectChoices, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,2,0,2">
                                        <ComboBox ItemsSource="{Binding ProspectChoices}" SelectedItem="{Binding NewProspectType}" DisplayMemberPath="Display" Width="360" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                  ToolTip="The prospect the server creates when it starts: an open world, an outpost or a mission (the game's own list)"/>
                                        <WrapPanel Margin="0,4,0,0" Visibility="{Binding IsCreatingProspect, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ComboBox ItemsSource="{Binding ProspectDifficulties}" SelectedItem="{Binding NewProspectDifficulty}" DisplayMemberPath="Label" Width="110" Margin="0,0,8,4"
                                                      ToolTip="Difficulty: Easy to Extreme. Higher = tougher creatures and harsher conditions."/>
                                            <CheckBox Content="Hardcore (no respawns)" IsChecked="{Binding NewProspectHardcore}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                            <Grid Width="180" Margin="0,0,0,4">
                                                <TextBox Text="{Binding NewProspectName, UpdateSourceTrigger=PropertyChanged}" ToolTip="The world's save name (spaces become _). Needed for an outpost; a blank one gets a random name."/>
                                                <TextBlock Text="World name" Style="{StaticResource PlaceholderTextStyle}"
                                                           Visibility="{Binding NewProspectName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            </Grid>
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBox Text="{Binding CreateProspect, UpdateSourceTrigger=PropertyChanged}" Width="360" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Margin="0,2,0,2"
                                             Visibility="{Binding HasNoProspectChoices, Converter={StaticResource BoolToVisibilityConverter}}"
                                             ToolTip="[ProspectType] [Difficulty 1-4] [Hardcore True/False] [SaveName] — run Refresh game data in Settings to pick from a list instead"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8"
                                               Text="{Binding ProspectHint}"/>
                                    <TextBlock Text="Autosave every (minutes, blank = game default)" FontSize="12"/>
                                    <TextBox Text="{Binding GameSaveFrequencyText, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8" Text="Lower = saves more often, so less is lost if the server crashes; higher = fewer saves (slightly less load)."/>
                                    <CheckBox Content="Save on exit" IsChecked="{Binding SaveGameOnExit}" IsThreeState="True" Margin="0,0,0,4"/>
                                    <CheckBox Content="Fiber foliage regrows over time" IsChecked="{Binding FiberFoliageRespawn}" IsThreeState="True" Margin="0,0,0,4"/>
                                    <CheckBox Content="Mined large stones respawn" IsChecked="{Binding LargeStonesRespawn}" IsThreeState="True" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Expander>
                            <Expander Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" IsExpanded="False" Margin="0,0,0,10" AutomationProperties.Name="Lobby">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="Lobby" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="Empty-world timers · who can launch or delete prospects" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Return to lobby if nobody joins for (seconds, -1 = never)" FontSize="12"/>
                                    <TextBox Text="{Binding ShutdownIfNotJoinedForText, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8" Text="Lower = an unused world closes sooner (frees the server); higher = it waits longer for someone to join."/>
                                    <TextBlock Text="Return to lobby after the last player leaves (seconds, -1 = never)" FontSize="12"/>
                                    <TextBox Text="{Binding ShutdownIfEmptyForText, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,0,0,8" Text="Lower = the world closes sooner after everyone leaves; higher = it stays up longer for people to come back."/>
                                    <CheckBox Content="Players who aren't admins can create or load prospects" IsChecked="{Binding AllowNonAdminsToLaunchProspects}" IsThreeState="True" Margin="0,0,0,4"/>
                                    <CheckBox Content="Players who aren't admins can delete prospects" IsChecked="{Binding AllowNonAdminsToDeleteProspects}" IsThreeState="True" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,4,0,0"
                                               Text="A checkbox showing a dash isn't set in the file, so the game's own default applies."/>
                                </StackPanel>
                            </Expander>
                            <Expander Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Top" IsExpanded="False" Margin="0,0,0,10" AutomationProperties.Name="Advanced launch options">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="Advanced" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="Bind IP · Saved folder suffix · log file name · command line" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Bind to IP (-MULTIHOME, blank = all)" FontSize="12"/>
                                    <TextBox Text="{Binding Multihome, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                                    <TextBlock Text="Saved folder suffix (for a second server on the same install)" FontSize="12"/>
                                    <TextBox Text="{Binding SavedDirSuffix, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Margin="0,2,0,8"
                                             ToolTip="-saveddirsuffix — e.g. _2 makes this profile use Icarus\Saved_2 for its settings, logs and worlds"/>
                                    <TextBlock Text="Log file name (blank = Icarus.log)" FontSize="12"/>
                                    <TextBox Text="{Binding LogFileName, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                                    <TextBlock Text="Command line Starlink runs" FontSize="12" Margin="0,4,0,2"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyCommandLineCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                                                ToolTip="Copies this command line, to run the server the same way from your own script"/>
                                        <TextBox Text="{Binding CommandLinePreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SettingsIniPath}">
                                        <Run Text="Settings file: "/><Run Text="{Binding SettingsIniPath, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4,8,0" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"
                                        ToolTip="Writes the launch options here and the game settings into ServerSettings.ini (every other line in that file is kept). A running server picks them up on restart."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding ModsTabHeader}" AutomationProperties.Name="Mods">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10"
                                       Text="Stop the server before changing its mods. Installing mods backs up its worlds and settings first, and anything taken off the server is moved into its backups folder, never deleted. Players need the same content mods as the server."/>

                            <TextBlock Text="PAK MODS ON THE SERVER" Style="{StaticResource ServerSectionLabelStyle}"/>
                            <!-- Whether the server has the merged pak Merge & Install last built (compared by contents). -->
                            <TextBlock Text="{Binding MergedPakSummary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerPakOutOfDate}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="{Binding InstallMergedPakLabel}" Command="{Binding InstallMergedPakCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding HasMergedPak}"
                                        ToolTip="Copies the pak your last Merge &amp; Install built (and its mod list) into the server's Content\Paks\mods"/>
                                <Button Content="Open folder" Command="{Binding OpenServerPaksFolderCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Expander Margin="0,0,0,16" AutomationProperties.Name="All paks on the server">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="All paks on the server" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                                        <TextBlock Text="{Binding ServerPaks.Count, StringFormat='{}{0} files'}" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding ServerPaks}" SelectedItem="{Binding SelectedServerPak}" MaxHeight="140" MaxWidth="900" HorizontalAlignment="Left" MinWidth="360"
                                             BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ServerPaks.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding FileName, Mode=OneWay}" FontFamily="Consolas"/>
                                                    <Run Text="{Binding ModifiedLocal, Mode=OneWay, StringFormat='  {0:g}'}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="No paks in the server's Content\Paks\mods folder." FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ServerPaks.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Remove selected" Command="{Binding RemoveSelectedPakCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            ToolTip="Moves the selected pak into this server's backups folder"/>
                                </StackPanel>
                            </Expander>

                            <TextBlock Style="{StaticResource ServerSectionLabelStyle}">
                                <Run Text="UE4SS MODS ON THE SERVER"/><Run Text="{Binding ServerUe4ssModCount, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{DynamicResource FaintForegroundBrush}"/>
                            </TextBlock>
                            <!-- The UE4SS rows, their note and buttons stop at 1100 px, so Remove and the
                                 buttons stay near the mod names on a wide window. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1100"/>
                                    <ColumnDefinition Width="0"/>
                                </Grid.ColumnDefinitions>
                            <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Install UE4SS from my game" Command="{Binding InstallUe4ssOnServerCommand}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        ToolTip="Copies the loader (dwmapi.dll, UE4SS.dll), its settings and framework mods from your game's install — verified to run on the dedicated server. Existing settings on the server are kept."/>
                                <TextBlock Text="{Binding ServerUe4ssSummary}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- One row per mod: your game's copy, the server's, how they compare, and the action. -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshServerModsCommand}" Margin="8,0,0,0"
                                        ToolTip="Reads the server's and your game's UE4SS mods again"/>
                                <Button DockPanel.Dock="Right" Content="Make the server match my game" Command="{Binding MatchServerToGameCommand}"
                                        IsEnabled="{Binding ServerHasUe4ss}"
                                        ToolTip="Updates every out-of-date mod on the server and copies the ones on in your game that it lacks. Keeps the server's own settings; never removes anything; backs up worlds first.">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasModsToUpdate}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="Versions come from each mod's main.lua; without one, the files are compared. The server's own config files are kept on update; when they differ from your game's, Match settings… picks which copy both use."/>
                            </DockPanel>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="160"/>
                                            <ColumnDefinition Width="*" MinWidth="110"/>
                                            <ColumnDefinition Width="*" MinWidth="90"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrvOn"/>
                                            <ColumnDefinition Width="1.4*" MinWidth="150"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrvAction"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MOD" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="YOUR GAME" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="2" Text="SERVER" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="3" Text="ON" Style="{StaticResource FieldLabelStyle}" Margin="0,0,14,0"
                                                   ToolTip="On or off on the server only (your game isn't changed)"/>
                                        <TextBlock Grid.Column="4" Text="STATE" Style="{StaticResource FieldLabelStyle}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Ue4ssModRows}" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowBorder" Padding="10,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" MinWidth="160"/>
                                                            <ColumnDefinition Width="*" MinWidth="110"/>
                                                            <ColumnDefinition Width="*" MinWidth="90"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrvOn"/>
                                                            <ColumnDefinition Width="1.4*" MinWidth="150"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrvAction"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding GameText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ServerText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <CheckBox Grid.Column="3" IsChecked="{Binding ServerOn}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                                  Visibility="{Binding IsOnServer, Converter={StaticResource BoolToHiddenConverter}}"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat='On on the server: {0}'}"
                                                                  ToolTip="On or off on the server (takes effect when it starts). An unticked mod stays on the server, switched off; Remove takes it off. Your game isn't changed."/>
                                                        <TextBlock Grid.Column="4" Text="{Binding StateText}" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding ConfigDiffersText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSame}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="{Binding CopyActionLabel}" Padding="8,1" FontSize="11.5" Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.CopyUe4ssModToServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasCopyAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Button Content="Match settings…" Padding="8,1" FontSize="11.5" Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.MatchUe4ssModSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding ConfigDiffers, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    ToolTip="The game's and the server's copies have different settings. Pick which copy both should use; the replaced file is backed up first."/>
                                                            <Button Content="Remove" Padding="8,1" FontSize="11.5"
                                                                    Command="{Binding DataContext.RemoveServerUe4ssModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsOnServer, Converter={StaticResource BoolToHiddenConverter}}"
                                                                    ToolTip="Takes it off the server (moved into its backups folder)"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter TargetName="RowBorder" Property="Background" Value="#14808080"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No UE4SS mods in your game or on the server yet. Turn one on in the Library, then copy it here." Margin="10,8" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ue4ssModRows.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Share with players: a patch of what this server runs, a patch applied to it, a patch compared with it. -->
                            <TextBlock Text="SHARE WITH PLAYERS" Style="{StaticResource ServerSectionLabelStyle}" Margin="0,18,0,0"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="A patch is what this server runs: the mods in its merged pak, its UE4SS mods and their settings. Players import it on Merge &amp; Install and get the same setup. Apply does the reverse: a patch's mods into your Library and its UE4SS mods onto this server."/>
                            <WrapPanel>
                                <Button Content="Export patch for players…" Command="{Binding ExportServerPatchCommand}" Margin="0,0,8,6"
                                        ToolTip="Writes a patch of what the server runs (its mod list from ISL-Merged.txt, matched to your Library; its UE4SS mods on, from its own folder)"/>
                                <Button Content="Apply a patch to this server…" Command="{Binding ApplyPatchToServerCommand}" Margin="0,0,8,6"
                                        ToolTip="Imports the patch on Merge &amp; Install (its mods, downloads, UE4SS mods, settings, the profile), then puts its UE4SS mods and settings on this server. The merged pak is built on Merge &amp; Install and installed from here. The server must be stopped."/>
                                <Button Content="Compare a patch…" Command="{Binding ComparePatchCommand}" Margin="0,0,8,6"
                                        ToolTip="Lines a patch up against your game and this server, one row per mod"/>
                                <CheckBox Content="Include UE4SS mod settings" IsChecked="{Binding ServerExportIncludesConfigs}" VerticalAlignment="Center" Margin="0,0,0,6"
                                          ToolTip="The export carries the server's config files (config.lua, config.ini), so players get its keys and values too"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ShareStatusMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,6"
                                       Visibility="{Binding ShareStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" Margin="0,2,0,0"
                                    Visibility="{Binding HasPatchCompare, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel Margin="10,6,10,4">
                                        <Button DockPanel.Dock="Right" Content="Close" Command="{Binding ClosePatchCompareCommand}" Padding="8,1" FontSize="11.5"/>
                                        <TextBlock Text="{Binding PatchCompareTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <Grid Margin="10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="160"/>
                                            <ColumnDefinition Width="*" MinWidth="90"/>
                                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MOD" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="KIND" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="2" Text="PATCH" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="3" Text="YOUR GAME" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Column="4" Text="SERVER" Style="{StaticResource FieldLabelStyle}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PatchCompareRows}" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CompareRowBorder" Padding="10,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" MinWidth="160"/>
                                                            <ColumnDefinition Width="*" MinWidth="90"/>
                                                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="12"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Differs}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Resources>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PatchText}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding GameText}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ServerText}"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter TargetName="CompareRowBorder" Property="Background" Value="#14808080"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Worlds &amp; backups">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ServerSectionLabelStyle}">
                                <Run Text="WORLDS (PROSPECTS)"/><Run Text="{Binding ProspectRows.Count, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{DynamicResource FaintForegroundBrush}"/>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ServerHintStyle}" Margin="0,0,0,6"
                                       Text="Saved under PlayerData\DedicatedServer\Prospects, newest first. Pick which one starts in Settings → Load prospect on start. The game also keeps rolling .backup copies of each."/>
                            <Grid>
                                <ListBox ItemsSource="{Binding ProspectRows}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                                        <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource CardRaisedBackgroundBrush}"
                                                        Visibility="{Binding IsLoadOnStart, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Settings → Load prospect on start names this world">
                                                    <TextBlock Text="LOADS ON START" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                        <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SuccessSoftBrush}"
                                                        Visibility="{Binding IsLastPlayed, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="The world the server ran last (LastProspectName in its settings)">
                                                    <TextBlock Text="LAST RUN" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ModifiedLocal, StringFormat='saved {0:g}'}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock IsHitTestVisible="False"
                                           Text="No worlds yet. The server saves one the first time a prospect runs on it — set one up in Settings → World.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProspectRows.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ServerSectionLabelStyle}">
                                <Run Text="BACKUPS"/><Run Text="{Binding Backups.Count, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{DynamicResource FaintForegroundBrush}"/>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ServerHintStyle}" Margin="0,0,0,6"
                                       Text="Zips of every world, ServerSettings.ini and the admin and ban lists. Starlink also makes one before every update, mod change and restore."/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <WrapPanel>
                                    <Button Content="Back up now" Command="{Binding BackUpNowCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4"
                                            ToolTip="Zips every world, ServerSettings.ini and the admin/ban lists (safe while the server runs)"/>
                                    <Button Content="Restore selected" Command="{Binding RestoreSelectedBackupCommand}" Margin="0,0,8,4"
                                            ToolTip="Server must be stopped. The current state is backed up first, so a restore can be undone."/>
                                    <Button Content="Open folder" Command="{Binding OpenBackupsFolderCommand}" Margin="0,0,16,4"/>
                                    <!-- One line: "Keep [10] of each kind · 0 keeps all". -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center"
                                                ToolTip="Older backups of the same kind (manual, daily, before-update, before-mods, before-restore) are deleted after each new one, and when you leave this box. 0 keeps every backup.">
                                        <TextBlock Text="Keep" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox Text="{Binding BackupsToKeepText, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="6,0,6,0" Padding="2,0"
                                                 HorizontalContentAlignment="Center" LostFocus="OnBackupsToKeepLostFocus"
                                                 AutomationProperties.Name="Backups to keep of each kind"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="12">
                                            <Run Text="of each kind"/><Run Text="  ·  0 keeps all" Foreground="{DynamicResource FaintForegroundBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding BackupsToKeepError}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                                           Visibility="{Binding BackupsToKeepError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <Grid>
                                <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock IsHitTestVisible="False"
                                           Text="No backups yet — Back up now makes one; Starlink also makes one before every update, mod change and restore.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="World settings">
                    <views:WorldSettingsView DataContext="{Binding WorldSettings}" Margin="0,8,0,0"/>
                </TabItem>

                <TabItem Header="Admins &amp; bans">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <!-- One grid for both lists: shared rows keep the two boxes level whatever the hints' length. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ADMINS" Style="{StaticResource ServerSectionLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ServerHintStyle}" Margin="0,0,0,6"
                                           Text="Steam64 ids, one per line. These players are admin without typing /AdminLogin (AdminWhitelist.txt). Known side effect from the official wiki: it breaks the lobby's prospect Delete button."/>
                                <Grid Grid.Row="2" Grid.Column="0">
                                    <TextBox Text="{Binding AdminWhitelistText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas"
                                             Height="240" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Admins"/>
                                    <TextBlock Text="One Steam64 id per line, like 76561198000000000" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Top" Margin="9,7,0,0"
                                               Visibility="{Binding AdminWhitelistText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                </Grid>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AdminListHint}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding AdminListHint, Converter={StaticResource NullToVisibilityConverter}}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="BAN LIST" Style="{StaticResource ServerSectionLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ServerHintStyle}" Margin="0,0,0,6"
                                           Text="PlayerBanList.txt as the server stores it. In game, admins can also type /BanPlayer name and /UnbanPlayer name in chat."/>
                                <Grid Grid.Row="2" Grid.Column="2">
                                    <TextBox Text="{Binding BanListText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas"
                                             Height="240" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Ban list"/>
                                    <TextBlock Text="Nobody is banned" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Top" Margin="9,7,0,0"
                                               Visibility="{Binding BanListText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                </Grid>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save lists" Command="{Binding SaveAccessListsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="Server must be stopped (it rewrites the ban list itself while running). Applies on the next start."/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ServerHintStyle}"
                                           Text="Saves both lists. The server must be stopped; they apply on its next start."/>
                            </StackPanel>
                            <TextBlock Text="ADMIN CHAT COMMANDS" Style="{StaticResource ServerSectionLabelStyle}" Margin="0,16,0,4"/>
                            <TextBlock Style="{StaticResource ServerHintStyle}"
                                       Text="Typed in game chat: /AdminLogin password, /KickPlayer, /BanPlayer, /UnbanPlayer, /ReturnToLobby, /AdminSay."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
