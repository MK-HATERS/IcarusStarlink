<Window x:Class="IcarusStarlink.App.Views.ManualInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install manually" Height="600" Width="980" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Mod Organizer's manual install, for Icarus: the download on the left, what will be
         installed (and as what) on the right, prefilled with Starlink's own guesses. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.3*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- Drag to give the download or the plan more room. -->
        <GridSplitter Grid.Column="1" Grid.Row="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext"
                      ToolTip="Drag to resize" AutomationProperties.Name="Resize panes"/>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource PageBodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="THE DOWNLOAD" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Add the selected file or folder as:" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                <WrapPanel>
                    <Button Content="Pak mod" Click="AddPak_Click" Margin="0,0,8,4" ToolTip="A .pak file, or a folder of .pak files, as one Library mod"/>
                    <Button Content="EXMOD mod" Click="AddExmod_Click" Margin="0,0,8,4" ToolTip="A folder with an .EXMOD in it, or an .EXMODZ/.zip holding one, as one Library mod"/>
                    <Button Content="UE4SS mod" Click="AddUe4ss_Click" Margin="0,0,8,4" ToolTip="A UE4SS mod folder (the one holding Scripts\main.lua)"/>
                </WrapPanel>
            </StackPanel>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <TreeView x:Name="FilesTree" BorderThickness="0" Background="Transparent">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="WILL BE INSTALLED" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="ProblemText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock x:Name="EmptyText" Text="Nothing yet — select something in the download and add it." Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <ItemsControl x:Name="PlanList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="6,1" VerticalAlignment="Top" Click="Remove_Click" Tag="{Binding}"
                                                    ToolTip="Leave this out" AutomationProperties.Name="Leave out"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" Width="110"
                                                              ToolTip="What this is: a pak mod and an EXMOD mod go to the Library; a UE4SS mod lands in the Library list unticked (tick it, then Apply UE4SS changes)"/>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="8,0,8,0"
                                                             ToolTip="Its name in Starlink" AutomationProperties.Name="Name"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RelativePath}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Install" Click="Install_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
