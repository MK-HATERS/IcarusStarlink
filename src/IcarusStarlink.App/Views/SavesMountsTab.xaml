<UserControl x:Class="IcarusStarlink.App.Views.SavesMountsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- The Saves page's Mounts tab: the mount list and the selected mount's inside. Same DataContext as SavesView (SavesViewModel). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SavesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260" MaxWidth="560"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Style="{StaticResource VerticalPaneSplitterStyle}" Width="16" AutomationProperties.Name="Resize mount list"/>

        <DockPanel Grid.Column="0">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource SaveSearchBoxStyle}" Tag="Search mounts…"
                     Text="{Binding MountSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search mounts"/>
            <ListBox ItemsSource="{Binding FilteredMounts}" SelectedItem="{Binding SelectedMount}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4,2,4">
                            <Ellipse Style="{StaticResource ChangedMarkStyle}"/>
                            <Button DockPanel.Dock="Right" Content="Delete" Padding="8,2"
                                    Command="{Binding DataContext.DeleteMountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="Removes this mount; nothing else in the list is touched"/>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0"
                                    Background="{DynamicResource CardRaisedBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}">
                                <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding TypeDisplayName, Mode=OneWay}"/><Run Text=" · Lv "/><Run Text="{Binding LevelText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedMount, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel DataContext="{Binding SelectedMount}" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{Binding TypeDisplayName}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           ToolTip="The species can't be changed: its talents and stats are stored with it."/>
                <WrapPanel Margin="0,6,0,0">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Level" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Text="{Binding LevelText, UpdateSourceTrigger=PropertyChanged}" Width="60" FontFamily="Consolas" TextAlignment="Right"/>
                            <TextBlock Text="{Binding ExperienceDisplay}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding CanEditInside, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Lineage" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding LineageTitles}" SelectedItem="{Binding LineageTitle}" Width="140" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding CanEditInside, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Look" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding VariationOptions}" SelectedItem="{Binding Variation}" Width="70" Margin="0,4,0,0"
                                  ToolTip="Which look (colours and pattern) of its species it has, counting from 0"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding GrowthNote}" FontSize="11.5" Foreground="{DynamicResource FaintForegroundBrush}" TextWrapping="Wrap"
                           Visibility="{Binding GrowthNote, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding InsideRefusal, Converter={StaticResource NullToVisibilityConverter}}">
                    <Run Text="Only the name and level in the mount list can be changed: "/><Run Text="{Binding InsideRefusal, Mode=OneWay}"/><Run Text=". The game may keep its own copies of them."/>
                </TextBlock>

                <StackPanel Visibility="{Binding CanEditInside, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Genetics" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,2"/>
                    <TextBlock Text="0 to 10; 3 is the middle." FontSize="11.5" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    <ItemsControl ItemsSource="{Binding Genes}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                                    <TextBlock Text="{Binding Title}" Width="80" VerticalAlignment="Center" FontSize="12.5"/>
                                    <Button Content="−" Padding="8,0" Command="{Binding DownCommand}" AutomationProperties.Name="{Binding Title, StringFormat='Lower {0}'}"/>
                                    <TextBlock Text="{Binding Value}" Width="28" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <Button Content="+" Padding="8,0" Command="{Binding UpCommand}" AutomationProperties.Name="{Binding Title, StringFormat='Raise {0}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,14,0,2">
                        <Run Text="Talents" FontWeight="SemiBold" FontSize="13"/><Run Text="   "/><Run Text="{Binding TalentSummary, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </TextBlock>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,4,0,4"
                            Visibility="{Binding OverBudget, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding OverBudget}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding TalentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource RankStepperTemplate}" Focusable="False"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12.5">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Tree, Mode=OneWay}" Foreground="{DynamicResource FaintForegroundBrush}" FontSize="10.5"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
