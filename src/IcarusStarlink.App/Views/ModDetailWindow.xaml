<Window x:Class="IcarusStarlink.App.Views.ModDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding Name}" Height="640" Width="720" MinHeight="420" MinWidth="480"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <!--
    Phase 10 follow-up: a popped-out version of Library's own detail pane, opened by double-
    clicking a mod row — non-modal (multiple can be open at once, same shape as the EXMOD editor's
    own per-mod windows) so a user can compare two mods side by side without losing either one when
    picking something else in the main tree. DataContext is the double-clicked LibraryItemViewModel
    directly (not "SelectedItem" — that would make this window's content follow whatever gets
    clicked next in the main window, defeating the point of popping it out), so every binding below
    matches the main detail pane's own bindings minus the "SelectedItem." prefix. The three actions
    that are page-level commands (Edit/Delete/Get update) reach back up via the Window's own
    LibraryViewModel property, set by the code-behind at construction time.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <WrapPanel>
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <Border Margin="8,0,0,4" CornerRadius="8" Padding="7,2" VerticalAlignment="Center"
                            Background="{DynamicResource InfoBrush}"
                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Source}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource WindowBackgroundBrush}"/>
                    </Border>
                    <Border Margin="6,0,0,4" CornerRadius="8" Padding="7,2" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource AccentForegroundBrush}">
                            <Run Text="Update available: v"/><Run Text="{Binding LatestVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Button Margin="6,0,0,4" Padding="7,2" VerticalAlignment="Center" FontSize="11"
                            Command="{Binding LibraryViewModel.GetUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Database mod: re-downloads from the catalog and replaces this copy in place (pin/favorite/notes kept, backup taken first). Nexus mod: opens its page — use Mod Manager Download there."
                            AutomationProperties.Name="Get update">
                        <TextBlock Text="Get update" VerticalAlignment="Center"/>
                    </Button>
                </WrapPanel>
                <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="{Binding Author, Mode=OneWay}"/>
                    <Run Text=" · v"/>
                    <Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>
                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Description}" Style="{StaticResource PageBodyTextStyle}"/>
                </ScrollViewer>

                <WrapPanel Margin="0,0,0,12">
                    <ToggleButton IsChecked="{Binding IsPinned}" Margin="0,0,8,4">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Content" Value="📌 Pin"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsFavorite}" Content="★ Favorite" Padding="10,5" Margin="0,0,16,4">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#332B2000"/>
                                        <Setter Property="BorderBrush" Value="#FFD24C"/>
                                        <Setter Property="Foreground" Value="#FFD24C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Margin="0,0,8,4"
                            Command="{Binding LibraryViewModel.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Open this mod's Item fields in the EXMOD editor" AutomationProperties.Name="Edit selected mod">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Edit…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,0,4"
                            Command="{Binding LibraryViewModel.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Delete selected mod">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1" Width="120" Height="120" Margin="12,0,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource CardRaisedBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform"
                          Visibility="{Binding ThumbnailImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4"
                           Visibility="{Binding ThumbnailImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Changes"
                     ToolTip="What this mod actually changes — read-only. For editing, see the EXMOD editor.">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0" MinHeight="110">
                    <TextBox Text="{Binding ChangesContent, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True" BorderThickness="0" Padding="8"/>
                </Border>
            </TabItem>
            <TabItem Header="Files">
                <Grid Margin="0,8,0,0" MinHeight="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding PakListingStatus, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding PakListingStatus}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                        <Button Content="Retry" Margin="8,0,0,0" Padding="8,2"
                                Command="{Binding LoadPakContentsCommand}"
                                AutomationProperties.Name="Retry loading pak contents"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding AssetPaths}"
                                 SelectedItem="{Binding SelectedAssetPath}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedAssetPreview, Mode=OneWay}"
                                 Margin="8,0,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Visibility="{Binding SelectedAssetImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <Border Grid.Column="1" Margin="8,0,0,0" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8"
                                Visibility="{Binding SelectedAssetImage, Converter={StaticResource NullToVisibilityConverter}}">
                            <Image Source="{Binding SelectedAssetImage}" Stretch="Uniform"
                                   StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Readme">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0" MinHeight="110">
                    <FlowDocumentScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                        Document="{Binding ReadmeContent, Mode=OneWay, Converter={StaticResource MarkdownToFlowDocumentConverter}}"/>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
