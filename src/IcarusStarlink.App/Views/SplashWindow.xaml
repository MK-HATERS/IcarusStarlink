<Window x:Class="IcarusStarlink.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Icarus Starlink" Height="220" Width="420"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Background="#10141A">

    <!--
    Shown before the DI host/theme service exist (App.OnStartup builds the host and runs the real
    startup work — including the Library folder scan, the one known real freeze risk — on a
    background thread while this stays responsive), so its colors are hardcoded to match the
    Icarus theme's own values rather than DynamicResource, which would resolve to nothing this
    early. It's meant to be genuinely fixed brand identity, not theme-reactive — the same way a
    real splash usually looks the same regardless of which in-app theme you'd normally pick.
    -->
    <Border BorderBrush="#2A3038" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="Icarus Starlink" FontSize="28" FontWeight="Bold" Foreground="#FF8A3D"/>
                <TextBlock Text="mod manager for Icarus" FontSize="13" Margin="0,4,0,0" Foreground="#9AA4B2"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Starting…" FontSize="12" Margin="0,0,0,10" Foreground="#9AA4B2"/>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Background="#1A1F26" Foreground="#FF8A3D" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
