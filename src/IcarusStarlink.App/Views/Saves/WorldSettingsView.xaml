<UserControl x:Class="IcarusStarlink.App.Views.WorldSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A slot's (or server's) saved worlds and their custom settings. DataContext: WorldSettingsViewModel. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <!-- The selected world's backups and Restore (only where the page says whose worlds these are). -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"
                        Visibility="{Binding ShowsBackups, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding SelectedWorld, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="BACKUPS OF THIS WORLD" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="None yet. Saving world settings or restoring backs the world up first; Find the broken mod backs up every world."
                               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="220" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                             AutomationProperties.Name="Backups of this world" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2" ToolTip="{Binding FileName}">
                                    <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding What}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding Note}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Restore selected" Command="{Binding RestoreBackupCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibilityConverter}}" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Puts this world back to the chosen backup. The world as it is now is backed up first. The game (or server) must be closed. Greyed out: pick a backup first."/>
                </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="WORLDS" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"
                       Visibility="{Binding HasNoWorlds, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ListBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding SelectedWorld}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     Visibility="{Binding HasWorlds, Converter={StaticResource BoolToVisibilityConverter}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- A world saved under an id is titled by its prospect; the id shows faint (WorldItemViewModel.Title). -->
                        <StackPanel Margin="0,3" ToolTip="{Binding Name}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RawId}" FontSize="10.5" Foreground="{DynamicResource FaintForegroundBrush}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding RawId, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="2" Visibility="{Binding SelectedWorld, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock FontSize="16" FontWeight="SemiBold">
                    <Run Text="{Binding SelectedWorld.Title, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SelectedWorld.RawId, Mode=OneWay}" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource FaintForegroundBrush}"/>
                </TextBlock>
                <TextBlock Text="{Binding SelectedWorld.Detail}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,4,0,0"
                           Text="The world's own custom settings, the same ones the game shows when you create a world. Difficulty and Hardcore can't change after a world is made. Saving backs the world up first; the game (or server) must be closed, since it rewrites its saves when it exits."/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Save world settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding HasChanges}" ToolTipService.ShowOnDisabled="True">
                    <!-- On the Server page it also greys out while the server runs or is busy; the tooltip then says why. -->
                    <Button.ToolTip>
                        <Binding Path="SaveBlockedReason" TargetNullValue="Backs this world up, then writes these settings into it. Only this world's file is written. Greyed out: nothing changed."/>
                    </Button.ToolTip>
                </Button>
                <Button DockPanel.Dock="Left" Content="Undo changes" Command="{Binding RevertCommand}" Margin="8,0,0,0" IsEnabled="{Binding HasChanges}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="460"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- Capped width, so each switch sits near its setting's name on a wide window. -->
                <ItemsControl ItemsSource="{Binding Rows}" MaxWidth="900" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsEditable}">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding BoolValue}" AutomationProperties.Name="{Binding Label}"
                                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}" Width="80" AutomationProperties.Name="{Binding Label}"
                                                 Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding Value}" MinWidth="160" AutomationProperties.Name="{Binding Label}"
                                                  Visibility="{Binding IsDropDown, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
