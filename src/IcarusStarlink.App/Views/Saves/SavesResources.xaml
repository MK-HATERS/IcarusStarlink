<!-- What the Saves page's tabs share: the row marks, the group headings, the rank stepper, the talent
     row and the search box. Merged into SavesView and each of its tab controls. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:IcarusStarlink.App.Views"
                    xmlns:converters="clr-namespace:IcarusStarlink.App.Converters">

    <converters:SaveGroupCountConverter x:Key="SaveGroupCountConverter"/>

    <!-- How wide a list row's content gets: on a wide window the rank stepper, count box or switch
         otherwise sits ~1,600 px from the name it belongs to. -->
    <sys:Double x:Key="SaveRowMaxWidth">1000</sys:Double>

    <!-- Talent and research rows: narrower, so the rank isn't a long way from its name. -->
    <sys:Double x:Key="SaveTalentRowMaxWidth">720</sys:Double>

    <!-- A row id ("Exploration_Base_Health") beside or under its readable name: the same faint size everywhere. -->
    <Style x:Key="SaveRawIdRunStyle" TargetType="Run">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource FaintForegroundBrush}"/>
    </Style>

    <Style x:Key="SaveRawIdTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource FaintForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- A row in a plain ItemsControl (no ListBoxItem to light it up): the same hover as list rows. -->
    <Style x:Key="SaveRowHoverStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Game icons (bestiary, items) are dark art on a transparent background: a light tile in
         every theme keeps them readable on the dark ones. -->
    <SolidColorBrush x:Key="SaveIconTileBrush" Color="#D3D8DF"/>

    <!-- A row changed since the last load or save: a small dot before it. -->
    <Style x:Key="ChangedMarkStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="DockPanel.Dock" Value="Left"/>
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="ToolTip" Value="Changed, not saved yet"/>
        <Setter Property="Visibility" Value="Hidden"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Where a row the game doesn't have comes from (SaveModSources): faint for a mod you have,
         accent for a leftover that Remove leftovers would take out. -->
    <Style x:Key="SaveRowSourceStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FaintForegroundBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Source.IsRemovable}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A grouped list's group (talent tree, workshop category, mission map, biome, accolade
         category): the app's Expander with the group's name and count ("9 of 14 complete"). The
         list's Tag carries the tab's own summary, so the count follows a row switched on or off.
         SaveGroupExpansion keeps a folded group folded while the list is searched or filtered
         (set SaveGroupExpansion.Scope on the list). -->
    <Style x:Key="SaveCollapsibleGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" views:SaveGroupExpansion.Remember="True" AutomationProperties.Name="{Binding Name}"
                              views:GroupColor.Index="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}">
                        <Expander.Header>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Style="{StaticResource GroupStripeStyle}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource GroupTitleStyle}"/>
                                <TextBlock Style="{StaticResource ExpanderHeaderStateStyle}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SaveGroupCountConverter}">
                                            <Binding/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DockPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Talents and Workshop groups: the same Expander, counting the whole tree (the page passes
         itself to the count), plus the list's two whole-tree buttons (SaveGroupActions). -->
    <Style x:Key="SaveActionGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" views:SaveGroupExpansion.Remember="True" AutomationProperties.Name="{Binding Name}"
                              views:GroupColor.Index="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource GroupStripeStyle}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupTitleStyle}"/>
                                <TextBlock Style="{StaticResource ExpanderHeaderStateStyle}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SaveGroupCountConverter}">
                                            <Binding/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Button Content="{Binding (views:SaveGroupActions.MaxLabel), RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Command="{Binding (views:SaveGroupActions.MaxCommand), RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding Name}" Padding="8,1" Margin="12,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                        ToolTip="Every row in this group to its highest rank, listed or not. Nothing is written until you save."/>
                                <Button Content="{Binding (views:SaveGroupActions.ResetLabel), RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Command="{Binding (views:SaveGroupActions.ResetCommand), RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding Name}" Padding="8,1" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                        ToolTip="Every row in this group back to 0, listed or not. Nothing is written until you save."/>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Bestiary's biome group: the same Expander, plus "Complete all" for that biome's
         listed creatures (CompleteBestiaryGroupCommand, with the group's name). -->
    <Style x:Key="SaveBestiaryGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" views:SaveGroupExpansion.Remember="True" AutomationProperties.Name="{Binding Name}"
                              views:GroupColor.Index="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource GroupStripeStyle}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupTitleStyle}"/>
                                <TextBlock Style="{StaticResource ExpanderHeaderStateStyle}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SaveGroupCountConverter}">
                                            <Binding/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Button Content="Complete all" Padding="8,1" Margin="12,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                        Command="{Binding DataContext.CompleteBestiaryGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Complete all: {0}'}"
                                        ToolTip="Fills every creature listed in this group (after the search and filter) to its full points"/>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One tier of a tiered accolade ("III"): a small chip, filled when earned. -->
    <Style x:Key="AccoladeTierChipStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chip" MinWidth="30" Padding="4,1" CornerRadius="4" Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- −, the rank, + : a character's talents, the account's research, a mount's talents. -->
    <!-- A talent on the tree view (TalentTreeView): its icon (or its name when it has none), its
         rank under it, lit when learned, green when at its highest rank, a dot when changed.
         Sizes are in the game's tree units: the tree is scaled as a whole. Blueprint and research
         icons are item art (dark on clear), so they sit on the light tile the Items tab uses. -->
    <Style x:Key="TalentNodeButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Frame" CornerRadius="16" BorderThickness="6" Background="{DynamicResource CardRaisedBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <Grid Margin="10">
                                <Image x:Name="Icon" Source="{Binding Talent.Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="Label" Text="{Binding Talent.DisplayName}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{Binding BadgeFontSize}" Foreground="{DynamicResource ForegroundBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Badge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-16" CornerRadius="8" Padding="10,0"
                                Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="3">
                            <TextBlock Text="{Binding Talent.RankDisplay}" FontSize="{Binding BadgeFontSize}" FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                        <Ellipse x:Name="Changed" Width="26" Height="26" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource ContentBackgroundBrush}" StrokeThickness="4"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,-8,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Talent.Model}" Value="Blueprint">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource SaveIconTileBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Talent.Model}" Value="Workshop">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource SaveIconTileBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Talent.Icon}" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Talent.IsSingleRank}" Value="True">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLit}" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLit}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Talent.IsMaxed}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Talent.IsDirty}" Value="True">
                            <Setter TargetName="Changed" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Opacity" Value="1"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.15"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tree / List on the Talents and Workshop tabs: two halves of one button. -->
    <Style x:Key="SaveViewModeButtonStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" Padding="12,3" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="RankStepperTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="−" Padding="8,0" Command="{Binding RankDownCommand}" AutomationProperties.Name="Rank down"/>
            <TextBlock Text="{Binding RankDisplay}" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
            <Button Content="+" Padding="8,0" Command="{Binding RankUpCommand}" IsEnabled="{Binding CanRankUp}" AutomationProperties.Name="Rank up"
                    ToolTip="One rank higher. Greyed out: it's at its highest rank, or (a mount's talent) it can't be added yet." ToolTipService.ShowOnDisabled="True"/>
        </StackPanel>
    </DataTemplate>

    <!-- A talent or research row: its name and row name, where a mod's comes from, the pack it
         needs, its research cost when it has one, and the rank stepper. -->
    <DataTemplate x:Key="SaveTalentRowTemplate">
        <!-- The star column stops at SaveTalentRowMaxWidth and stays left: a Stretch'd MaxWidth
             would centre. Narrower than other rows, so the rank sits near the name it belongs to. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource SaveTalentRowMaxWidth}"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        <DockPanel Margin="2">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Description}" Value="">
                            <Setter Property="ToolTip" Value="{Binding RowName}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Ellipse Style="{StaticResource ChangedMarkStyle}"/>
            <!-- One rank (a blueprint, a research): a switch. More: − 2/3 +. -->
            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RankStepperTemplate}" Focusable="False"
                                Visibility="{Binding IsMultiRank, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsDone}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding DisplayName}"
                          Visibility="{Binding IsSingleRank, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Visibility="{Binding Cost, Converter={StaticResource NullToVisibilityConverter}}"/>
            <!-- The game's picture, once it's loaded (blueprint and research icons are item art: the light tile). -->
            <Border DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" CornerRadius="5"
                    Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Model}" Value="Blueprint">
                                <Setter Property="Background" Value="{StaticResource SaveIconTileBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Model}" Value="Workshop">
                                <Setter Property="Background" Value="{StaticResource SaveIconTileBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <!-- The row id shows only while the row is hovered: the name is what's read. -->
                <TextBlock FontSize="12.5">
                    <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding RowName, Mode=OneWay}">
                        <Run.Style>
                            <Style TargetType="Run" BasedOn="{StaticResource SaveRawIdRunStyle}">
                                <Setter Property="Foreground" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource FaintForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                </TextBlock>
                <TextBlock Text="{Binding Source.Label}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource SaveRowSourceStyle}"/>
                <TextBlock Text="{Binding PackNote}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Visibility="{Binding PackNote, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- A number box Save checks (XP, currencies, appearance values, bestiary points, mount level):
         Tag carries the row's HasNumberError / HasXpError, and while it's true the border is the
         app's error colour, even while the box has focus (the stock template's focus colour would
         hide it as you type). The line under the box is SaveNumberErrorTextStyle. -->
    <Style x:Key="SaveNumberBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <!-- Last, so it wins over hover and focus. -->
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The short line under a number box Save would refuse ("Whole number, digits only"). Bind Text to the row's error; hidden while it's null. -->
    <Style x:Key="SaveNumberErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A search box with its hint inside (Tag) while it's empty. Based on the app's own TextBox
         look; only the template adds the hint, so the app-wide theme stays as it is. -->
    <Style x:Key="SaveSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Style="{StaticResource PlaceholderTextStyle}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
