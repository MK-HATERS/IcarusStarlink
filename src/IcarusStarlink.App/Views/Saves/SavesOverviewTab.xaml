<UserControl x:Class="IcarusStarlink.App.Views.SavesOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- The Saves page's Overview tab: character cards, the account snapshot, the save check and leftovers from old mods. Same DataContext as SavesView (SavesViewModel). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SavesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Characters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.EditCharacterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Padding="0" Margin="0,0,12,12"
                                AutomationProperties.Name="{Binding Name}"
                                ToolTip="Click to edit this character">
                            <Border Width="240" Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                        <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                                Background="{DynamicResource DangerSoftBrush}"
                                                Visibility="{Binding IsDead, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="DEAD" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource DangerBrush}"/>
                                        </Border>
                                        <Border Margin="6,0,0,0" CornerRadius="8" Padding="6,1" VerticalAlignment="Center" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                Visibility="{Binding OverBudget, Converter={StaticResource NullToVisibilityConverter}}"
                                                ToolTip="{Binding OverBudget, StringFormat='More ranks than points: {0}. The game keeps them; see the Talents tab.'}">
                                            <TextBlock Text="OVER BUDGET" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="Slot "/><Run Text="{Binding ChrSlot, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LocationDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,8,0,0" FontFamily="Consolas" FontSize="13">
                                        <Run Text="XP " Foreground="{DynamicResource FaintForegroundBrush}"/><Run Text="{Binding XpDisplay, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Account snapshot -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" HorizontalAlignment="Left" MinWidth="360" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Account" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Currencies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2,18,2" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Save check (SaveChecker) -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" HorizontalAlignment="Left" MaxWidth="900" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Check again" Command="{Binding RunSaveCheckCommand}" Padding="10,3"/>
                        <Button DockPanel.Dock="Right" Content="Fix all sure ones…" Command="{Binding FixAllFindingsCommand}" Padding="10,3" Margin="0,0,8,0"
                                Visibility="{Binding HasFixableFindings, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Makes every fix offered for the problems and warnings below. Notes are left to you (DLC notes too, unless the switch beside this is on)."/>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" Content="Include DLC and Supporter" IsChecked="{Binding FixAllIncludesDlc}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Fix all also ticks the DLC and Supporters Edition packs named in the notes below, in the save's DLC list. Icarus rebuilds that list from what your account owns when it starts."/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Save check" FontWeight="SemiBold" FontSize="14"/><Run Text="   "/><Run Text="{Binding CheckSummary, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,6" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Checks what Save would write, unsaved edits included. DLC and Supporter Edition items only get notes: the game checks what you own by itself."/>
                    <ItemsControl ItemsSource="{Binding CheckFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding FixLabel}" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.FixFindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Border DockPanel.Dock="Left" CornerRadius="8" Padding="6,0" Margin="0,1,8,0" VerticalAlignment="Top" MinWidth="58">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Problem">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SeverityLabel}" FontSize="10.5" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Problem">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5">
                                        <Run Text="{Binding Area, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Leftovers from mods the user no longer has (SaveModSources) -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" HorizontalAlignment="Left" MaxWidth="720" Margin="0,12,0,0"
                    Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Leftovers from old mods" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="This save still has talents, research or items that no installed mod and no mod in your Library gives (or that the game itself removed). The game ignores them; taking them out tidies the save and gives back the talent points they used."/>
                    <TextBlock Text="{Binding LeftoversSummary}" FontFamily="Consolas" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ModsInUseSummary}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                               Visibility="{Binding ModsInUseSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Before removing a UE4SS mod, check here first: things a mod gives are marked &quot;From &lt;mod&gt;&quot; on the Talents, Workshop, Missions and Items tabs, and once the mod is gone they show up in this list. Starlink can read UE4SS mods that add things through ArcFission (like WirelessPower), but not script mods that add talents some other way, so look over the list before removing."/>
                    <Button Content="Remove leftovers…" Command="{Binding RemoveLeftoversCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
