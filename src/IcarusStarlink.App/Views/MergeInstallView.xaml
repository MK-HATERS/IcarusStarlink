<UserControl x:Class="IcarusStarlink.App.Views.MergeInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageHeaderStyle}"/>

        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            <ComboBox DockPanel.Dock="Left" Width="160" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" Margin="0,0,12,0"
                      IsEnabled="{Binding IsNotRebuilding}"/>
            <Button DockPanel.Dock="Left" Content="Save profile" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotRebuilding}"
                    ToolTip="Saves the queue and merge options under this profile (the previous version is kept as a backup)"/>
            <Button DockPanel.Dock="Left" x:Name="ProfileMenuButton" Content="Profile ▾" Click="DropdownButton_Click" Margin="0,0,8,0" IsEnabled="{Binding IsNotRebuilding}"
                    ToolTip="New, rename, restore a backup, delete">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New profile…" Command="{Binding NewProfileCommand}" ToolTip="Saves the current queue and options as a new profile"/>
                        <MenuItem Header="Rename profile…" Command="{Binding RenameProfileCommand}"/>
                        <MenuItem Header="Restore profile backup" Command="{Binding RestoreProfileBackupCommand}" IsEnabled="{Binding CanRestoreProfileBackup}"
                                  ToolTip="Replaces this profile with its own most recent backup — every save keeps a backup of the version before it (greyed out: no backup yet)"
                                  ToolTipService.ShowOnDisabled="True"/>
                        <Separator/>
                        <MenuItem Header="Delete profile" Command="{Binding DeleteProfileCommand}" ToolTip="Deletes this saved queue+options preset — never touches any mod in your Library"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Border/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{Binding ProfileStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="0,4,0,0"
                   TextWrapping="Wrap" Visibility="{Binding ProfileStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- Sharing a mod list: collapsed by default — exporting/importing a patch is a real but
             occasional action, not something a returning user needs to see every time. Classic IMM
             migration lives only in Settings now (Migrate from IMM tab) — a second, queue-only
             "Import IMM mod list" here looked redundant with it and was removed. -->
        <Expander Grid.Row="3" Margin="0,16,0,0" IsExpanded="False" AutomationProperties.Name="Share a mod list">
            <Expander.Header>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Share a mod list" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                    <TextBlock DockPanel.Dock="Left" Text="Export patch · Import patch (for friends and servers)" Style="{StaticResource ExpanderHeaderStateStyle}"/>
                </DockPanel>
            </Expander.Header>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ExportPatchCommand}" IsEnabled="{Binding IsNotExportingPatch}"
                        ToolTip="Share the selected profile's mod list with a friend or server — bundles anything not in the community catalog"
                        AutomationProperties.Name="Export patch">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Export patch…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportPatchCommand}" Margin="8,0,0,0"
                        ToolTip="Load a patch someone shared — recreates its profile and syncs any bundled mods into your Library"
                        AutomationProperties.Name="Import patch">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Import patch…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Expander>
        <TextBlock Grid.Row="4" Text="{Binding PatchStatusMessage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                   Visibility="{Binding PatchStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- Two columns now, not three: Library's own browsing pane left this page entirely
             (redesign-round-2 pilot) — mods reach the queue from Library itself (multi-select +
             right-click "Add to merge queue"), so this page only ever needs to own the queue and
             the merge options. The gap between them is a splitter: drag it to widen either one. -->
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize"
                          AutomationProperties.Name="Resize the queue and merge options"/>

            <!-- Queue + Rebuild + Install pane. The queue's own edit buttons sit right under it;
                 the checks and Install get their own line below, Install on the right where the
                 eye ends. Compare, Copy to game, Remove and Restore — real but occasional —
                 collapse into one "Advanced actions" section at the bottom. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" TextTrimming="CharacterEllipsis"
                               ToolTip="The mods Install builds into the game, in order. When two change the same value, the one lower in the list wins.">
                        <Run Text="Mods to merge ("/><Run Text="{Binding QueueCount, Mode=OneWay}"/><Run Text=") — the lower one wins a conflict"/>
                    </TextBlock>
                    <!-- Phase 10: a proactive conflict-count badge — surfaces a problem before the
                         user thinks to click Review conflicts. -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="7,1"
                            Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold">
                            <Run Text="{Binding ConflictCount, Mode=OneWay}"/><Run Text=" conflict(s)"/>
                        </TextBlock>
                    </Border>
                    <!-- Same proactive-badge pattern as conflicts, for a different question: not
                         "do two mods disagree" but "will this mod's own content actually work". -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="7,1" Margin="0,0,6,0"
                            Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold">
                            <Run Text="{Binding ValidationIssueCount, Mode=OneWay}"/><Run Text=" issue(s)"/>
                        </TextBlock>
                    </Border>
                </DockPanel>

                <!-- Phase 10: a banner surfacing conflicts right above the queue, not just a count
                     off to the side — matches the mockup's own conflict-banner treatment. Docked
                     with the ListBox in one DockPanel so the two never overlap in the same cell. -->
                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,8"
                            Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Review" Command="{Binding ReviewConflictsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Review conflicts from banner"/>
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Stroke="{DynamicResource DangerBrush}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <!-- Counted by MergeConflictTally, the same count Review conflicts lists. -->
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConflictTally.BannerText}" TextWrapping="Wrap" FontSize="11.5"/>
                                <TextBlock Text="{Binding ConflictTally.CombinedText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConflictTally.CombinedAutomatically}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Same banner treatment as the conflict one above, for validation findings —
                         both can show at once (stacked, DockPanel.Dock="Top" on each), since a conflict
                         and a validation issue are independent problems a queue can have simultaneously. -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,8"
                            Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Review" Command="{Binding ReviewValidationIssuesCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Review validation issues from banner"/>
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Stroke="{DynamicResource DangerBrush}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <!-- One line, so a small window keeps its height for the queue; the long
                                 explanation is the tooltip. -->
                            <TextBlock Margin="0,0,10,0" TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center"
                                       ToolTip="Changes the game won't use (a field or link that isn't real), two mods overwriting the same file, or talent and workshop nodes on top of each other or that can't be unlocked. Review lists them.">
                                <Run Text="{Binding ValidationIssueCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/><Run Text=" issue(s) in the queued mods — Review lists them."/>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <Grid>
                    <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueEntry}" MinHeight="100"
                             ToolTip="Drag a row to reorder the queue" IsEnabled="{Binding IsNotRebuilding}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="QueueList_PreviewMouseMove"
                             Drop="QueueList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Type tag, the same look as the Library's Type column. The queue only
                                         holds Library mods, so it's EXMOD or Pak. -->
                                    <Border CornerRadius="8" Padding="6,0" Margin="0,0,7,0" VerticalAlignment="Center" MinWidth="44"
                                            Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="EXMOD"/>
                                                    <Setter Property="ToolTip" Value="EXMOD: an editable data mod, merged field by field"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOpaquePak}" Value="True">
                                                            <Setter Property="Text" Value="Pak"/>
                                                            <Setter Property="ToolTip" Value="Prebuilt .pak — no field-level merge; its files are folded into the merged pak as-is on Rebuild"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <!-- A profile's mod that isn't in the Library: kept in its place, skipped by a build. -->
                                                    <DataTrigger Binding="{Binding IsMissingFromLibrary}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Setter Property="ToolTip" Value="Not in your Library any more, so it's left out of the build. Import it again and it takes this place back."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="missing — skipped" FontSize="10.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontStyle="Italic"
                                               Visibility="{Binding IsMissingFromLibrary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <!-- Per-row conflict indicator — shows without needing to open Review
                                         conflicts first. Both bindings reach the page-level ViewModel's own
                                         ConflictingModNamesByMod from inside this per-row DataTemplate, the
                                         same AncestorType=UserControl relay this app already uses elsewhere
                                         to reach a page ViewModel from inside a nested template. The tooltip
                                         sits on a transparent Border: a Path with no fill only takes the mouse
                                         on its thin stroke, so the reason hardly ever showed. -->
                                    <Border Background="Transparent" Padding="3,0" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource QueueConflictVisibilityConverter}">
                                                <Binding Path="Name"/>
                                                <Binding Path="DataContext.ConflictingModNamesByMod" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <Border.ToolTip>
                                            <MultiBinding Converter="{StaticResource QueueConflictTooltipConverter}">
                                                <Binding Path="Name"/>
                                                <Binding Path="DataContext.ConflictingModNamesByMod" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Border.ToolTip>
                                        <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Mods only reach this queue from Library (tick ON), so the empty list points there. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Nothing queued — turn mods on in Library." Style="{StaticResource EmptyStateTextStyle}" Margin="16,8,16,8"/>
                        <Button Content="Go to Library" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Center"
                                ToolTip="Tick a mod's ON box there (or right-click › Add to merge queue)"/>
                    </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- WrapPanel, not StackPanel: at narrower widths the trailing buttons were clipped
                     off the column's edge with no way to reach them. Only the queue's own edits live
                     here; the checks and Install have their own line below (Grid.Row="3"). -->
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <!-- The queue edits are off while a build runs (it builds what was queued when it started). -->
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsNotRebuilding}">
                    <Button Command="{Binding MoveQueueEntryUpCommand}" Style="{StaticResource IconButtonStyle}"
                            Width="30" ToolTip="Move up" AutomationProperties.Name="Move up" Margin="0,0,4,0">
                        <Path Data="{StaticResource IconArrowUp}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding MoveQueueEntryDownCommand}" Style="{StaticResource IconButtonStyle}"
                            Width="30" ToolTip="Move down" AutomationProperties.Name="Move down" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconArrowDown}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding RemoveFromQueueCommand}" Margin="0,0,8,0" AutomationProperties.Name="Remove from queue">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Clear" Command="{Binding ClearQueueCommand}" Margin="0,0,8,0" ToolTip="Empties the queue — each mod's ON tick in Library goes off too (nothing is deleted)"/>
                    <Button Content="More ▾" Click="DropdownButton_Click" Margin="0,0,0,0" ToolTip="Suggest an order, set a baseline">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Suggest order" Command="{Binding SuggestQueueOrderCommand}"
                                          ToolTip="Proposes reordering the queue so mods making fewer real edits sit later and win conflicts. Shows the new order and asks before changing anything."/>
                                <MenuItem Header="Set baseline" Command="{Binding SetBaselineCommand}"
                                          ToolTip="Saves the current queue as your baseline — these mods are auto-added (lowest priority) to every profile's queue from now on. With an empty queue it clears the baseline."/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </StackPanel>
                </WrapPanel>

                <!-- Check, then install: the two checks on the left, Install docked right. -->
                <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                    <!-- One button now does the whole "merge, then install" flow — chained internally
                         (RebuildAndInstallCommand), not merged into one method, so the real-game-write
                         confirmation dialog still appears only right before that actual write, after
                         the safe local rebuild step completes. Label reflects whether this app already
                         has something installed (a fresh "Install" vs. re-running it as "Update install"). -->
                    <Button DockPanel.Dock="Right" Command="{Binding RebuildAndInstallCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{Binding InstallButtonLabel}"
                            ToolTip="Merges the queue into a pak and installs it into the real game folder, in one step (it asks before writing to the game)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMerge}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding InstallButtonLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Left" Content="Review conflicts" Command="{Binding ReviewConflictsCommand}" Margin="0,0,8,0"
                            ToolTip="See which values two or more queued mods change differently, and pick a winner per value instead of the default (the mod lower in the list wins)"/>
                    <Button DockPanel.Dock="Left" Content="Validate mods" Command="{Binding ReviewValidationIssuesCommand}" Margin="0,0,8,0"
                            ToolTip="Checks the queued mods against the game data and each other: a mistyped or renamed field, a recipe pointing at an item that doesn't exist, two mods overwriting the same file, talent nodes on top of each other. These merge fine but do nothing in game."/>
                </DockPanel>

                <!-- What the last action said; a line with nothing to say takes no room. The install
                     result is here too, not only inside Advanced actions, since Install is the main button. -->
                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ConflictStatusMessage}" Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap"
                               Visibility="{Binding ConflictStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ValidationStatusMessage}" Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding ValidationStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding InstallStatusMessage}" Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding InstallStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,8,0,0" Visibility="{Binding IsRebuilding, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding RebuildProgressPercent, Mode=OneWay}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding RebuildStageText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource FieldLabelStyle}" FontWeight="Normal"/>
                </Grid>

                <!-- The last build's warnings and notes: only shown when there are some, open so
                     they're read, and foldable once they have been. -->
                <Expander Grid.Row="6" Margin="0,10,0,0" IsExpanded="True" AutomationProperties.Name="Build warnings and notes">
                    <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Warnings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Build warnings and notes" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ExpanderHeaderStateStyle}">
                                <Run Text="{Binding Warnings.Count, Mode=OneWay}"/><Run Text=" line(s) from the last build"/>
                            </TextBlock>
                        </DockPanel>
                    </Expander.Header>
                    <ListBox ItemsSource="{Binding Warnings}" MaxHeight="160" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                <!-- Compare + the installed pak's tools: real, occasionally-needed, folded into one
                     collapsed section — none competes with Install for a new user's attention, but
                     all stay one click away. -->
                <Expander Grid.Row="7" Margin="0,14,0,0" IsExpanded="False" AutomationProperties.Name="Advanced actions">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Advanced actions" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Text="Compare · Copy to game · Remove from game · Restore previous install" Style="{StaticResource ExpanderHeaderStateStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="Compare" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" FontSize="13"/>
                        <WrapPanel>
                            <Button Content="Compare to installed" Command="{Binding CompareToInstalledCommand}" Margin="0,0,0,4"
                                    ToolTip="Lists which mods Install would add (+), take out (-) or leave (=), against the merged pak in the game now."/>
                            <Button Content="Compare paks…" Command="{Binding ComparePaksCommand}" Margin="8,0,0,4"
                                    ToolTip="Unpack any two .pak files and see exactly how they differ, row by row — e.g. check a rebuilt pak matches a known-good one from another tool."/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ComparisonStatusMessage}" Margin="0,6,0,0"
                                   Style="{StaticResource FieldLabelStyle}" FontWeight="Normal" TextWrapping="Wrap"
                                   Visibility="{Binding ComparisonStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ListBox ItemsSource="{Binding ComparisonEntries}" Margin="0,8,0,0" MaxHeight="160" FontSize="12" FontFamily="Consolas">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ComparisonEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <Border Style="{StaticResource SectionDividerStyle}" Margin="0,14,0,10"/>
                        <TextBlock Text="The merged pak in the game" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" FontSize="13"/>
                        <WrapPanel IsEnabled="{Binding IsInstallIdle}">
                            <!-- The spec's "Copy built pack to game" / Retry: installs the already-staged
                                 pak without remerging. Shown only when there is one to copy. -->
                            <Button Command="{Binding CopyToGameCommand}" Margin="0,0,8,4"
                                    Visibility="{Binding CanCopyToGame, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Copies the already-built pak into the game without rebuilding it — use this if Icarus was running when Install failed"
                                    AutomationProperties.Name="Copy to game">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Copy to game" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveFromGameCommand}" Margin="0,0,0,4"
                                    ToolTip="Uninstalls IcarusStarlink's pak from the real game folder (backed up first) — doesn't touch your Library"
                                    AutomationProperties.Name="Remove from game">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Remove from game" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RestorePreviousInstallCommand}" Content="Restore previous install" Margin="8,0,0,4"
                                    ToolTip="Puts back the merged pak that was installed before the current one, with its mod list. What's installed now is backed up first, so you can switch back."/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </Grid>

            <!-- Gameplay-toggle merge options: applied as a final pass after the queue is merged,
                 even with an empty queue — matching classic IMM's own documented behavior.
                 Collapsed by default (redesign-round-2 pilot): a new user landing on this page
                 doesn't need to parse 8 controls across 3 groups just to find Install, but the
                 collapsed header's own summary keeps whatever IS active from being hidden. -->
            <Expander Grid.Column="2" IsExpanded="False" AutomationProperties.Name="Merge options" IsEnabled="{Binding IsNotRebuilding}">
                <!-- Open, it takes the column's whole height (its list scrolls inside); closed, it's just the header. -->
                <Expander.Style>
                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Merge options" Style="{StaticResource ExpanderHeaderTitleStyle}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveOptionsSummary}" Style="{StaticResource ExpanderHeaderStateStyle}"
                                   ToolTip="{Binding ActiveOptionsSummary}"/>
                    </DockPanel>
                </Expander.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <!-- Phase 10: the leveled options (multiple values, not on/off) are now pill
                         selectors instead of dropdowns, matching the mockup — real hints from
                         classic IMM's own documented numbers move onto a small (i) icon next to
                         the label instead of hovering the control itself, since a 3-way pill has
                         no one obvious hover target the way a ComboBox did. -->
                    <TextBlock Text="PLAYER BOOSTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                        <TextBlock Text="Speed Boost" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="Level 1: +100 move speed, +19 crouch/+50 sprint speed coefficient. Level 2: +245 move speed, +34 crouch/+100 sprint speed coefficient. (Classic IMM's own documented values.)">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding BoostLevels}" SelectedItem="{Binding SpeedBoost}"
                             Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource GameplayLevelToShortLabelConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Higher level = faster walking, crouching and sprinting. Off = normal speed." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="Player Boost" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="Level 1/2: more health/stamina/weight capacity, less food/water/oxygen consumption, faster regen, no fall damage, cold/heat resistance. (Classic IMM's own documented values.)">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding BoostLevels}" SelectedItem="{Binding PlayerBoost}"
                             Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource GameplayLevelToShortLabelConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Higher level = tougher: more health, stamina and carry weight, and you need less food, water and oxygen. Off = normal." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="XP Boost" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="Level 1: +200% XP. Level 2: +500% XP. Level 3: +1000% XP. (Classic IMM's own documented values.)">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding XpBoostLevels}" SelectedItem="{Binding XpBoost}"
                             Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource GameplayLevelToShortLabelConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Higher level = more XP from everything (L1 +200%, L2 +500%, L3 +1000%). Off = normal XP." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>

                    <Border Style="{StaticResource SectionDividerStyle}" Margin="0,16,0,10"/>
                    <TextBlock Text="CRAFTING &amp; ECONOMY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FaintForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                        <TextBlock Text="Craft Cost" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="Reduces the item/resource inputs every crafting-bench recipe needs. Never touches what a recipe outputs. Free (Creative mode) zeroes every input outright rather than rounding it down. (Classic IMM's own documented values.)">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding CraftCostReductions}" SelectedItem="{Binding CraftCost}"
                             Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource GameplayLevelToShortLabelConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Higher = recipes need fewer ingredients; Free = no ingredients at all (creative mode). Off = normal costs." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource FaintForegroundBrush}" Margin="0,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="Stacks multiplier" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="e.g. 3x = triple every item's stack size. Off = unchanged.">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding MultiplierOptions}" SelectedItem="{Binding StacksMultiplierLevel}"
                             Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource GameplayLevelToShortLabelConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Higher = bigger stacks (3x fits three times as many in one slot). Off = normal stack sizes."/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="Slots multiplier" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="e.g. 2x = double every backpack/container's slot count. Off = unchanged.">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding MultiplierOptions}" SelectedItem="{Binding SlotsMultiplierLevel}"
                             Style="{StaticResource LevelPillListBoxStyle}" ItemContainerStyle="{StaticResource LevelPillItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource GameplayLevelToShortLabelConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Higher = more slots in backpacks and containers (2x doubles them). Off = normal slot counts."/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="Speed Crafting" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="e.g. 50% = halve every recipe's crafting time, including recipes that use the game's default time. 0 = unchanged.">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                        <TextBlock Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding SpeedCraftingPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SpeedCraftingPercent}" Margin="0,4,0,0"
                            ToolTip="Drag or click to set — 0 means unchanged"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Lower = closer to normal crafting time (0% = unchanged). Higher = faster crafting (50% = half the time)."/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="Faster Taming" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="e.g. 50% = halve every creature's taming time. 0 = unchanged.">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                        <TextBlock Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding TamingSpeedPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TamingSpeedPercent}" Margin="0,4,0,0"
                            ToolTip="Drag or click to set — 0 means unchanged"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Lower = closer to normal taming time (0% = unchanged). Higher = faster taming (50% = half the time)."/>

                    <Border Style="{StaticResource SectionDividerStyle}" Margin="0,16,0,10"/>
                    <TextBlock Text="OTHER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FaintForegroundBrush}"/>

                    <!-- Lighter Items is a slider; the three after it are genuine on/off toggles (Phase 10), replacing plain checkboxes. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock Text="Lighter Items" FontSize="12"/>
                        <Border Style="{StaticResource InfoHintTouchTargetStyle}"
                                ToolTip="e.g. 50% = every item weighs half as much. 100% = weightless, the old Remove Weight. 0 = unchanged.">
                            <Path Style="{StaticResource InfoHintIconStyle}"/>
                        </Border>
                        <TextBlock Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding WeightReductionPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding WeightReductionPercent}" Margin="0,4,0,0"
                            ToolTip="Drag or click to set — 0 means unchanged, 100 means weightless"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource FaintForegroundBrush}"
                               Text="Lower = closer to normal weight (0% = unchanged). Higher = lighter items (50% = half the weight, 100% = weightless)."/>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UnlimitedAmmo}" Margin="0,12,0,0"
                              Content="Unlimited Ammo"
                              ToolTip="Weapons stop consuming ammo on fire, but still need at least 1 round in the magazine"/>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DisableTemperatures}" Margin="0,12,0,0"
                              Content="Disable Temperatures"
                              ToolTip="Removes hot/cold environmental damage and temperature management entirely"/>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RemoveLevelCap}" Margin="0,12,0,0"
                              Content="Remove Level Cap"
                              ToolTip="Raises the displayed/tracked level cap from 60 to 50000 (and the underlying XP cap from 1000 to match), matching the real community mod laanp-RealLevels — display/tracking only, does not itself grant extra talent, blueprint, or solo points beyond what the base progression curves award past level 60"/>
                </StackPanel>
                </ScrollViewer>
            </Expander>

        </Grid>
    </Grid>
</UserControl>
