<Window x:Class="IcarusStarlink.App.Views.CatalogEntryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:IcarusStarlink.App.Converters"
        mc:Ignorable="d"
        Title="{Binding Name}" Width="440" SizeToContent="Height" MaxHeight="720" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <!-- A catalog's image link can name a picture of any size: decoded at window size. -->
        <converters:WebPictureConverter x:Key="WebPictureConverter" DecodePixelWidth="800"/>
    </Window.Resources>

    <!--
    "Show more details" — non-modal, same shape as ModDetailWindow's own pop-out, opened from the
    IMM Database tab's compact side panel (which only has room for name/author/version/a truncated
    description). DataContext is the CatalogEntryViewModel row directly. The two buttons run
    DownloadsViewModel's commands (through the window's Downloads property) with this row as their
    parameter, not the grid's selection: the selection can move while this window stays open.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <Grid Height="200" Margin="0,0,0,14">
                <Border Background="{DynamicResource CardRaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Path Data="{StaticResource IconMountains}" Stroke="{DynamicResource FaintForegroundBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="40" Height="40" Stretch="Uniform"/>
                </Border>
                <!-- Sits on top of the placeholder above and only becomes visible once a real
                     ImageUrl exists, rather than needing an inverse-condition second element. -->
                <Image Source="{Binding Entry.ImageUrl, Converter={StaticResource WebPictureConverter}}" Stretch="UniformToFill"
                       Visibility="{Binding Entry.ImageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
            </Grid>

            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,14" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                <Run Text="{Binding Author, Mode=OneWay}"/>
                <Run Text=" · v"/>
                <Run Text="{Binding Version, Mode=OneWay}"/>
                <Run Text=" · "/>
                <Run Text="{Binding SourceDisplay, Mode=OneWay}"/>
            </TextBlock>

            <TextBlock Text="{Binding Entry.Description}" TextWrapping="Wrap" Style="{StaticResource PageBodyTextStyle}" Margin="0,0,0,16"/>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Category" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding CategoryDisplay}" FontSize="12" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Compatibility" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding CompatibilityDisplay}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Last updated" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding LastUpdatedDisplay}" FontSize="12"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Command="{Binding Downloads.DownloadAndExtractCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                    IsEnabled="{Binding HasDownloadableFile}"
                    ToolTip="Downloads this mod and adds it to your Library. Greyed out: the database has no download link for it — use its page instead." ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Download and extract">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Download &amp; extract" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding Downloads.OpenCatalogReadmeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" IsEnabled="{Binding HasReadme}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Opens the mod's readme in your browser. Greyed out: the database has no readme link for it."
                    AutomationProperties.Name="Open readme">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Open readme" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>
