<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10141A"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#10141A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C232C"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8A3D"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#17110A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A323D"/>
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#1F2731"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush" Color="#26303D"/>

    <!-- Phase 10 redesign additions: one elevation step above CardBackground, plus semantic
         (not accent) colors for conflict/success/info states — kept separate from AccentBrush so
         a badge/toggle doesn't compete visually with primary actions. -->
    <SolidColorBrush x:Key="CardRaisedBackgroundBrush" Color="#232B36"/>
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="#5B6472"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FF8A3D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C72"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF5C72"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#52D68A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2052D68A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#5FA8FF"/>

    <!-- More colour (2026-10-28): amber for "waiting / needs a look" (orange stays the accent for
         buttons), one colour per mod type and per source, and six heading colours that grouped
         lists cycle through in order (GroupColor). -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F5B83D"/>
    <SolidColorBrush x:Key="TagExmodBrush" Color="#3ED6C8"/>
    <SolidColorBrush x:Key="TagPakBrush" Color="#6FA8FF"/>
    <SolidColorBrush x:Key="TagUe4ssBrush" Color="#B98CFF"/>
    <SolidColorBrush x:Key="TagPakUe4ssBrush" Color="#F38BD0"/>
    <SolidColorBrush x:Key="SourceNexusBrush" Color="#F0A35E"/>
    <SolidColorBrush x:Key="SourceDatabaseBrush" Color="#7FD4F5"/>
    <SolidColorBrush x:Key="GroupColor0Brush" Color="#5FA8FF"/>
    <SolidColorBrush x:Key="GroupColor1Brush" Color="#52D68A"/>
    <SolidColorBrush x:Key="GroupColor2Brush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="GroupColor3Brush" Color="#B98CFF"/>
    <SolidColorBrush x:Key="GroupColor4Brush" Color="#FF7FAF"/>
    <SolidColorBrush x:Key="GroupColor5Brush" Color="#3ED6C8"/>

</ResourceDictionary>
