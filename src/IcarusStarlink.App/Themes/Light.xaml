<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8D8DC"/>
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#ECECEF"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush" Color="#E3E8FD"/>

    <!-- Phase 10 redesign additions — see Icarus.xaml's own comment for why these exist. InfoBrush
         is teal rather than blue here specifically, since this theme's own AccentBrush is already
         blue — a blue info color would be indistinguishable from an accented/primary element. -->
    <SolidColorBrush x:Key="CardRaisedBackgroundBrush" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="#9A9AA0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2563EB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1ADC2626"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1A16A34A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0891B2"/>

</ResourceDictionary>
