<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8D8DC"/>
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#ECECEF"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush" Color="#E3E8FD"/>

    <!-- Phase 10 redesign additions — see Icarus.xaml's own comment for why these exist. InfoBrush
         is teal rather than blue here specifically, since this theme's own AccentBrush is already
         blue — a blue info color would be indistinguishable from an accented/primary element. -->
    <SolidColorBrush x:Key="CardRaisedBackgroundBrush" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="#9A9AA0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2563EB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1ADC2626"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1A16A34A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0891B2"/>

    <!-- More colour: see Icarus.xaml. Deeper shades, so text in them reads on white. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1AB45309"/>
    <SolidColorBrush x:Key="TagExmodBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="TagPakBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="TagUe4ssBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="SourceNexusBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="SourceDatabaseBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="GroupColor0Brush" Color="#2563EB"/>
    <SolidColorBrush x:Key="GroupColor1Brush" Color="#15803D"/>
    <SolidColorBrush x:Key="GroupColor2Brush" Color="#B45309"/>
    <SolidColorBrush x:Key="GroupColor3Brush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="GroupColor4Brush" Color="#BE185D"/>
    <SolidColorBrush x:Key="GroupColor5Brush" Color="#0F766E"/>

</ResourceDictionary>
