<Window x:Class="IcarusStarlink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
        xmlns:views="clr-namespace:IcarusStarlink.App.Views"
        mc:Ignorable="d"
        Title="Icarus Starlink" Height="720" Width="1180" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
            <views:DatabaseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NexusCatalogViewModel}">
            <views:NexusCatalogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavesViewModel}">
            <views:SavesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MergeInstallViewModel}">
            <views:MergeInstallView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeeklyChangesViewModel}">
            <views:WeeklyChangesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorldMapViewModel}">
            <views:WorldMapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerViewModel}">
            <views:ServerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameEditorViewModel}">
            <views:GameEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView/>
        </DataTemplate>

        <!-- The nav rail folded to icons (MainViewModel.IsNavCollapsed): names hide, the icons stay,
             and each item shows its name as a tooltip instead. -->
        <Style x:Key="NavLabelStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavIconStyle" TargetType="Path">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickLinkIconStyle" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The header's quick links: a small icon-and-word button each. -->
        <Style x:Key="HeaderLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="HeaderLinkIconStyle" TargetType="Path">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The left column's pages, grouped under their headings (NavItem.Group). -->
        <CollectionViewSource x:Key="NavGroups" Source="{Binding NavItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- A DockPanel, not a StackPanel: on a narrow window the tagline shortens with "…"
                     and the version (a beta's is long) always shows whole. -->
                <DockPanel VerticalAlignment="Center" LastChildFill="True" Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Left" Text="Icarus Starlink" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding AppVersionDisplay, Mode=OneTime}" FontSize="12" Margin="6,0,0,2"
                               VerticalAlignment="Bottom" ToolTip="Installed version"
                               Foreground="{DynamicResource FaintForegroundBrush}"/>
                    <TextBlock Text="mod manager for Icarus by MkHaters" FontSize="12" Margin="10,0,0,2"
                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </DockPanel>

                <!-- Quick links, always here whatever page is showing (they used to sit at the bottom
                     of the menu; the Theme button took that place). Open UE4SS folder / Open game
                     folder are greyed out (MainViewModel.CanOpenGameFolders) until the game folder is
                     set; Play and Mods work with no setup. Each folder has its own sign. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Play / Starting… / Running (MainViewModel.Play.cs): never asks Steam twice;
                         while the game runs a click brings its window to the front. -->
                    <Button Command="{Binding LaunchGameCommand}" Style="{StaticResource HeaderLinkButtonStyle}"
                            ToolTip="{Binding PlayButtonToolTip}" AutomationProperties.Name="{Binding PlayButtonText}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource SuccessBrush}" Margin="0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource HeaderLinkIconStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGameStarting}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- Running: a green dot with a soft ring. -->
                                <Ellipse Width="15" Height="15" Fill="{DynamicResource SuccessSoftBrush}"
                                         Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}"
                                         Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding PlayButtonText}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGameStarting}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenModFolderCommand}" Style="{StaticResource HeaderLinkButtonStyle}"
                            ToolTip="Open your mod folder: the Library's mods (Extracted_Mods)" AutomationProperties.Name="Open mod folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderMods}" Stroke="#9B6FDE" Style="{StaticResource HeaderLinkIconStyle}"/>
                            <TextBlock Text="Mods" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenUe4ssFolderCommand}" Style="{StaticResource HeaderLinkButtonStyle}"
                            ToolTip="Open the game's UE4SS folder: its Lua mods. Greyed out: set the game folder in Settings first."
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Open UE4SS folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderCode}" Stroke="#4A90D9" Style="{StaticResource HeaderLinkIconStyle}"/>
                            <TextBlock Text="UE4SS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenGameFolderCommand}" Style="{StaticResource HeaderLinkButtonStyle}"
                            ToolTip="Open the Icarus install folder. Greyed out: set the game folder in Settings first."
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Open game folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderGame}" Stroke="#E08A3C" Style="{StaticResource HeaderLinkIconStyle}"/>
                            <TextBlock Text="Game" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenServerFolderCommand}" Style="{StaticResource HeaderLinkButtonStyle}"
                            ToolTip="Open your dedicated server's folder (no server yet: opens the Server page to set one up)"
                            AutomationProperties.Name="Open server folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderServer}" Stroke="#4CAF6D" Style="{StaticResource HeaderLinkIconStyle}"/>
                            <TextBlock Text="Server" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Phase 10: toggles the persistent Activity drawer (see ActivityPanelView) —
                         stays available across every page, unlike a per-page status line. -->
                    <Button Command="{Binding ActivityPanel.ToggleCommand}" Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30" Margin="12,0,0,0" ToolTip="Recent activity"
                            AutomationProperties.Name="Recent activity">
                        <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource SecondaryForegroundBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                        <Setter Property="Width" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                <Setter Property="Width" Value="76"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <!-- Fold the rail to icons / back to names. -->
                <Button Grid.Row="0" Command="{Binding ToggleNavCommand}" Style="{StaticResource IconButtonStyle}" Width="30" Height="28"
                        HorizontalAlignment="Right" Margin="0,8,10,0" ToolTip="{Binding NavToggleToolTip}" AutomationProperties.Name="Fold or unfold the menu">
                    <Path Data="{StaticResource IconSidebar}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                </Button>
                <ListBox Grid.Row="1" ItemsSource="{Binding Source={StaticResource NavGroups}}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,4,0,0">
                    <!-- Group headings ("FIND MODS"); folded to icons, a thin line instead. An empty group
                         (Settings, Help) has neither. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Small caps shrink the text, so 12.5 reads like ~10px capitals: readable, still quieter than the items. -->
                                        <TextBlock x:Name="GroupTitle" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FaintForegroundBrush}" Margin="24,14,0,4"
                                                   Typography.Capitals="AllSmallCaps"/>
                                        <Border x:Name="GroupLine" Height="1" Margin="16,10,16,4" Visibility="Collapsed"
                                                Background="{DynamicResource BorderBrush}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="GroupTitle" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="GroupLine" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter TargetName="GroupTitle" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="GroupLine" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Phase 10: a real icon next to every nav label — see Themes/Icons.xaml.
                                 Only Library and Merge & Install got a full redesign this pilot, but
                                 nav-rail icons are shell-level and cheap to add for every item. -->
                            <StackPanel x:Name="NavItemPanel" Orientation="Horizontal" Background="Transparent">
                                <Path x:Name="NavIcon" Width="16" Height="16" Stretch="Uniform" Style="{StaticResource NavIconStyle}"
                                      Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Style="{StaticResource NavLabelStyle}"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="NavItemPanel" Property="ToolTip" Value="{Binding Title}"/>
                                </DataTrigger>
                                <!-- Each nav item gets its own fixed, distinct brand color, not a
                                     theme-reactive DynamicResource — same precedent as the
                                     Favorite star's own fixed #FFD24C elsewhere in this app: a
                                     deliberately colorful icon set reads better as a set of fixed
                                     "brand" colors than as neutral-foreground-derived tones, and
                                     selection is already shown via the row's own background/accent
                                     bar, not the icon's color. -->
                                <DataTrigger Binding="{Binding Id}" Value="database">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconGlobe}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#E08A3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="downloads">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconDownload}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#D9B44A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="library">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconBook}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#4A90D9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="editor">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconPencil}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#E0705F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="merge">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconMerge}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#9B6FDE"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="weekly-changes">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconClock}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#3EBFB0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="server">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconServerBars}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#4CAF6D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="map">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconMap}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#5FA8FF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="saves">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconPerson}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#D9668B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="settings">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconGear}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#6B92A8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="help">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource NavIconHelp}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#D9B44A"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The Theme button: one click steps to the next theme (Icarus → Dark → Light →
                     Custom → Icarus); the label says which one is on. The quick links that used
                     to sit here are in the header now. -->
                <StackPanel Grid.Row="2" Margin="12,8,12,12">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                    <Button Command="{Binding NextThemeCommand}" Style="{StaticResource QuickLinkButtonStyle}"
                            ToolTip="{Binding ThemeButtonToolTip}"
                            AutomationProperties.Name="{Binding ThemeButtonText}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTheme}" Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentSoftBrush}" Style="{StaticResource QuickLinkIconStyle}"/>
                            <TextBlock Text="{Binding ThemeButtonText}" VerticalAlignment="Center" FontSize="12" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}"/>
            </Border>

            <!-- Phase 10: the persistent Activity drawer — an Auto-width column that collapses to
                 zero width when its content is Collapsed, the standard WPF way to get a
                 show/hide drawer without needing a Storyboard. -->
            <views:ActivityPanelView Grid.Column="2" Width="280" DataContext="{Binding ActivityPanel}"
                                      Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Pop-up messages just under the bell, over whatever page is showing. Its DataContext
             (ToastsViewModel) is set in code-behind. -->
        <views:ToastHostView x:Name="ToastHost" Grid.Row="1" Panel.ZIndex="10" Margin="0,10,16,0"
                             HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>
</Window>
