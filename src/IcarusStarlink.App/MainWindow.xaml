<Window x:Class="IcarusStarlink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:IcarusStarlink.App.ViewModels"
        xmlns:views="clr-namespace:IcarusStarlink.App.Views"
        mc:Ignorable="d"
        Title="Icarus Starlink" Height="720" Width="1180" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NexusCatalogViewModel}">
            <views:NexusCatalogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavesViewModel}">
            <views:SavesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MergeInstallViewModel}">
            <views:MergeInstallView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeeklyChangesViewModel}">
            <views:WeeklyChangesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerViewModel}">
            <views:ServerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Icarus Starlink" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding AppVersionDisplay, Mode=OneTime}" FontSize="12" Margin="6,0,0,0"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource FaintForegroundBrush}"/>
                    <TextBlock Text="mod manager for Icarus" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <ItemsControl ItemsSource="{Binding AvailableThemes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource ThemeButtonStyle}"
                                        Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext.CurrentThemeName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Phase 10: toggles the persistent Activity drawer (see ActivityPanelView) —
                         stays available across every page, unlike a per-page status line. -->
                    <Button Command="{Binding ActivityPanel.ToggleCommand}" Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30" Margin="12,0,0,0" ToolTip="Recent activity"
                            AutomationProperties.Name="Recent activity">
                        <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource SecondaryForegroundBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Phase 10: a real icon next to every nav label — see Themes/Icons.xaml.
                                 Only Library and Merge & Install got a full redesign this pilot, but
                                 nav-rail icons are shell-level and cheap to add for every item. -->
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIcon" Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                                      Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <!-- Each nav item gets its own fixed, distinct brand color, not a
                                     theme-reactive DynamicResource — same precedent as the
                                     Favorite star's own fixed #FFD24C elsewhere in this app: a
                                     deliberately colorful icon set reads better as a set of fixed
                                     "brand" colors than as neutral-foreground-derived tones, and
                                     selection is already shown via the row's own background/accent
                                     bar, not the icon's color. -->
                                <DataTrigger Binding="{Binding Id}" Value="nexus">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconGlobeMeridian}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#E08A3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="library">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconBook}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#4A90D9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="merge">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconMerge}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#9B6FDE"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="weekly-changes">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconClockHands}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#3EBFB0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="server">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconServerBars}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#4CAF6D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="saves">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconPerson}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#D9668B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="settings">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconGearTeeth}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#6B92A8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="help">
                                    <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconHelpMark}"/>
                                    <Setter TargetName="NavIcon" Property="Stroke" Value="#D9B44A"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Shell-level quick-links, always available regardless of which page is showing —
                     matching NavIcon's own icon+label shape but plain buttons, not nav items (they
                     don't change CurrentPage). Open UE4SS folder/Open game folder disable themselves
                     (via MainViewModel.CanOpenGameFolders) until a Content path is actually
                     configured; Launch game and Open mod folder work with zero setup. -->
                <StackPanel Grid.Row="1" Margin="12,8,12,12">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                    <Button Command="{Binding LaunchGameCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            ToolTip="Launches Icarus via Steam, with whatever's currently installed"
                            AutomationProperties.Name="Launch game">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Launch game" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenModFolderCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            ToolTip="Opens this app's own Extracted_Mods folder in Explorer"
                            AutomationProperties.Name="Open mod folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Mod folder" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenUe4ssFolderCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            ToolTip="Opens Binaries\Win64\ue4ss\Mods in Explorer — set the Icarus Content path in Settings first"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Open UE4SS folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="UE4SS folder" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenGameFolderCommand}" HorizontalContentAlignment="Left"
                            ToolTip="Opens the real Icarus install folder in Explorer — set the Icarus Content path in Settings first"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Open game folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource SecondaryForegroundBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Game folder" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>

            <!-- Phase 10: the persistent Activity drawer — an Auto-width column that collapses to
                 zero width when its content is Collapsed, the standard WPF way to get a
                 show/hide drawer without needing a Storyboard. -->
            <views:ActivityPanelView Grid.Column="2" Width="280" DataContext="{Binding ActivityPanel}"
                                      Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
