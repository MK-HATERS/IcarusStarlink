<Project>

  <!-- The repo-root one too (MSBuild loads only the nearest): the reviewed NuGet audit suppressions. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Symbols embedded into each assembly instead of shipped as loose .pdb files — the published
         app is a single-file bundle (see IcarusStarlink.App.csproj), and the six .pdb files were
         the only remaining loose managed artifacts beside it. Embedded symbols keep crash reports
         just as diagnosable (same SourceLink mapping to the public repo) with nothing extra on
         disk. Applies to every src/ project; tests/ has its own Directory.Build.props (which imports
         the repo-root one) and tools/ gets only the repo-root one. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
