<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryItemViewModelTests is the first test file in this project to touch a ViewModel's
         own WPF-typed public properties directly (BitmapImage/Model3D, via LibraryItemViewModel's
         SelectedAssetImage/SelectedAssetMesh/SelectedAssetMaterialParams) rather than only
         WPF-independent types (plain POCOs, CommunityToolkit.Mvvm's own ObservableObject) — declared
         explicitly here rather than relying on IcarusStarlink.App's own UseWPF flowing transitively
         through the ProjectReference below, since that transitive behavior wasn't otherwise already
         proven by an existing test in this project. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real cooked Icarus file PakIO's tests use too (Wax's MIT-licensed sample). -->
    <None Include="..\IcarusStarlink.PakIO.Tests\Fixtures\WaxSample\**" Link="Fixtures\WaxSample\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IcarusStarlink.App\IcarusStarlink.App.csproj" />
  </ItemGroup>

</Project>
