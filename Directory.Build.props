<Project>
  <!--
    SixLabors.ImageSharp 3.1.12 comes only through CUE4Parse-Conversion, which pins exactly [3.1.12].
    Its fix, 3.2.0, refuses to build without a paid Six Labors license key. None of these advisories
    can be reached from Starlink: they are in ImageSharp's TIFF/ICC reading and writing and its
    histogram filter, and Starlink never hands ImageSharp any bytes (textures go
    TextureDecoder.Decode -> ToSkBitmap -> SkiaSharp; ImageSharp is only behind CUE4Parse's TGA,
    flipbook and mesh export, which Starlink doesn't call). Only these six are silenced: any new
    advisory still fails the Audit workflow. Take this out once CUE4Parse moves off 3.1.12.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>
